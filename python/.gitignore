# Built extension module (produced by the threepp_py CMake target)
*.pyd
*.so

# Python caches
__pycache__/
*.py[cod]

# Example/render outputs
render*.png
*_smoke.png

examples/*.png
examples/*.npy
examples/tendon_hand/*.png
examples/tendon_hand/out/
demo_cube.stl
# Generated from rover_spec.json by examples/rover/build_rover_blender.py (headless Blender)
examples/rover/rover.glb
# Generated from mariner_spec.json by examples/usv/build_mariner_blender.py (headless Blender)
examples/usv/mariner.glb
examples/usv/mariner_hydro.json
# Generated from otterx_spec.json by examples/usv/build_otterx_blender.py (headless Blender)
examples/usv/otterx.glb
examples/usv/otterx_hydro.json
# Generated from otter_spec.json by examples/usv/build_otter_blender.py (headless Blender)
examples/usv/otter.glb
examples/usv/otter_hydro.json
# Generated from turbine_spec.json by examples/turbine/build_turbine_blender.py (headless Blender)
examples/turbine/turbine.glb
# Generated from sjark_spec.json / buoys_spec.json by examples/harbour/build_*_blender.py (headless Blender)
examples/harbour/sjark.glb
examples/harbour/sjark_hydro.json
examples/harbour/buoys.glb
examples/harbour/buoys_hydro.json
examples/harbour/out/
examples/harbour/trollfjord.glb
examples/harbour/trollfjord_hydro.json
# Renders, clips and survey data the turbine demo writes (TURBINE_OUT overrides the folder)
examples/turbine/out/
# Default output folders of the soft-body films, the snake net-pen and the rover demos (--out overrides)
examples/out/
examples/netpen/out/
examples/rover/out/

# Legacy artifacts from the experimental RL branch (not part of this package)
*.dll
*.zip
*.log

# RL artifacts (VecNormalize stats, etc.)
*.pkl

*.ilk
*.pdb
