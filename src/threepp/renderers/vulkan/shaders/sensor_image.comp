#version 460

// sensor_image.comp — the camera's final image formation: lens distortion and
// sensor noise, applied to the FINISHED frame.
//
// WHY IT RUNS LAST. A lens bends everything the camera sees and a sensor
// noises everything the lens projects. Anything applied earlier is only
// applied to part of the picture:
//
//   * The overlay pass (particle billboards — chimney smoke and the like —
//     plus Line/LineSegments, wireframe and overlay-tagged meshes) composites
//     onto the swapchain AFTER the TAA resolve and RCAS. Warping in RCAS left
//     that content unwarped while the scene under it moved, so overlays slid
//     off the geometry they belong to, by more and more toward the frame edge.
//   * TAA and the DLSS/FSR upscalers average successive frames, so noise
//     injected before the resolve is quietly filtered back out and the sim
//     reports a noise model it is not actually producing.
//
// Running here also keeps occlusion correct: the overlay still depth-tests
// against the raster G-buffer in UNDISTORTED screen space, which is the space
// that depth buffer is in. Distorting overlay vertices instead would have
// compared them against unrelated depths.
//
// ImGui / the user overlay callback draw after this pass, so UI stays
// undistorted and noise-free — also correct: a HUD is not in front of the lens.
//
// The source is a copy of the finished swapchain image (the caller snapshots
// it), because a gather warp cannot run in place.

#extension GL_GOOGLE_include_directive : enable

#include "lens_distortion.glsl"// CPU twin: cameras/LensDistortion.hpp
#include "sensor_noise.glsl"   // applySensorNoise

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D srcTex;         // snapshot of the finished frame
layout(set = 0, binding = 1) uniform writeonly image2D dstImg; // swapchain (bgra8, no format)

// The fisheye rig (LensRig.hpp): up to four side views, each a pinhole looking
// along one of the camera's axes, for the directions the primary's frame does
// not hold. A face that is not in faceMask is bound to the snapshot and never
// read. Indexed with constants only (see sampleFace).
layout(set = 0, binding = 2) uniform sampler2D faceTex[4];
layout(set = 0, binding = 3) uniform RigUbo {
    uvec4 info;       // x = faceMask
    vec4  margin;     // xy = the primary's margin in uv
    vec4  faceRect[4];// (u0, v0, 1/(u1-u0), 1/(v1-v0)) in the face's tan units
} rig;

#define SENSOR_FLAG_DISTORT 1u
#define SENSOR_FLAG_NOISE   2u
#define SENSOR_FLAG_RIG     4u

// Must match lensrig::kBasis: each face's image x, image y (down) and forward,
// in the camera's image coordinates.
const vec3 kFaceR[4]  = vec3[4](vec3(0, 0, -1), vec3(0, 0, 1), vec3(1, 0, 0), vec3(1, 0, 0));
const vec3 kFaceDn[4] = vec3[4](vec3(0, 1, 0), vec3(0, 1, 0), vec3(0, 0, -1), vec3(0, 0, 1));
const vec3 kFaceF[4]  = vec3[4](vec3(1, 0, 0), vec3(-1, 0, 0), vec3(0, 1, 0), vec3(0, -1, 0));

// Catmull-Rom bicubic in 9 bilinear taps. The fisheye resamples a finished
// picture at a scale near 1 and arbitrary sub-pixel phase, where a bilinear tap
// is a half-pixel box blur at worst: Catmull-Rom keeps the edges a plain render
// of the same camera has. Its negative lobes can overshoot; the caller clamps.
vec3 sampleCatmullRom(sampler2D tex, vec2 uv) {
    const vec2 size = vec2(textureSize(tex, 0));
    const vec2 pos  = uv * size;
    const vec2 t1   = floor(pos - 0.5) + 0.5;
    const vec2 f    = pos - t1;
    const vec2 w0   = f * (-0.5 + f * (1.0 - 0.5 * f));
    const vec2 w1   = 1.0 + f * f * (-2.5 + 1.5 * f);
    const vec2 w2   = f * (0.5 + f * (2.0 - 1.5 * f));
    const vec2 w3   = f * f * (-0.5 + 0.5 * f);
    const vec2 w12  = w1 + w2;
    const vec2 p0   = (t1 - 1.0) / size;
    const vec2 p3   = (t1 + 2.0) / size;
    const vec2 p12  = (t1 + w2 / w12) / size;
    vec3 r = vec3(0.0);
    r += textureLod(tex, vec2(p0.x, p0.y), 0.0).rgb * (w0.x * w0.y);
    r += textureLod(tex, vec2(p12.x, p0.y), 0.0).rgb * (w12.x * w0.y);
    r += textureLod(tex, vec2(p3.x, p0.y), 0.0).rgb * (w3.x * w0.y);
    r += textureLod(tex, vec2(p0.x, p12.y), 0.0).rgb * (w0.x * w12.y);
    r += textureLod(tex, vec2(p12.x, p12.y), 0.0).rgb * (w12.x * w12.y);
    r += textureLod(tex, vec2(p3.x, p12.y), 0.0).rgb * (w3.x * w12.y);
    r += textureLod(tex, vec2(p0.x, p3.y), 0.0).rgb * (w0.x * w3.y);
    r += textureLod(tex, vec2(p12.x, p3.y), 0.0).rgb * (w12.x * w3.y);
    r += textureLod(tex, vec2(p3.x, p3.y), 0.0).rgb * (w3.x * w3.y);
    return r;
}

vec3 sampleFace(int f, vec2 uv) {
    if (f == 0) return sampleCatmullRom(faceTex[0], uv);
    if (f == 1) return sampleCatmullRom(faceTex[1], uv);
    if (f == 2) return sampleCatmullRom(faceTex[2], uv);
    return sampleCatmullRom(faceTex[3], uv);
}

layout(push_constant) uniform Pc {
    uint  width;
    uint  height;
    uint  flags;
    uint  lensModel;

    vec4  normK;     // (fx/W, fy/H, cx/W, cy/H) — resolution independent
    vec4  radial;    // k1..k4
    vec2  tangential;// p1, p2

    // Overscan: the scene was rendered with the frustum widened by this
    // factor, so the ideal image extends past the output frame and barrel
    // distortion can gather real geometry into the corners instead of
    // clamped edge texels. 1.0 = no overscan. The ideal sample position is
    // mapped back into the overscanned source about the principal point.
    // Always 1 for a fisheye (SENSOR_FLAG_RIG), which reads side views.
    float overscan;

    uint  frameSeed;
    float fullWell;
    float readNoise;
    float darkElectrons;
    float prnu;
    float isoGain;
} pc;

void main() {
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.width) || px.y >= int(pc.height)) return;

    const vec2 texel = 1.0 / vec2(float(pc.width), float(pc.height));
    const vec2 uv    = (vec2(px) + 0.5) * texel;

    vec2 srcUv = uv;
    if ((pc.flags & SENSOR_FLAG_RIG) != 0u) {
        // Fisheye: the pixel's ray, then the view that holds it — the
        // primary while the ray lands inside its frame, else the side face
        // whose side of the primary frustum it leaves through. Twin of
        // lensrig::owner.
        const vec2 pd = (uv - pc.normK.zw) / pc.normK.xy;
        const vec3 d  = fisheyeDirection(pc.radial, pd);
        const vec2 fxy = pc.normK.xy, cxy = pc.normK.zw;
        if (d.z > 1e-6) {
            srcUv = d.xy / d.z * fxy + cxy;
        }
        const bool inPrimary = d.z > 1e-6 && all(greaterThanEqual(srcUv, rig.margin.xy)) &&
                               all(lessThanEqual(srcUv, vec2(1.0) - rig.margin.xy));
        vec3 res;
        if (inPrimary) {
            res = sampleCatmullRom(srcTex, srcUv);
        } else {
            const float tanX = d.x > 0.0 ? (1.0 - cxy.x) / fxy.x : cxy.x / fxy.x;
            const float tanY = d.y > 0.0 ? (1.0 - cxy.y) / fxy.y : cxy.y / fxy.y;
            const int   f    = abs(d.x) * tanY >= abs(d.y) * tanX ? (d.x > 0.0 ? 0 : 1) : (d.y > 0.0 ? 2 : 3);
            if ((rig.info.x & (1u << uint(f))) != 0u) {
                const float dz = max(dot(d, kFaceF[f]), 1e-6);
                const vec2  t  = vec2(dot(d, kFaceR[f]), dot(d, kFaceDn[f])) / dz;
                const vec4  r  = rig.faceRect[f];
                res = sampleFace(f, (t - r.xy) * r.zw);
            } else {
                // No face there this frame (its first frame, before its view
                // exists): the primary's nearest edge.
                if (d.z <= 1e-6) srcUv = vec2(d.x > 0.0 ? 1.0 : 0.0, d.y > 0.0 ? 1.0 : 0.0);
                res = textureLod(srcTex, clamp(srcUv, vec2(0.0), vec2(1.0)), 0.0).rgb;
            }
        }
        if ((pc.flags & SENSOR_FLAG_NOISE) != 0u) {
            res = applySensorNoise(res, uvec2(px), pc.frameSeed, pc.fullWell, pc.readNoise,
                                   pc.darkElectrons, pc.prnu, pc.isoGain);
        }
        imageStore(dstImg, px, vec4(clamp(res, 0.0, 1.0), 1.0));
        return;
    }
    if ((pc.flags & SENSOR_FLAG_DISTORT) != 0u) {
        // sensor pixel -> normalized distorted -> normalized ideal -> uv
        const vec2 pd = (uv - pc.normK.zw) / pc.normK.xy;
        const vec2 p  = lensUndistort(int(pc.lensModel), pc.radial, pc.tangential, pd);
        srcUv = p * pc.normK.xy + pc.normK.zw;
        // The source covers `overscan` times the ideal field, centred on the
        // principal point, so an ideal offset shrinks by that factor in it.
        if (pc.overscan != 1.0) {
            srcUv = pc.normK.zw + (srcUv - pc.normK.zw) / pc.overscan;
        }
    }

    vec3 res = textureLod(srcTex, clamp(srcUv, vec2(0.0), vec2(1.0)), 0.0).rgb;

    if ((pc.flags & SENSOR_FLAG_NOISE) != 0u) {
        res = applySensorNoise(res, uvec2(px), pc.frameSeed, pc.fullWell, pc.readNoise,
                               pc.darkElectrons, pc.prnu, pc.isoGain);
    }

    imageStore(dstImg, px, vec4(clamp(res, 0.0, 1.0), 1.0));
}
