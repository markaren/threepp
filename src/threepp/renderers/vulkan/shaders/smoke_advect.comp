#version 460
#extension GL_GOOGLE_include_directive : enable
#include "smoke_common.glsl"

// Pass 1a: semi-Lagrangian advection. Each velocity face is carried back along
// the air's motion at that face into oVel; the four scalars go to aux as the
// PREDICTOR of the MacCormack correction that follows (smoke_advect_fix.comp),
// which is what keeps a plume's edge sharp. All in cell coordinates, the motion
// being the stored velocity plus the wind. The velocity's w (the last step's
// expansion) is done with and starts the step at 0.

void main() {
    const ivec3 c = ivec3(gl_GlobalInvocationID);
    if (!inFaces(c)) return;
    const vec3 step = pc.invCell.w * pc.invCell.xyz;// m/s -> cells per step, per axis

    const vec4 old = texelFetch(uVel, c, 0);
    vec3       v   = vec3(0.0);
    for (int a = 0; a < 3; ++a) {
        if (!faceExists(a, c)) continue;
        float sv;
        if (solidFace(a, c, sv)) {
            v[a] = sv;
            continue;
        }
        vec3 p = vec3(c) + 0.5;
        p[a] -= 0.5;// the face
        // Its own component exactly; the other two from the four faces of theirs around it.
        vec3 u = vec3(sampleFace(0, p), sampleFace(1, p), sampleFace(2, p));
        u[a]   = old[a];
        v[a]   = sampleFace(a, p - (u + pc.wind.xyz) * step);
    }
    imageStore(oVel, c, vec4(v, 0.0));

    if (inGrid(c)) {
        const vec3 p = vec3(c) + 0.5;
        const vec3 d = p - (cellVel(c) + pc.wind.xyz) * step;
        imageStore(aux, c, textureLod(uSca, d / vec3(pc.res.xyz), 0.0));
    }
}
