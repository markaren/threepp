#version 460
#extension GL_EXT_scalar_block_layout : require

// Phillips spectrum h0(k) generator. Dispatched ONCE per cascade at startup
// (or whenever wind/tile parameters change). Output is the frequency-domain
// initial spectrum that DynamicSpectrum evolves over time.
//
// h0(k) is sampled from a complex Gaussian (texelFetch from `Noise`) scaled
// by sqrt(P(k)/2). The packed RGBA32F output stores h0(k) in .rg and the
// conjugate of h0(-k) in .ba so the dynamic-spectrum pass can build the
// time-evolved field without re-fetching from the noise texture.
//
// Band-pass filter (kMin/kMax) lets one cascade cover only a wavenumber
// range so multi-cascade ocean (ripples / chop / swell) stays free of
// double-counted frequencies. kMax == 0 disables the upper bound.
//
// `fetch` (metres of open water upwind; 0 = fully developed) reshapes the
// spectrum into a JONSWAP young sea: Phillips is Pierson-Moskowitz in k
// (its exp(-1/(kL)^2) IS the PM exp(-1.25 (kp/k)^2) with kp = 0.894/L), so
// a limited fetch moves the peak to shorter waves (kp ~ F^-2/3), lifts the
// short-wave tail (alpha ~ F^-0.22) and adds the gamma = 3.3 peak
// enhancement. Net: less swell, more steep chop at the 10-40 m scale --
// the sea a coastal boat actually sails in. fetch = 0 is bit-identical to
// the plain Phillips spectrum.
//
// `spread` picks the directional distribution D(theta) that shares the
// energy of each wavenumber ring out over directions. 0 = the historical
// symmetric cos^2(theta): as much energy against the wind as with it, which
// draws standing, sloshing short crests. 1 = the measured distribution of
// Donelan, Hamilton & Hui (1985) with Banner's (1990) high-frequency form:
// narrow and downwind at the spectral peak, broader for the short waves,
// with a little counter-wind energy there. Both integrate to the same value
// over the circle, so in the continuum the omnidirectional spectrum and the
// significant wave height do not change, only where the energy points. On
// the discrete grids Hs agrees within about 10%, angle-dependent where the
// peak sits near a tile's fundamental (the narrow lobe lands on few modes).
// windTheta is the direction the wind blows toward.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba32f) uniform writeonly image2D H0;
layout(set = 0, binding = 1)          uniform sampler2D Noise;

// Push constants (not a host-mapped UBO): a live wind/fetch change re-
// dispatches this pass, and with two frames in flight a UBO rewritten at
// record time could hand the PREVIOUS frame's dispatch the new sea state.
layout(push_constant) uniform Params {
    uint  textureSize;
    float tileSize;
    float windTheta;
    float windSpeed;
    float smallWaveLengthCutoff;
    float kMin;
    float kMax;
    float fetch;
    // 1 = the Hs-calibrated spectrum (DisplacedMesh::Params::hsFix /
    // THREEPP_OCEAN_HS_FIX): Pierson-Moskowitz's own constants instead of
    // the eye-calibrated A = 0.01 and the Phillips peak exponent. 0 runs
    // exactly the arithmetic of the plain spectrum below.
    uint  hsFix;
    uint  spread;// 0 = symmetric cos^2 (historical), 1 = Donelan-Banner sech^2
    // Optional swell system, added on top of the wind sea (cascade 0 only;
    // swellScale = 0 elsewhere and when there is no swell). swellScale is
    // computed on the host (PhillipsSpectrum::swellScale) so that the swell's
    // discrete sum over this grid gives exactly the requested Hs.
    float swellScale;
    float swellPeriod; // Tp, s
    float swellTheta;  // direction the swell runs toward, rad, sample domain
    float swellSpread; // s of cos^(2s)(theta/2), >= 1 (the host clamps it)
    // 1 = the measured short-wave spectrum (DisplacedMesh::Params::
    // shortWaveSpectrum / THREEPP_OCEAN_SHORT_WAVE_SPECTRUM, see
    // elfouhailyShortCurvature). 0 adds nothing.
    uint  shortWave;
} P;

const float PI = 3.14159265358979;

// Directional spreading of Donelan, Hamilton & Hui (1985), "Directional
// spectra of wind-generated waves", Phil. Trans. R. Soc. A 315:
//   D(theta) = beta/2 sech^2(beta theta), theta from the downwind direction,
//   beta = 2.61 (w/wp)^1.3   for 0.56 < w/wp < 0.95
//          2.28 (w/wp)^-1.3  for 0.95 <= w/wp < 1.6
//          1.24              below 0.56,
// and above w/wp = 1.6 the form fitted by Banner (1990), "Equilibrium
// spectra of wind waves", J. Phys. Oceanogr. 20:
//   beta = 10^(-0.4 + 0.8393 exp(-0.567 ln((w/wp)^2))).
// (Both as collected in Horvath (2015), "Empirical directional wave spectra
// for computer graphics", DigiPro.) The branches meet within 1% at 0.56,
// 0.95 and 1.6. On (-pi, pi] the sech^2 integrates to tanh(beta pi), so
// dividing by it makes D integrate to exactly 1; the factor pi is the
// integral of the historical cos^2 over the circle, so the returned weight
// keeps the omnidirectional spectrum (and Hs) of the cos^2 path.
float donelanBannerWeight(float cosTheta, float wOverWp) {
    float beta;
    if (wOverWp < 0.56) {
        beta = 1.24;
    } else if (wOverWp < 0.95) {
        beta = 2.61 * pow(wOverWp, 1.3);
    } else if (wOverWp < 1.6) {
        beta = 2.28 * pow(wOverWp, -1.3);
    } else {
        beta = pow(10.0, -0.4 + 0.8393 * exp(-0.567 * log(wOverWp * wOverWp)));
    }
    const float theta = acos(clamp(cosTheta, -1.0, 1.0));
    const float ch = cosh(beta * theta);
    return PI * 0.5 * beta / (ch * ch * tanh(beta * PI));
}

// Shape of the swell's 2D wavenumber spectrum, up to a constant (the host
// scales it to the requested Hs). Mirrored in OceanFFT.cpp (swellShapeCpu);
// keep the two identical.
// Frequency spectrum: the JONSWAP form of Hasselmann et al. (1973),
// Dtsch. Hydrogr. Z. A8(12), written with the peak at fp = 1 / Tp:
//   S(f) ~ f^-5 exp(-1.25 (Tp f)^-4) gamma^exp(-(Tp f - 1)^2 / (2 sigma^2)),
//   sigma = 0.07 below the peak, 0.09 above; gamma = 6, a narrow swell peak
//   (the 3.3 of a growing wind sea sharpens as the swell travels).
// Direction: Mitsuyasu et al. (1975) cos^(2s)(theta/2), theta measured from
// the swell's direction of travel; Goda (2000) gives s ~ 25 for swell from a
// nearby storm, ~ 75 for swell that has travelled far.
// To the wavenumber plane: F(kx, kz) = S(f) (df/dk) D(theta) / k with deep-
// water f = sqrt(g k) / 2 pi, so df/dk ~ 1 / w.
float swellShape(vec2 k) {
    const float g  = 9.81;
    const float kl = length(k);
    const float w  = sqrt(g * kl);
    const float x  = P.swellPeriod * w / (2.0 * PI);// f / fp
    const float sg = (x <= 1.0) ? 0.07 : 0.09;
    const float d  = (x - 1.0) / sg;
    const float gammaPeak = pow(6.0, exp(-0.5 * d * d));
    const float x2 = x * x;
    const float sf = exp(-1.25 / (x2 * x2)) * gammaPeak / (x2 * x2 * x);
    // Runs toward -k, as the wind sea (see phillips2D).
    const vec2  dir = vec2(cos(P.swellTheta), sin(P.swellTheta));
    const float c   = clamp(-dot(k, dir) / kl, -1.0, 1.0);
    // cos(theta / 2), kept off 0: straight against the swell it is exactly 0
    // on axis-aligned headings, and pow(0, y) is undefined in GLSL (one NaN
    // texel would spread through the IFFT over the whole cascade).
    const float halfCos = max(sqrt(0.5 * (1.0 + c)), 1e-6);
    return sf * pow(halfCos, 2.0 * P.swellSpread) / (w * kl);
}

// The short-wave curvature spectrum of Elfouhaily, Chapron, Katsaros and
// Vandemark (1997), "A unified directional spectrum for long and short
// wind-driven waves", J. Geophys. Res. 102(C7), 15781-15796, eq. 40-44:
//   B_h(k) = (alpha_m / 2) (c_m / c) F_m,
//   F_m    = L_PM exp(-(k / k_m - 1)^2 / 4),  L_PM = exp(-5/4 (k_p / k)^2),
//   c(k)   = sqrt(g / k (1 + (k / k_m)^2)),  k_m = 370 rad/m, c_m = 0.23 m/s,
//   alpha_m = 0.01 (1 + ln(u* / c_m))    for u* <= c_m,
//             0.01 (1 + 3 ln(u* / c_m))  for u* >  c_m,
// B the curvature spectrum k^3 S(k) of the omnidirectional S. (Their F_m also
// carries the peak enhancement J_p, 1 this far above the peak: left out.)
// The friction velocity is the neutral log profile, u* = 0.4 U10 / ln(10 / z0),
// with the wave-age dependent roughness length the paper takes from Donelan,
// Dobson, Smith and Anderson (1993), z0 = 3.7e-5 (U10^2 / g) (U10 / c_p)^0.9.
// alpha_m is held at 0 or above (it would turn negative below about 3 m/s).
// Mirrored on the CPU in OceanFFT.cpp (elfouhailyShortCurvatureCpu).
float elfouhailyShortCurvature(float k, float kp) {
    const float g  = 9.81;
    const float km = 370.0;
    const float cm = 0.23;
    const float U  = P.windSpeed;
    const float omegaC = U * sqrt(kp / g);// inverse wave age U10 / c_p
    const float z0 = 3.7e-5 * U * U / g * pow(omegaC, 0.9);
    const float us = 0.4 * U / log(10.0 / z0);
    const float lr = log(us / cm);
    const float am = max(0.01 * (1.0 + (us <= cm ? lr : 3.0 * lr)), 0.0);
    const float kr = k / km;
    const float c  = sqrt(g / k * (1.0 + kr * kr));
    const float pr = kp / k;
    return 0.5 * am * (cm / c) * exp(-1.25 * pr * pr) * exp(-0.25 * (kr - 1.0) * (kr - 1.0));
}

float phillips2D(vec2 k) {
    if (length(k) < 1e-4) return 0.0;
    // Tessendorf "Phillips constant". Empirically calibrated; the literature
    // values range 1e-4 to 1e-2 depending on how the rest of the chain
    // (IFFT normalisation, displace `1/L` divisor) absorbs constants. With
    // un-normalised radix-2 butterflies + `* invTile` in water_displace.comp,
    // 1e-2 produces physically-scaled wave heights (Beaufort 4–5 wind →
    // ~1–2 m waves). A = 1.0 was 100× too energetic in spectrum, ~10× too
    // tall in amplitude — visible as gale-force waves at moderate wind.
    const float A = 0.01;
    const vec2  windDir = vec2(cos(P.windTheta), sin(P.windTheta));
    const float g = 9.81;
    float L     = P.windSpeed * P.windSpeed / g;
    // Hs fix, peak: Pierson-Moskowitz writes the peak cut-off as
    // exp(-beta (g / (U w))^4) = exp(-beta / (kL)^2) with beta = 0.74
    // (Pierson and Moskowitz 1964); Phillips' exp(-1 / (kL)^2) is beta = 1,
    // a peak 1.078x too high in frequency and 0.74x the variance. L / sqrt(beta)
    // turns one into the other, and the JONSWAP branch below then puts the
    // peak exactly on Hasselmann's omega_p = 22 (g^2 / (U F))^(1/3).
    if (P.hsFix != 0u) L *= 1.1624764;// 1 / sqrt(0.74)
    float Aeff  = A;
    float gamma = 1.0;
    if (P.fetch > 0.0) {
        // JONSWAP fetch scaling (Hasselmann et al. 1973), normalised so the
        // fully developed fetch Ffd -- where the JONSWAP peak lands on the
        // PM peak 0.877 g/U -- reproduces the plain Phillips numbers:
        //   omega_p = 22 (g^2 / (U F))^(1/3)   =>  kp ~ F^(-2/3), Ffd = 22^3 U^2 / (0.877^3 g)
        //   alpha   = 0.076 (U^2 / (g F))^0.22  =>  tail energy ~ F^(-0.22)
        // Clamped at gF/U^2 ~ 80 (the formulas' short-fetch limit); below
        // that only the clamp moves.
        const float Ffd = 1609.0 * P.windSpeed * P.windSpeed;
        const float r   = clamp(P.fetch / Ffd, 0.005, 1.0);
        L    *= pow(r, 2.0 / 3.0);
        Aeff *= pow(r, -0.22);
        // Peak enhancement: 3.3 is the JONSWAP mean for every fetch-limited
        // sea; fade it out toward full development so sliding fetch up to
        // Ffd lands on PM without a step.
        gamma = 1.0 + 2.3 * sqrt(1.0 - r);
    }
    const float k2 = dot(k, k);
    const float kL2 = k2 * L * L;
    const float k4 = k2 * k2;
    float kw = dot(normalize(k), windDir);
    if (P.spread != 0u) {
        // The amplitude stored at k runs toward -k: dynamic_spectrum.comp
        // evolves it as h0(k) e^{+i w t} and the IFFT sums it as e^{+i k.x},
        // so its phase k.x + w t is constant along x moving opposite k. The
        // downwind angle is therefore measured from -k, so the energy ends
        // up in waves that run WITH the wind.
        // Peak frequency: the same PM / JONSWAP peak kp = 0.894 / L as the
        // gamma branch below (L already carries the fetch scaling).
        const float w  = sqrt(g * sqrt(k2));
        const float wp = sqrt(g * 0.894 / L);
        kw = donelanBannerWeight(-kw, w / wp);
    } else {
        kw *= kw;
    }
    const float l = P.smallWaveLengthCutoff;
    float p = Aeff * exp(-1.0 / kL2) * kw * exp(-k2 * l * l) / k4;
    if (gamma > 1.0) {
        // gamma^exp(-(w - wp)^2 / (2 sigma^2 wp^2)) in deep-water frequency
        // w = sqrt(g k); sigma = 0.07 below the peak, 0.09 above.
        const float w  = sqrt(g * sqrt(k2));
        const float wp = sqrt(g * 0.894 / L);
        const float sg = (w <= wp) ? 0.07 : 0.09;
        const float d  = (w - wp) / (sg * wp);
        p *= pow(gamma, exp(-0.5 * d * d));
    }
    // Hs fix, level: the chain below (h0 = xi sqrt(P/2), h0(k) + conj h0(-k),
    // un-normalised IFFT, the 1/tile in water_displace.comp) turns P into the
    // 2D wavenumber spectrum F(k) = P / (2 pi^2), whose omnidirectional form
    // is A exp(-1/(kL)^2) / (2 pi k^3). Pierson-Moskowitz in k is
    // (alpha / 2) k^-3 exp(-beta / (kL)^2) with alpha = 8.1e-3, so the
    // physical constant is A = pi alpha = 0.02545: 2.545x the 0.01 above.
    // With the peak fix, var(eta) = alpha L^2 / (4 beta), Hs = 0.21 U^2 / g.
    if (P.hsFix != 0u) p *= 2.5446900;// pi * 8.1e-3 / 0.01
    if (P.shortWave != 0u) {
        // The measured short waves, on top of the long-wave spectrum above
        // (the paper's B = B_l + B_h). In the chain's units a curvature B
        // with the directional weight kw (which integrates to pi over the
        // circle) is P = 2 pi B kw / k^4: the Pierson-Moskowitz tail above is
        // B = alpha / 2 this way. Faded in over three octaves from twice the
        // spectral peak, where B_h is a few percent of B_l, so the long waves
        // and Hs keep their spectrum; the same short-wave taper as the band.
        const float kp = 0.894 / L;// the spectrum's own peak (fetch included)
        const float kn = sqrt(k2);
        const float fade = smoothstep(log(2.0 * kp), log(16.0 * kp), log(kn));
        p += 2.0 * PI * elfouhailyShortCurvature(kn, kp) * fade * kw * exp(-k2 * l * l) / k4;
    }
    if (P.swellScale > 0.0) {
        // The swell carries the same short-wave taper as the band it is in.
        p += P.swellScale * swellShape(k) * exp(-k2 * l * l);
    }
    return p;
}

void main() {
    const ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (id.x >= int(P.textureSize) || id.y >= int(P.textureSize)) return;

    const float deltaK = 2.0 * PI / P.tileSize;
    const float nx = float(id.x) - float(P.textureSize) * 0.5;
    const float nz = float(id.y) - float(P.textureSize) * 0.5;
    const vec2  k  = vec2(nx, nz) * deltaK;
    const float kL = length(k);

    if (kL < P.kMin || (P.kMax > 0.0 && kL > P.kMax)) {
        imageStore(H0, id, vec4(0.0));
        return;
    }
    const vec2 nk_pos = texelFetch(Noise, id, 0).xy;
    const vec2 h0_pos = nk_pos * sqrt(phillips2D(k) * 0.5);

    // Wrap-around fetch for h0(-k); ((N - id) mod N) places (0,0) onto itself
    // so the DC term remains symmetric, matching the WGSL reference.
    const ivec2 idNeg = ivec2((int(P.textureSize) - id.x) & (int(P.textureSize) - 1),
                              (int(P.textureSize) - id.y) & (int(P.textureSize) - 1));
    const vec2 nk_neg = texelFetch(Noise, idNeg, 0).xy;
    const vec2 h0_neg = nk_neg * sqrt(phillips2D(-k) * 0.5);
    const vec2 h0_neg_conj = vec2(h0_neg.x, -h0_neg.y);

    imageStore(H0, id, vec4(h0_pos, h0_neg_conj));
}
