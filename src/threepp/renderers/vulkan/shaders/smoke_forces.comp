#version 460
#extension GL_GOOGLE_include_directive : enable
#include "smoke_common.glsl"

// Pass 2 of a smoke step: buoyancy, the sources, the colliders, damping.
// Pointwise, so it reads (A) and writes (B) and the host flips both parities.
// One invocation per velocity texel: its cell's scalars (when it is a cell) and
// the three faces at the cell's min sides.

// The scalars of the two cells a face separates, as the face sees them: their mean, or the one inside the box.
vec2 faceScalars(int axis, ivec3 c) {
    const ivec3 b = c - unitAxis(axis);
    vec2        s = vec2(0.0);
    float       k = 0.0;
    if (inGrid(b)) {
        s += texelFetch(uSca, b, 0).xy;
        k += 1.0;
    }
    if (inGrid(c)) {
        s += texelFetch(uSca, c, 0).xy;
        k += 1.0;
    }
    return k > 0.0 ? s / k : vec2(0.0);
}

// How much of source i reaches world point w (0 outside its ball).
float sourceWeight(int i, vec3 w) {
    const float r = max(src[i].posRadius.w, 1e-4);
    const float d = length(w - src[i].posRadius.xyz) / r;
    return d >= 1.0 ? 0.0 : 1.0 - smoothstep(0.0, 1.0, d);
}

void main() {
    const ivec3 c = ivec3(gl_GlobalInvocationID);
    if (!inFaces(c)) return;
    const float dt = pc.invCell.w;
    const int   ns = int(head.x);

    // ── the scalars, at the cell centre ─────────────────────────────────────
    if (inGrid(c)) {
        const vec3 w = worldOfCell(c);
        vec2       s = texelFetch(uSca, c, 0).xy;// density, temperature
        for (int i = 0; i < ns; ++i) {
            const float k = sourceWeight(i, w);
            if (k <= 0.0) continue;
            const float r = max(src[i].posRadius.w, 1e-4);
            // Ragged emission: the puffs are not a smooth ball.
            const float n = mix(1.0, 0.35 + 1.3 * vnoise(w * (3.0 / r) + vec3(0.0, -head.z * 1.7, 0.0)), src[i].vel.w);
            s.x += src[i].rates.x * k * n * dt;
            s.y += src[i].rates.y * k * n * dt;
        }
        vec3 sv;
        if (solidCell(c, sv)) {
            // What a solid cell holds is what the advection reads when a backtrace ends just inside it, so a wall's
            // surface takes the mean of the open cells beside it: the smoke beside a wall reads its own side, and the
            // wall neither drains it (an empty wall did) nor stores it to hand to the far side (a wall that kept what
            // the advection put in it did). A cell with no open neighbour, deep in a wall or a moving body, only thins
            // the smoke it sits in: a body that deleted all it swept cut a thin dark tunnel along its path.
            vec2  sum = vec2(0.0);
            float k   = 0.0;
            for (int a = 0; a < 6; ++a) {
                const ivec3 q = c + ivec3(a == 0 ? 1 : (a == 1 ? -1 : 0), a == 2 ? 1 : (a == 3 ? -1 : 0), a == 4 ? 1 : (a == 5 ? -1 : 0));
                vec3        qv;
                if (!inGrid(q) || solidCell(q, qv)) continue;
                sum += texelFetch(uSca, q, 0).xy;
                k += 1.0;
            }
            if (k > 0.0) s = sum / k;
            else s.x *= exp(-10.0 * dt);
        }
        imageStore(oSca, c, vec4(s, 0.0, 0.0));
    }

    // ── the velocity, on the faces ──────────────────────────────────────────
    const vec4 old = texelFetch(uVel, c, 0);
    vec3       v   = vec3(0.0);
    for (int a = 0; a < 3; ++a) {
        if (!faceExists(a, c)) continue;
        // A collider carries the air with it.
        float sv;
        if (solidFace(a, c, sv)) {
            v[a] = sv;
            continue;
        }
        float u = old[a];
        // Hot, light smoke rises; heavy (cooled, sooty) smoke sinks a little.
        if (a == 1) {
            const vec2 s = faceScalars(1, c);
            u += dt * (pc.phys0.x * s.y - pc.phys0.y * s.x);
        }
        const vec3 w = worldOfFace(a, c);
        // The wind's eddies: the air is drawn toward them at their own turnover rate (speed / size).
        if (pc.turb.x > 0.0) u = mix(u, gustAxis(a, w), 1.0 - exp(-dt * pc.turb.x / pc.turb.y));
        // Sources pull the air toward their own velocity.
        for (int i = 0; i < ns; ++i) {
            const float k = sourceWeight(i, w);
            if (k <= 0.0) continue;
            u = mix(u + pc.wind[a], src[i].vel[a], clamp(k * src[i].rates.z * dt, 0.0, 1.0)) - pc.wind[a];
        }
        // Drag pulls the air toward the wind; the speed cap holds each component.
        u *= 1.0 / (1.0 + pc.phys1.z * dt);
        v[a] = clamp(u + pc.wind[a], -pc.wind.w, pc.wind.w) - pc.wind[a];
    }
    imageStore(oVel, c, vec4(v, 0.0));
}
