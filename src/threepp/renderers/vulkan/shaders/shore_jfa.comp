#version 460
#extension GL_GOOGLE_include_directive                   : enable
#extension GL_EXT_scalar_block_layout                    : require
#extension GL_EXT_buffer_reference                       : require
#extension GL_EXT_buffer_reference2                      : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "ocean_shore_depth.glsl"// OceanShoreDepth: mode 2 lays a window's depth

// THE SHORE'S DISTANCE: jump flooding (Rong and Tan 2006, "Jump flooding in
// GPU with applications to Voronoi diagram and distance transform") over one
// window of shore_capture.comp's seeds, so every texel learns its nearest
// solid texel; then the shore map's distance and direction from that.
//
//   mode 0  one round at step k: each texel keeps the nearest of its own seed
//           and the seeds of the eight texels k away. Rounds of k = 32, 16,
//           ..., 1 and a last at 1 (JFA+1, which mends most of the plain
//           flood's few wrong answers) reach a seed up to about 64 texels off,
//           16 m in the near window: further than any collar.
//   mode 1  the map: .r the distance (m) to the nearest seed's centre, .gb the
//           unit direction toward it ((0, 0) on a seed), .a the bed the
//           capture left (kept).
//   mode 2  the window's DEPTH (ocean_shore_depth.glsl), from the bed the
//           capture left: over water the depth under the rest level, a tent
//           kDepthReach either way over the texels that are water (a wave
//           feels the bed over a good part of its length, not under one
//           point, and a bed sounded at a texel's centre alone is noisy at a
//           pile's or a boulder's edge; at a waterline it leans to the water
//           before it, so the last decimetres keep a little sea and the
//           waterline moves); inside a solid the deepest water among its
//           neighbours, so a pile or a footing standing in deep water does
//           not calm the sea round it, and a beach's waterline is as shallow
//           as the water before it. 0 where no water is near (inland). The
//           first thread also writes the window's placement beside it.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, r32ui)   uniform readonly  uimage2DArray seedsIn;
layout(set = 0, binding = 1, r32ui)   uniform writeonly uimage2DArray seedsOut;
layout(set = 0, binding = 2, rgba16f) uniform image2DArray shoreMap;

// 40 bytes, mirrored by WakeFieldPipeline::ShoreJfaPush.
layout(push_constant, scalar) uniform Pc {
    uint     res;
    uint     layer;
    uint     mode;     // 0 a round, 1 the map, 2 the depth
    int      step;     // texels (mode 0)
    float    texel;    // m (modes 1, 2)
    float    originX;  // the window's world min corner (mode 2)
    float    originZ;
    uint     _pad;
    uint64_t depthAddr;// OceanShoreDepth (mode 2)
} pc;

const uint  kNoSeed = 0xffffffffu;
const float kFar    = 1.0e4;// m: no seed within reach
const float kDepthReach = 1.5;// m: the depth's tent reaches this far either way (mode 2)

ivec2 unpackSeed(uint s) { return ivec2(int(s & 0xffffu), int(s >> 16)); }

void main() {
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    const int   res = int(pc.res);
    if (px.x >= res || px.y >= res) return;
    const int li = int(pc.layer);

    if (pc.mode == 0u) {
        uint  best  = imageLoad(seedsIn, ivec3(px, li)).r;
        float bestD = kFar * kFar;
        if (best != kNoSeed) {
            const vec2 d = vec2(unpackSeed(best) - px);
            bestD = dot(d, d);
        }
        for (int j = -1; j <= 1; ++j) {
            for (int i = -1; i <= 1; ++i) {
                if (i == 0 && j == 0) continue;
                const ivec2 q = px + ivec2(i, j) * pc.step;
                if (q.x < 0 || q.y < 0 || q.x >= res || q.y >= res) continue;
                const uint s = imageLoad(seedsIn, ivec3(q, li)).r;
                if (s == kNoSeed) continue;
                const vec2  d  = vec2(unpackSeed(s) - px);
                const float dd = dot(d, d);
                if (dd < bestD) {
                    bestD = dd;
                    best  = s;
                }
            }
        }
        imageStore(seedsOut, ivec3(px, li), uvec4(best));
        return;
    }

    if (pc.mode == 2u) {
        // (only the bed, .a, is read here, and nothing writes it)
        const float bed = imageLoad(shoreMap, ivec3(px, li)).a;
        float d = 0.0;
        if (bed <= 0.0) {
            // A tent of kDepthReach a side over the water's texels: two taps
            // either way (at a quarter metre, three texels apart), one at two.
            const int n    = clamp(int(round(0.5 * kDepthReach / pc.texel)), 1, 2);
            const int step = max(int(round(kDepthReach / (float(n) * pc.texel))), 1);
            float sw = 0.0, sd = 0.0;
            for (int j = -n; j <= n; ++j) {
                for (int i = -n; i <= n; ++i) {
                    const ivec2 q = clamp(px + ivec2(i, j) * step, ivec2(0), ivec2(res - 1));
                    const float b = imageLoad(shoreMap, ivec3(q, li)).a;
                    if (b > 0.0) continue;
                    const float w = float((n + 1 - abs(i)) * (n + 1 - abs(j)));
                    sw += w;
                    sd += w * -b;
                }
            }
            d = sd / sw;
        } else {
            for (int j = -1; j <= 1; ++j) {
                for (int i = -1; i <= 1; ++i) {
                    const ivec2 q = clamp(px + ivec2(i, j), ivec2(0), ivec2(res - 1));
                    const float b = imageLoad(shoreMap, ivec3(q, li)).a;
                    if (b <= 0.0) d = max(d, -b);
                }
            }
        }
        OceanShoreDepth sd = OceanShoreDepth(pc.depthAddr);
        sd.depth[(pc.layer * pc.res + uint(px.y)) * pc.res + uint(px.x)] = d;
        if (px == ivec2(0)) {
            sd.win[pc.layer] = OceanShoreWindow(pc.originX, pc.originZ, pc.texel, 1.0);
            sd.res           = pc.res;
        }
        return;
    }

    const uint s   = imageLoad(seedsIn, ivec3(px, li)).r;
    const vec4 map = imageLoad(shoreMap, ivec3(px, li));
    float dist = kFar;
    vec2  dir  = vec2(0.0);
    if (s != kNoSeed) {
        const vec2  d = vec2(unpackSeed(s) - px);
        const float l = length(d);
        dist = l * pc.texel;
        if (l > 0.0) dir = d / l;
    }
    imageStore(shoreMap, ivec3(px, li), vec4(dist, dir, map.a));
}
