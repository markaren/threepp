#version 460
#extension GL_GOOGLE_include_directive : enable
#include "smoke_common.glsl"

// Pass 7: subtract the pressure gradient, leaving the velocity divergence-free.
// A solid cell keeps its collider's velocity.

void main() {
    const ivec3 c = ivec3(gl_GlobalInvocationID);
    if (!inGrid(c)) return;
    vec3 sv;
    if (solidCell(c, sv)) {
        imageStore(oVel, c, vec4(sv, 0.0));
        return;
    }
    const vec3  h   = 0.5 * pc.invCell.xyz;
    const float pc0 = texelFetch(uP, c, 0).x;
    const vec3  g   = vec3((pressureAt(c + ivec3(1, 0, 0), pc0) - pressureAt(c - ivec3(1, 0, 0), pc0)) * h.x,
                           (pressureAt(c + ivec3(0, 1, 0), pc0) - pressureAt(c - ivec3(0, 1, 0), pc0)) * h.y,
                           (pressureAt(c + ivec3(0, 0, 1), pc0) - pressureAt(c - ivec3(0, 0, 1), pc0)) * h.z);
    vec3 v = texelFetch(uVel, c, 0).xyz - g;
    // A solid floor takes no downward flow.
    if (pc.box.w > 0.5 && c.y == 0) v.y = max(v.y, 0.0);
    imageStore(oVel, c, vec4(v, 0.0));
}
