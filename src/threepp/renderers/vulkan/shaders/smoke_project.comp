#version 460
#extension GL_GOOGLE_include_directive : enable
#include "smoke_common.glsl"

// Pass 7: subtract the pressure gradient across each face, leaving the velocity
// divergence-free: the difference of the two cells a face separates is exactly
// the gradient smoke_jacobi.comp's Laplacian is the divergence of. Beyond an open
// side of the box the pressure is 0 (the smoke leaves); a solid's face keeps the
// solid's velocity. A burning cell is left with the divergence of its expansion
// (smoke_diverge.comp), which the texel's w still holds after this pass, so the
// state a step leaves says what it was asked to.

float cellPressure(ivec3 c) { return inGrid(c) ? texelFetch(uP, c, 0).x : 0.0; }

void main() {
    const ivec3 c = ivec3(gl_GlobalInvocationID);
    if (!inFaces(c)) return;
    const vec4 old = texelFetch(uVel, c, 0);
    vec3       v   = vec3(0.0);
    const float p0 = cellPressure(c);
    for (int a = 0; a < 3; ++a) {
        if (!faceExists(a, c)) continue;
        float sv;
        if (solidFace(a, c, sv)) {
            v[a] = sv;
            continue;
        }
        v[a] = old[a] - (p0 - cellPressure(c - unitAxis(a))) * pc.invCell[a];
    }
    imageStore(oVel, c, vec4(v, old.w));
}
