#version 460

// r32ui fixed-point → r16f, once per field per frame, straight after the
// scatter. The march in deferred_shade (applyParticleFog) samples the FLOAT
// volume with HARDWARE trilinear — 1 fetch per step instead of the 8
// texelFetches the integer format forces on the froxel passes — and that is
// the only reason this image exists. 64³ r16f is 512 KB; the dispatch is
// noise inside TP_ParticleDensity.
//
// KEEP IN SYNC: kInvScale is 1 / kParticleDensityScale
// (shaders/particle_density.glsl, ParticleFieldPass.hpp kDensityFixedScale).

// ── THE MAJORANT, AND WHY IT IS COMPUTED HERE ────────────────────────────────
// Delta tracking through a heterogeneous medium (the LIDAR path, parent plan
// phase 3) needs a sigma_maj that is >= sigma_t everywhere along the ray, and
// a bound that is too loose costs a rejection step per mean free path while a
// bound that is too low is simply wrong. The volume knows its own answer, and
// this pass is already reading every voxel of it — so one shared-memory
// reduction plus one atomicMax per workgroup (4096 atomics for a 64^3 volume,
// not 262 144) hands the sensor an EXACT per-volume maximum for free.
//
// Exact matters twice over: it is an INTEGER max over the same r32ui image the
// sensor samples, so (a) integer max is associative and the result is
// reproducible run to run exactly as the accumulator is, and (b) a trilinear
// tap is a convex combination of texels and can never exceed it, so the bound
// needs no slack factor and nothing anywhere is hardcoded.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0, r32ui) uniform readonly uimage3D srcFixed;
layout(set = 0, binding = 1, r16f)  uniform writeonly image3D dstLin;
// One Q20.12 entry per BOUND VOLUME, indexed by the volume's slot in
// ParticleDensityUbo — the host zeroes the whole buffer before the converts
// run and pushes each field's slot below.
layout(set = 0, binding = 2, std430) buffer MajorantBuf {
    uint majorant[];
};

layout(push_constant) uniform Pc {
    uint volIndex;
} pc;

// ── A 3^3 BINOMIAL PREFILTER, AND WHY THE MARCH NEEDS ONE ────────────────────
// The scatter deposits a finite number of parcels into a finite grid, so every
// voxel carries Poisson noise of order 1/sqrt(parcels per voxel) -- and the
// grid is exactly where a plume's detail lives, so raising the resolution to
// buy detail LOWERS the occupancy that keeps it smooth. Sampled raw, a plume
// reads as grain through its thin regions and as voxel stair-steps along its
// boundary however finely the march is stepped: the two artefacts trade
// against each other with resolution and neither resolution removes both.
// One binomial tap per axis kills the noise that lives AT the grid scale and
// leaves everything coarser than a voxel untouched -- the same argument, and
// the same kernel, as the marching-cubes surfacing in the python examples.
//
// The MAJORANT below stays a valid bound: a binomial tap is a convex
// combination of the texels it reads, so the filtered field can never exceed
// their maximum, and the raw integer max still bounds it.

const float kInvScale = 1.0 / 4096.0;
const float kW[3] = float[3](0.25, 0.5, 0.25);

shared uint sMax;

void main() {
    if (gl_LocalInvocationIndex == 0u) sMax = 0u;
    barrier();

    // NOT an early return: every invocation must reach both barriers, so the
    // bounds test gates the work rather than the control flow.
    const ivec3 c  = ivec3(gl_GlobalInvocationID);
    const ivec3 sz = imageSize(dstLin);
    uint v = 0u;
    if (all(lessThan(c, sz))) {
        v = imageLoad(srcFixed, c).x;
        float acc = 0.0;
        for (int dz = -1; dz <= 1; ++dz)
        for (int dy = -1; dy <= 1; ++dy)
        for (int dx = -1; dx <= 1; ++dx) {
            const ivec3 q = c + ivec3(dx, dy, dz);
            // Outside the volume is VACUUM, not the edge voxel repeated:
            // clamping would smear the boundary outward and redraw the box.
            // Letting the weights fall short at the faces IS the falloff.
            if (any(lessThan(q, ivec3(0))) || any(greaterThanEqual(q, sz))) continue;
            acc += kW[dx + 1] * kW[dy + 1] * kW[dz + 1]
                 * float(imageLoad(srcFixed, q).x);
        }
        imageStore(dstLin, c, vec4(acc * kInvScale));
    }
    atomicMax(sMax, v);

    barrier();
    if (gl_LocalInvocationIndex == 0u) atomicMax(majorant[pc.volIndex], sMax);
}
