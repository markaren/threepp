#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : enable

#include "vulkan_shared.h"// ShadePush

// Far-field volumetric cloud march — HALF-RESOLUTION, temporally reprojected.
//
// One thread per HALF-res pixel raymarches the [clouds.bottomY, clouds.topY]
// shell (Nubis/HZD-lite: dual-lobe HG phase, Beer light-march toward the sun,
// powder term, env ambient graded by height) and writes vec4(in-scatter.rgb,
// transmittance) at half res. The full-res deferred_shade then composites the
// result with ONE bilinear upsample tap — this moves the ~48-step march (plus
// its 5-tap sun light-march) off the per-pixel critical path, the ~4× win that
// brings the cloud cost inside budget.
//
// TEMPORAL: the march also outputs a mean cloud depth; the world point at that
// depth is reprojected into the PREVIOUS frame with rcam.prevVP and the prior
// result is EMA-blended in, motion-shortening the history exactly like
// froxel_inject (a jittered march + short history converges without ghosting;
// under drone motion it accepts a little more noise over smear). History is a
// per-FIF ping-pong (this frame writes slot f, reads the other slot).
//
// Shares the DeferredShade descriptor set (bindings 0/1/2/4/5/35/57/58) + push
// block; new cloud bindings at 59-63.

layout(local_size_x = 8, local_size_y = 8) in;

#include "camera_ubo.glsl"
#include "camera_ray.glsl"// camRayOrigin / camRayDir — perspective AND ortho

#include "lights_ubo.glsl"

layout(set = 0, binding = 2) uniform sampler2D  envTex;      // prefiltered PMREM
layout(set = 0, binding = 4) uniform sampler2D  gbufDepthTex;// .x = Vulkan NDC z
layout(set = 0, binding = 5) uniform usampler2D gbufIdsTex;  // .x = instanceId+1 (0 = sky)
layout(set = 0, binding = 35) uniform sampler2D blueNoiseTex;

layout(set = 0, binding = 57) uniform RasterCamUbo {
    mat4 currVPjittered;
    mat4 currVPunjittered;
    mat4 prevVP;
    vec4 jitter;
    vec4 prevJitter;
} rcam;

// cloud_ubo.glsl's block plus the trailing epoch only this pass reads: keep
// the two in step.
layout(set = 0, binding = 58, scalar) uniform CloudUbo {
    float enabled;
    float coverage;
    float density;
    float bottomY;
    float topY;
    float evolveSpeed;
    float timeSec;
    float heteroActive;
    vec3  wind;
    float hfDensity;
    float hfBaseY;
    float hfFalloff;
    float hfNoiseAmount;
    float shadowActive;
    float epoch;             // history generation — bumped on enable/reconfigure
} clouds;

// Cloud march outputs (half-res) + temporal history (other FIF).
layout(set = 0, binding = 59, rgba16f) uniform writeonly image2D cloudColorImage;// rgb=in-scatter, a=transmittance
layout(set = 0, binding = 60) uniform sampler2D cloudColorPrevTex;                // prev-frame color (reproject)
layout(set = 0, binding = 62, rgba16f) uniform writeonly image2D cloudAuxImage;   // r=mean depth, g=histLen, b=scene dist, a=epoch
layout(set = 0, binding = 63) uniform sampler2D cloudAuxPrevTex;                   // prev-frame aux

// Shared ShadePush block (vulkan_shared.h) — this pass reads only the
// fields it names; the host zero-fills the rest.
layout(push_constant) uniform Pc { ShadePush pc; };
#include "pane_uv.glsl"// paneHalfToPhys: the history taps under a split-screen pane

const float PI = 3.14159265358979;

#include "cloud_density.glsl"
layout(set = 0, binding = 65) uniform sampler2D cloudShadowTex;// the baked cloud maps (cloud_shadow.comp)
#include "cloud_map.glsl"// cloudSunTFrom: the sun light from the maps

vec3 sampleEnvLod(vec3 dir, float lod) {
    // scene.environmentRotation (world -> env) and environmentIntensity.
    if ((lights.envKnobFlags & 1u) != 0u) dir = mat3(lights.envRotC0, lights.envRotC1, lights.envRotC2) * dir;
    const float u = 0.5 + atan(dir.z, dir.x) / (2.0 * PI);
    const float v = 0.5 + asin(clamp(dir.y, -1.0, 1.0)) / PI;
    return textureLod(envTex, vec2(u, v), lod).rgb * lights.envIntensity;
}
#include "hg_phase.glsl"

// The far-field cloud march. ro/rd = world ray; tSceneMax caps to the nearest
// opaque surface (depth-aware clipping — a drone above the deck sees clouds
// BETWEEN it and the ground). Returns vec4(scat, T); outMeanDepth = extinction-
// weighted mean march distance (for temporal reprojection + aerial keying).
// outMeanDepth = -1 when the ray never enters the shell (grazing / geometry
// fully in front): the caller must SKIP temporal reprojection then — a zero
// depth would reproject the CAMERA POSITION through prevVP and inherit
// whatever stale history lives at that garbage UV (the chase-cam ghost trails).
vec4 cloudMarch(vec3 ro, vec3 rd, float maxLod, ivec2 px, float tSceneMax, out float outMeanDepth) {
    outMeanDepth = -1.0;
    // The deck is a SPHERICAL shell: over the curved earth a ray from under the deck climbs
    // relative to the surface by t^2 / 2R, so even a horizontal ray reaches the base (about 100 km out for
    // an 800 m base) and the clouds run down to the horizon under their aerial perspective, instead of
    // stopping above a cloudless band where a flat slab's intersection passed the far cap.
    const float R = 6.371e6;
    float t0, t1;
    if (!kOceanExt) {// upstream: the flat slab
        if (abs(rd.y) < 1e-4) return vec4(0.0, 0.0, 0.0, 1.0);// grazing: no robust slab
        const float tA = (clouds.bottomY - ro.y) / rd.y;
        const float tB = (clouds.topY - ro.y) / rd.y;
        t0 = max(min(tA, tB), 0.0);
        t1 = max(tA, tB);
        t1 = min(t1, min(tSceneMax, 42000.0));// far cap + scene-depth clip
    } else if (ro.y < clouds.bottomY) {
        const float dA = rd.y * rd.y + 2.0 * (clouds.bottomY - ro.y) / R;
        const float dB = rd.y * rd.y + 2.0 * (clouds.topY - ro.y) / R;
        t0 = R * (-rd.y + sqrt(dA));
        t1 = R * (-rd.y + sqrt(dB));
    } else {
        if (abs(rd.y) < 1e-4) return vec4(0.0, 0.0, 0.0, 1.0);// grazing: no robust slab
        const float tA = (clouds.bottomY - ro.y) / rd.y;
        const float tB = (clouds.topY - ro.y) / rd.y;
        t0 = max(min(tA, tB), 0.0);
        t1 = max(tA, tB);
    }
    if (kOceanExt) t1 = min(t1, min(tSceneMax, 160000.0));// far cap + scene-depth clip
    if (t1 <= t0) return vec4(0.0, 0.0, 0.0, 1.0);

    // Steps by the path through the deck (a vertical crossing needs few, a grazing one many), bounded so a
    // sky-filled camera or drone frame stays within its budget; the jitter and the history do the rest
    const int   STEPS = kOceanExt ? clamp(int((t1 - t0) / 80.0), 8, 20) : 48;
    const float dt    = (t1 - t0) / float(STEPS);
    const float jit   = fract(texelFetch(blueNoiseTex, px & 63, 0).r + float(pc.frame) * 0.6180339887);

    vec3 sunDir = (lights.dirCount > 0u) ? normalize(lights.dirLights[0].direction)
                                         : normalize(vec3(0.3, 0.85, 0.2));
    vec3 sunCol = (lights.dirCount > 0u) ? lights.dirLights[0].color : vec3(1.6);
    const vec3  ambTop = sampleEnvLod(vec3(0.0, 1.0, 0.0), max(maxLod - 1.0, 0.0));
    const vec3  ambBot = sampleEnvLod(vec3(0.0, -0.3, 0.0), maxLod) * 0.6 + lights.ambient;
    const float mu    = dot(rd, sunDir);
    const float phase = mix(hgPhase(mu, 0.80), hgPhase(mu, -0.15), 0.5) * 4.0 * PI;

    vec3  scat = vec3(0.0);
    float T    = 1.0;
    float depthSum = 0.0, wSum = 0.0;
    const float time      = clouds.timeSec;
    const float sigmaMul  = 0.05;
    const float lightStep = 90.0;// upstream's sun taps

    for (int i = 0; i < STEPS; ++i) {
        const float t = t0 + (float(i) + jit) * dt;
        vec3 p = ro + rd * t;
        if (kOceanExt) p.y += t * t / (2.0 * R);// height above the curved surface
        const float dens = cloudDensity(p, time);
        if (dens > 0.001) {
            const float sigma = dens * sigmaMul;
            // The sun's light over the next 440 m toward the sun: one density tap for the first
            // 220 m, which carries the cloud's own lit-and-shaded detail, and the baked maps' share for the
            // next 220 m (cloud_map.glsl). Was two density taps, two thirds of the march's noise.
            float sunT;
            if (kOceanExt) {
                sunT = exp(-cloudDensity(p + sunDir * 110.0, time) * sigmaMul * 220.0)
                     * cloudSunTFrom(p + sunDir * 220.0, sunDir, 220.0);
            } else {
                // upstream: five density taps toward the sun
                float sunDepth = 0.0;
                for (int j = 0; j < 5; ++j) {
                    const vec3 lp = p + sunDir * (float(j) + 0.5) * lightStep;
                    sunDepth += cloudDensity(lp, time);
                    // Density is non-negative, so this partial sum is a lower bound
                    // on the sun optical depth and the taps we skip could only
                    // darken sunT further. The cut sits at 12 and not at the usual
                    // 8 because what gets dropped is not exp(-τ) but
                    // sunCol · exp(-τ) · phase, and phase peaks near 22.8 in the
                    // forward-scatter lobe: at 8 that gain lifts the residual back
                    // to a percent of a step's radiance, visible as a flat wash on
                    // the sun-facing side of a thick core that swims as the cloud
                    // churns. At 12 it is ~1e-4 of sunCol, against the ambient term
                    // added on the next line that is orders larger.
                    if (sunDepth * sigmaMul * lightStep > 12.0) break;
                }
                sunT = exp(-sunDepth * sigmaMul * lightStep);
            }
            const float powder = 1.0 - exp(-dens * 3.2);
            const vec3  sunLit = sunCol * (sunT * phase * mix(1.0, powder, 0.6));
            const vec3  amb    = mix(ambBot, ambTop, clamp((p.y - clouds.bottomY) /
                                     max(clouds.topY - clouds.bottomY, 1.0), 0.0, 1.0));
            const vec3  src    = sunLit + amb;
            const float stepT  = exp(-sigma * dt);
            const float w      = T * (1.0 - stepT);
            scat += src * w;
            depthSum += t * w;
            wSum     += w;
            T    *= stepT;
            if (T < 0.02) break;
        }
    }
    // Empty shell: reproject at MID-shell — a stable far point. NEVER t0 (t0
    // can be ~0 with the camera under the deck → camera-position reprojection).
    outMeanDepth = (wSum > 1e-5) ? depthSum / wSum : 0.5 * (t0 + t1);
    // Aerial perspective: distant clouds sink into the sky haze, keyed on the
    // march-entry distance (~45 km scale).
    const float aerial = 1.0 - exp(-t0 * 2.2e-5);
    if (aerial > 0.001) {
        const vec3 haze = sampleEnvLod(rd, maxLod) + lights.ambient;
        scat = mix(scat, haze * (1.0 - T), aerial);
        T    = mix(T, 1.0, aerial * 0.6);
    }
    return vec4(scat, T);
}

void main() {
    const uint hw = (pc.width  + 1u) / 2u;
    const uint hh = (pc.height + 1u) / 2u;
    const ivec2 hp = ivec2(gl_GlobalInvocationID.xy);
    if (uint(hp.x) >= hw || uint(hp.y) >= hh) return;

    if (clouds.enabled < 0.5) {// off: publish the identity composite (col*1 + 0)
        imageStore(cloudColorImage, hp, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(cloudAuxImage,   hp, vec4(0.0));
        return;
    }

    // Full-res UV at this half-res pixel centre → primary ray. cam.jitter.xy
    // restores the G-buffer's Halton raster jitter (same convention as the
    // main shade): the depth reconstruction below and the cloud ray must sit
    // on the SAME raster ray, or tSceneMax clips against a mismatched surface
    // at grazing geometry. (The march itself is blue-noise jittered along t.)
    const vec2 uv  = (vec2(hp) + 0.5) / vec2(float(hw), float(hh));
    const vec2 ndc = vec2(uv.x * 2.0 - 1.0, -(uv.y * 2.0 - 1.0)) + cam.jitter.xy;
    const vec3 rd     = camRayDir(ndc);
    const vec3 camPos = camRayOrigin(ndc);
    const float maxLod = float(max(pc.envMipCount, 1u) - 1u);

    // Depth-aware clip: sky (id 0) → unbounded; else the surface ray-distance.
    // uv is pane-normalized; the ids image shares the depth image's extent, so
    // one rescale serves both taps. The ratio goes first, not paneToPhys: these
    // half-res centres sit on full-res texel EDGES, so fullscreen the uv must
    // pass through to the bit or a nearest tap can flip to the next texel.
    const vec2 guv = uv * (vec2(float(pc.width), float(pc.height)) / vec2(textureSize(gbufDepthTex, 0)));
    const uint id = textureLod(gbufIdsTex, guv, 0.0).x;
    float tSceneMax = 1e30;
    if (id != 0u) {
        const float depth = textureLod(gbufDepthTex, guv, 0.0).x;
        const vec4  viewH = cam.projInverse * vec4(ndc, depth, 1.0);
        const vec3  wp    = (cam.viewInverse * vec4(viewH.xyz / viewH.w, 1.0)).xyz;
        tSceneMax = length(wp - camPos);
    }

    float meanDepth;
    vec4  cur = cloudMarch(camPos, rd, maxLod, hp, tSceneMax, meanDepth);

    // ── Temporal reprojection + EMA ──────────────────────────────────────────
    // Reproject the (extinction-weighted) cloud point into the previous frame's
    // UNJITTERED screen with rcam.prevVP; blend the prior result in. Validity:
    // a real shell hit this frame (meanDepth ≥ 0 — no-shell pixels must NOT
    // accumulate: their identity output is exact every frame), in front of the
    // prev camera, on-screen, same history EPOCH (rejects undefined first-enable
    // contents and pre-reconfigure patterns), and a sane prev history value.
    vec3  outScat = cur.rgb;
    float outT    = cur.a;
    float hist    = 1.0;
    if (meanDepth >= 0.0) {
        const vec3 wpMean = camPos + rd * meanDepth;
        const vec4 pClip  = rcam.prevVP * vec4(wpMean, 1.0);
        if (pClip.w > 1e-4) {
            const vec2 pNdc = pClip.xy / pClip.w;
            const vec2 pUv  = vec2(pNdc.x * 0.5 + 0.5, 0.5 - pNdc.y * 0.5);
            if (all(greaterThanEqual(pUv, vec2(0.0))) && all(lessThanEqual(pUv, vec2(1.0)))) {
                const vec4 prevC = texture(cloudColorPrevTex, paneHalfToPhys(cloudColorPrevTex, pUv));
                const vec4 prevA = texture(cloudAuxPrevTex, paneHalfToPhys(cloudAuxPrevTex, pUv));// r=depth, g=histLen, b=sceneDist, a=epoch
                const bool valid = prevA.g > 0.5 && prevA.g < 4096.0
                                 && abs(prevA.a - clouds.epoch) < 0.5
                                 && all(lessThan(abs(prevC.rgb), vec3(1e6)))
                                 && prevC.a >= -0.01 && prevC.a <= 1.01;
                if (valid) {
                    // Motion-shortened cap (froxel_inject rule): a static view
                    // converges long; drone motion drops it toward a few frames.
                    const float motion = pc.camRot * 3.0 + pc.camDelta * 0.5;
                    const float cap    = mix(24.0, 3.0, smoothstep(0.001, 0.02, motion));
                    hist = min(prevA.g + 1.0, cap);
                    const float k = 1.0 / hist;
                    outScat = mix(prevC.rgb, cur.rgb, k);
                    outT    = mix(prevC.a,   cur.a,   k);
                }
            }
        }
    }

    imageStore(cloudColorImage, hp, vec4(outScat, outT));
    // .b = the scene distance this march clipped against (fp16-clamped) — the
    // shade's depth-aware upsample rejects taps whose cloud lies BEHIND its
    // own pixel's surface. .a = epoch (history generation gate above).
    imageStore(cloudAuxImage,   hp, vec4(max(meanDepth, 0.0), hist,
                                         min(tSceneMax, 60000.0), clouds.epoch));
}
