#version 460
#extension GL_GOOGLE_include_directive : enable

// PostComposite — the camera/display end of the HDR pipeline (PostComposite
// pass class; split out of BloomPass, which now owns only the bloom pyramid).
//
// Reads the linear-HDR scene (sceneHdr, written by the deferred shade),
// optionally adds the blurred bloom buffer in linear HDR, then:
//   exposure → white balance (Bradford, linear) → tone map → grading LUT
//   (display-referred 33³) → sRGB encode → TAA input image.
//
// With bloom, white balance and the grade LUT all inactive this reproduces
// the old composite.comp tone-map + sRGB + solid-bg-bypass byte-exactly.
//
// PRE-EXPOSURE (physical camera mode): the shade/resolve stages already
// multiplied sceneHdr by the full exposure so fp16 survives 100k-lux light
// levels. preExposureBits carries that factor; the tone-map curve then runs
// at exposure/preExposure (== 1.0 when pre-exposed, == exposure when not —
// legacy mode passes preExposure = 1.0 and is numerically unchanged).
//
// HDR MODE (FSR/DLSS upscaler path, postFlags bit 3): an external upscaler
// (FSR 3.1 / DLSS) replaces the TAA resolve and writes its upscaled linear-
// HDR output into TaaResolve's history slot, so `color` comes from
// hdrSceneTex (binding 6 — that upscaled history slot) plus the bloom add,
// this dispatch runs at DISPLAY resolution,
// and the result is written to hdrOutImg (binding 7) instead of outImage —
// see PostComposite.hpp/.cpp for why (this class's descriptor sets are
// frame-in-flight-, not swapchain-image-, indexed, so it can't write the
// swapchain directly; the caller finalizes hdrOutImg into the swapchain via
// TaaResolve's existing swapchain-indexed RCAS/copy machinery). The sky-mask
// source (rasterIdsTex) still lives at RENDER resolution, so a pixel
// at display-res `px` maps to mask texel `px * srcWH / dispatchWH`.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D sceneHdrTex;            // linear HDR, render extent
layout(set = 0, binding = 1) uniform sampler2D bloomTex;               // blurred bloom (half res)
// (binding 2 retired: the PT-era gbuf ping-pong sky source — the deferred
// renderer's sky test reads rasterIdsTex below; PT was removed 2026-07-09.)
// No format qualifier: the TAA-input image is VK_FORMAT_B8G8R8A8_UNORM (matches
// the swapchain channel order) but GLSL has no bgra8 format qualifier. Declaring
// rgba8 here mismatches the bound VkImageView and yields undefined stores
// (Undefined-Value-StorageImage-FormatMismatch-ImageView). Writing without a
// format needs shaderStorageImageWriteWithoutFormat (enabled at device
// creation) — channel names (r/g/b/a) still map by component, so the stored
// value is unchanged. Matches taa_resolve.comp / rcas.comp's swapchain writes.
layout(set = 0, binding = 3) uniform writeonly image2D outImage;// TAA input (bgra8, no format)
// Display-referred colour-grade LUT (lift/gamma/gain/saturation/contrast
// baked on the CPU). Only sampled when pc.postFlags bit 1 is set, so the
// default path never pays the fetch; the image is always bound ("always
// bound, harmlessly unused" — the identity content is never read).
layout(set = 0, binding = 4) uniform sampler3D gradeLutTex;// 33³ rgba16f
// The sky source for the solid-bg bypass below: the raster G-buffer ids
// attachment (.x = instanceCustomIndex+1, 0 = sky).
layout(set = 0, binding = 5) uniform usampler2D rasterIdsTex;
// HDR-mode-only (harmlessly bound + unused otherwise): the FSR/DLSS upscaler's
// output (binding 6, sampled — upscaled linear HDR at DISPLAY extent, read
// from TaaResolve's history slot) and this pass's HDR-mode output target
// (binding 7, storage, bgra8 display extent — PostComposite::hdrOut_).
layout(set = 0, binding = 6) uniform sampler2D hdrSceneTex;
layout(set = 0, binding = 7) uniform writeonly image2D hdrOutImg;

layout(push_constant) uniform Pc {
    uint toneMapping;        // matches ToneMapping enum
    uint exposureBits;       // float-bits for the FULL exposure
    uint bgIsSolidColor;     // 1 = solid bg → sky pixels skip tone map
    uint bloomIntensityBits; // float; <= 0 disables the bloom add
    uint width;
    uint height;
    uint postFlags;          // bit 0 = white balance active, bit 1 = grade LUT active,
                             // bit 2 retired (was: PT-era gbuf sky source select),
                             // bit 3 = HDR mode (FSR/DLSS upscaler path)
    uint preExposureBits;    // float-bits: exposure already baked into sceneHdr (1.0 = none)
    vec4 wbRow0;             // white-balance mat3 rows (linear sRGB → linear sRGB),
    vec4 wbRow1;             // Bradford CAT scene-illuminant → D65. .w unused.
    vec4 wbRow2;
    // HDR-mode-only: the sky-mask sources' RENDER extent, for scaling the
    // display-res dispatch's texel index down to their native texel grid.
    // Equals width/height (no scaling) in LDR mode or at renderScale == 1.
    uint srcWidth;
    uint srcHeight;
} pc;

bool isHdrMode() { return (pc.postFlags & 8u) != 0u; }

// linearToSRGB and toneMap (the curves, shared with particle.frag's lit path).
#include "tonemap.glsl"

void main() {
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.width) || px.y >= int(pc.height)) return;

    const vec2 uv = (vec2(px) + 0.5) / vec2(float(pc.width), float(pc.height));
    const bool hdr = isHdrMode();

    // HDR mode: the resolve already bloomed + exposure-rescaled this at
    // DISPLAY resolution — sample it directly, no second bloom add (the
    // caller also passes bloomIntensityBits <= 0 in this mode, so the add
    // below is skipped either way; the branch just avoids the extra fetch).
    vec3 color = hdr ? texture(hdrSceneTex, uv).rgb
                      : texelFetch(sceneHdrTex, px, 0).rgb;// 1:1 with output — exact texel

    const float intensity = uintBitsToFloat(pc.bloomIntensityBits);
    if (intensity > 0.0) {
        // Additive bloom: the bloom buffer is a soft-knee bright-pass (only
        // highlights survive the threshold in bloom_down), so adding it leaves
        // darks/mid-tones crisp and makes bright areas glow. Intensity can be
        // pushed well past 1 without the global haze a thresholdless mix gives.
        // Bloom upsampled from half res via bilinear.
        //
        // Normally skipped in HDR mode (the TAA resolve folds bloom in, and the
        // caller passes intensity <= 0). The FSR upscaler path does NOT fold
        // bloom in — it passes a non-zero intensity here so bloom is added onto
        // the upscaled HDR at display res (the bloom pyramid is render-extent
        // half-res; bilinear UV sampling handles the resolution difference).
        const vec3 bloom = texture(bloomTex, uv).rgb;
        color += bloom * intensity;
    }

    const float exposure = uintBitsToFloat(pc.exposureBits);
    const float preExp   = uintBitsToFloat(pc.preExposureBits);
    // Solid-color background sky pixels skip tone mapping (so the flat bg
    // isn't ACES-desaturated) but are still sRGB-encoded — matches the old
    // finalize behaviour exactly. They skip white balance + grading too:
    // the contract is an EXACT background colour. The sky id source depends
    // on the renderer (see the binding-5 note). HDR mode: the sky-mask
    // sources are still RENDER-extent while `px` is DISPLAY-extent — scale
    // down to the mask's native texel grid (identity at renderScale == 1).
    //
    // The id fetch sits INSIDE the bgIsSolidColor test: that flag is a push
    // constant, so the branch is dispatch-uniform (every invocation takes the
    // same side, no divergence to pay for) and on a sky/env-map frame the whole
    // ids read — one distinct R32G32B32A32_UINT texel per pixel, so real DRAM
    // traffic, not an L1 hit — disappears from the one pass that always runs.
    bool bypass = false;
    if (pc.bgIsSolidColor != 0u) {
        const ivec2 maskPx = hdr ? ivec2(vec2(px) * vec2(float(pc.srcWidth), float(pc.srcHeight))
                                         / vec2(float(pc.width), float(pc.height)))
                                 : px;
        bypass = float(texelFetch(rasterIdsTex, maskPx, 0).x) < 0.5;
    }
    vec3 outRgb;
    if (bypass) {
        // Bypass pixels are stored at DISPLAY scale (the shade/resolve skips
        // the pre-exposure for solid-bg sky) — restore verbatim, no divide.
        outRgb = linearToSRGB(color);
    } else {
        // White balance in linear scene-referred space, before the tone curve.
        if ((pc.postFlags & 1u) != 0u)
            color = vec3(dot(pc.wbRow0.xyz, color),
                         dot(pc.wbRow1.xyz, color),
                         dot(pc.wbRow2.xyz, color));
        const vec3 mapped = toneMap(color, pc.toneMapping, exposure / preExp);
        outRgb = linearToSRGB(mapped);
        // Colour grade on the sRGB-ENCODED display-referred result — one
        // trilinear tap into the CPU-baked LUT (half-texel corrected for
        // 33³). Encoded domain: perceptually uniform LUT coordinates (a
        // linear-domain 33³ bands in the shadows) and the conventional
        // space for lift/gamma/gain wheels.
        if ((pc.postFlags & 2u) != 0u) {
            const vec3 lc = clamp(outRgb, 0.0, 1.0) * (32.0 / 33.0) + (0.5 / 33.0);
            outRgb = texture(gradeLutTex, lc).rgb;
        }
    }
    if (hdr) imageStore(hdrOutImg, px, vec4(outRgb, 1.0));
    else     imageStore(outImage,  px, vec4(outRgb, 1.0));
}
