#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : enable

// Cloud shadow map — a 512² R8 top-down cloud TRANSMITTANCE field over an
// 8 km square centred on the camera. One thread per texel marches the cloud
// shell along the SUN direction and stores exp(-τ) (1 = full sun, 0 = full
// shade). The surface shading, froxel sun in-scatter and water path multiply
// their sun visibility by a bilinear sample of this map → moving cloud shadows
// crawling over the terrain (the single biggest realism win for aerial
// footage). Regenerated every frame (it's tiny) so it wind-scrolls with the
// clouds. Only dispatched when clouds are on (clouds.shadowActive).
//
// Shares the DeferredShade set (bindings 0/1/58) + push block; writes the new
// binding 64.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform CameraUbo {
    mat4 viewInverse;
    mat4 projInverse;
    vec4 jitter;
} cam;

struct DirLight   { vec3 direction; vec3 color; };
struct PointLight { vec3 position; float range; vec3 color; float decay; float radius; };
struct SpotLight  { vec3 position; float range; vec3 color; float decay;
                    vec3 direction; float cosAngleOuter; float cosAngleInner; float radius; };
struct RectLight  { vec3 position; vec3 halfU; vec3 halfV; vec3 normal; vec3 color; };
layout(set = 0, binding = 1, scalar) uniform LightsUbo {
    vec3       ambient;
    uint       dirCount;
    DirLight   dirLights[8];
    uint       pointCount;
    uint       spotCount;
    uint       rectCount;
    PointLight pointLights[8];
    SpotLight  spotLights[8];
    RectLight  rectLights[4];
} lights;

layout(set = 0, binding = 58, scalar) uniform CloudUbo {
    float enabled;
    float coverage;
    float density;
    float bottomY;
    float topY;
    float evolveSpeed;
    float timeSec;
    float heteroActive;
    vec3  wind;
    float hfDensity;
    float hfBaseY;
    float hfFalloff;
    float hfNoiseAmount;
    float shadowActive;
} clouds;

layout(set = 0, binding = 64, r8) uniform writeonly image2D cloudShadowImage;

layout(push_constant) uniform Pc {
    uint  envMipCount;
    uint  width;
    uint  height;
    uint  flags;
    uint  frame;
    uint  emissiveCount;
    float emissiveTotalPower;
    float fireflyClamp;
    float oceanFineTileSize;
    float oceanFoamTileSize;
    float volDensity;
    float volAniso;
    float starIntensity;
    float camDelta;
    float camRot;
    float timeSec;
    float sunTanHalfAngle;
    uint  clusterLightCount;
    uint  shadeMode;
} pc;

const float PI = 3.14159265358979;

#include "cloud_density.glsl"// cloudDensity, kCloudSigmaMul

// KEEP IN SYNC with cloudShadowSample() in deferred_shade_10_lighting_utils.glsl
// + froxel_inject.comp: the map covers a 2·kCloudShadowHalfExt square centred on
// the camera XZ.
const float kCloudShadowHalfExt = 4000.0;// metres (8 km square)
const int   kCloudShadowRes     = 512;

void main() {
    const ivec2 tx = ivec2(gl_GlobalInvocationID.xy);
    if (tx.x >= kCloudShadowRes || tx.y >= kCloudShadowRes) return;
    if (clouds.shadowActive < 0.5) { imageStore(cloudShadowImage, tx, vec4(1.0)); return; }

    // Texel → world XZ (camera-centred square).
    const vec2 uv    = (vec2(tx) + 0.5) / float(kCloudShadowRes);
    const vec2 cenXZ = cam.viewInverse[3].xz;
    const vec2 wxz   = cenXZ + (uv * 2.0 - 1.0) * kCloudShadowHalfExt;

    const vec3 sunDir = (lights.dirCount > 0u) ? normalize(lights.dirLights[0].direction)
                                               : normalize(vec3(0.3, 0.85, 0.2));
    // Sun near/under the horizon: no meaningful vertical cloud shadow.
    if (sunDir.y < 0.05) { imageStore(cloudShadowImage, tx, vec4(1.0)); return; }

    // March the shell along the sun ray from the base up through the top,
    // accumulating optical depth (a few taps — the map is low-frequency).
    const vec3  origin = vec3(wxz.x, clouds.bottomY, wxz.y);
    const float tExit  = (clouds.topY - clouds.bottomY) / sunDir.y;
    const int   N      = 8;
    const float seg    = tExit / float(N);
    float od = 0.0;
    for (int i = 0; i < N; ++i) {
        const vec3 p = origin + sunDir * (float(i) + 0.5) * seg;
        od += cloudDensity(p, clouds.timeSec);
    }
    const float T = exp(-od * seg * kCloudSigmaMul);
    imageStore(cloudShadowImage, tx, vec4(clamp(T, 0.0, 1.0)));
}
