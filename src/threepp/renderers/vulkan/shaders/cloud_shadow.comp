#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : enable

#include "vulkan_shared.h"// ShadePush

// Cloud maps — a 512x1024 R8 image: the top half is the top-down
// cloud SUN TRANSMITTANCE field over a 16 km square centred on the camera, the
// bottom half the deck's vertical column transmittance over 160 km (the far
// map, see below and cloud_map.glsl). One thread per texel marches the cloud
// shell along the SUN direction and stores exp(-τ) (1 = full sun, 0 = full
// shade). The surface shading, froxel sun in-scatter and water path multiply
// their sun visibility by a bilinear sample of this map → moving cloud shadows
// crawling over the terrain (the single biggest realism win for aerial
// footage). Regenerated every frame (it's tiny) so it wind-scrolls with the
// clouds. Only dispatched when clouds are on (clouds.shadowActive).
//
// Shares the DeferredShade set (bindings 0/1/58) + push block; writes the new
// binding 64.

layout(local_size_x = 8, local_size_y = 8) in;

#include "camera_ubo.glsl"

#include "lights_ubo.glsl"

#include "cloud_ubo.glsl"

layout(set = 0, binding = 64, r8) uniform writeonly image2D cloudShadowImage;

// Shared ShadePush block (vulkan_shared.h) — this pass reads only the
// fields it names; the host zero-fills the rest.
layout(push_constant) uniform Pc { ShadePush pc; };

const float PI = 3.14159265358979;

#include "cloud_density.glsl"// cloudDensity, kCloudSigmaMul

// KEEP IN SYNC with cloud_map.glsl (the readers): rows 0-511 the NEAR sun map over a 16 km square, rows
// 512-1023 the FAR column map over a 160 km square, both centred on the camera xz.
const float kCloudShadowHalfExt = 8000.0;// metres (16 km square: a low sun puts the shadow kilometres off its cloud)
const float kCloudFarHalfExt    = 80000.0;
const float kCloudShadowHalfExtUpstream = 4000.0;// metres (upstream's 8 km square, kOceanExt off)
const int   kCloudShadowRes     = 512;

void main() {
    const ivec2 tx = ivec2(gl_GlobalInvocationID.xy);
    // the extended ocean (kOceanExt): the near and the far map stacked; upstream's one 512² near map over 8 km without it
    if (tx.x >= kCloudShadowRes || tx.y >= (kOceanExt ? 2 : 1) * kCloudShadowRes) return;
    if (clouds.shadowActive < 0.5) { imageStore(cloudShadowImage, tx, vec4(1.0)); return; }
    const bool far = kOceanExt && tx.y >= kCloudShadowRes;

    // Texel → world XZ (camera-centred square).
    const vec2 uv    = kOceanExt ? (vec2(tx.x, tx.y % kCloudShadowRes) + 0.5) / float(kCloudShadowRes)
                                 : (vec2(tx) + 0.5) / float(kCloudShadowRes);
    const vec2 cenXZ = cam.viewInverse[3].xz;
    const vec2 wxz   = kOceanExt ? cenXZ + (uv * 2.0 - 1.0) * (far ? kCloudFarHalfExt : kCloudShadowHalfExt)
                                 : cenXZ + (uv * 2.0 - 1.0) * kCloudShadowHalfExtUpstream;

    if (far) {
        // The column's vertical transmittance from the eroded density's expectation, 3 taps: what the water's
        // reflected deck and the far shadows and sun light read (cloud_map.glsl)
        const float th = max(clouds.topY - clouds.bottomY, 1.0);
        float od = 0.0;
        for (int i = 0; i < 3; ++i)
            od += cloudDensityMean(vec3(wxz.x, clouds.bottomY + (float(i) + 0.5) / 3.0 * th, wxz.y), clouds.timeSec);
        imageStore(cloudShadowImage, tx, vec4(clamp(exp(-od * th / 3.0 * kCloudSigmaMul), 0.0, 1.0)));
        return;
    }

    const vec3 sunDir = (lights.dirCount > 0u) ? normalize(lights.dirLights[0].direction)
                                               : normalize(vec3(0.3, 0.85, 0.2));
    // Sun near/under the horizon: no meaningful vertical cloud shadow.
    if (sunDir.y < 0.05) { imageStore(cloudShadowImage, tx, vec4(1.0)); return; }

    // March the shell along the sun ray from the base up through the top,
    // accumulating optical depth (a few taps — the map is low-frequency).
    const vec3  origin = vec3(wxz.x, clouds.bottomY, wxz.y);
    const float tExit  = (clouds.topY - clouds.bottomY) / sunDir.y;
    const int   N      = kOceanExt ? 4 : 8;
    const float seg    = tExit / float(N);
    float od = 0.0;
    for (int i = 0; i < N; ++i) {
        const vec3 p = origin + sunDir * (float(i) + 0.5) * seg;
        od += cloudDensity(p, clouds.timeSec);
        // cloudDensity is non-negative, so the running sum is a LOWER bound on
        // the final optical depth and the remaining taps can only push T down.
        // Once the bound crosses 8, T is already below exp(-8) = 3.35e-4, and
        // cloudShadowImage is R8_UNORM: everything under 1/510 quantises to
        // byte 0. Stopping here is therefore bit-identical rather than an
        // approximation — but the proof is the 8-bit target, so widening that
        // format to R16 turns this straight into a flat-black clamp.
        if (od * seg * kCloudSigmaMul > 8.0) break;
    }
    const float T = exp(-od * seg * kCloudSigmaMul);
    imageStore(cloudShadowImage, tx, vec4(clamp(T, 0.0, 1.0)));
}
