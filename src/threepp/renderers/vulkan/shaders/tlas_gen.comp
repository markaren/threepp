// tlas_gen.comp — the TLAS instance descriptors of an InstancedMesh span,
// written on the GPU (stage 5 of plans/gpu-driven-instances.md).
//
// The lean path's TLAS fill (ensureSceneBuilt) writes one
// VkAccelerationStructureInstanceKHR per entry on the CPU every frame anything
// moves or changes class. For an eligible instanced span (static, no cutout
// ray distance; TlasGen.hpp) the fill writes
// none: it hands this shader the span's BLAS address, mask and flags (the
// mask cleared per instance on the side of a LOD crossfade no ray hits; with
// an auto-LOD chain, the BLAS of the entry's level, MeshEntry::lodLevel), and the
// shader appends the span's instances after the CPU's in the same instance
// buffer (the TLAS order is free: instanceCustomIndex is the entry index).
// Per instance: the 3x4 row-major transform of the world matrix stage 1
// (instance_expand.comp) produced for the entry, bit for bit the CPU's.

#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive : enable

#include "vulkan_shared.h"// kLodFade*

layout(local_size_x = 64) in;

// Matches TlasGen::SpanDesc (scalar, 64 B).
struct TlasSpan {
    uint64_t blasAddress;// level 0's
    uint     firstEntry;// entry index of instance 0
    uint     count;
    uint     instBase;  // instance index of instance 0 in the buffer
    uint     workBase;  // exclusive prefix sum of count
    uint     maskWord;  // mask << 24 (instanceCustomIndex goes in the low 24 bits)
    uint     flagsWord; // instance flags << 24 (SBT record offset 0)
    uint     lodRowBase; // its first level BLAS address, when lodRowCount > 0
    uint     lodRowCount;// levels 1..n, then the fallback; 0: no chain
    float    rayShadowDist;// ray shadow LOD (0 = off) ...
    float    rayShadowFrom;
    vec3     center;       // ... to the object-space bounding sphere
    float    radius;
};

layout(set = 0, binding = 0, scalar) readonly  buffer Spans { TlasSpan spans[]; };
layout(set = 0, binding = 1, scalar) readonly  buffer World { float    world[]; };// 16 per entry
layout(set = 0, binding = 2, scalar) writeonly buffer Insts { uint     instWords[]; };// 16 per instance
layout(set = 0, binding = 3, scalar) readonly  buffer Fades { uint     lodFades[]; };// entryLodFade_
layout(set = 0, binding = 4, scalar) readonly  buffer Rows  { uint64_t lodBlas[]; };// selectLodGeom(rec, k).asAddress
layout(set = 0, binding = 5, scalar) readonly  buffer Levels { uint    lodLevelWords[]; };// a byte per entry

// VulkanRenderer::Impl::lodFadeCasts: the side of a crossfade that keeps the
// shadows (the other side is hit by no ray).
bool lodFadeCasts(uint word) {
    if (word == 0u) return true;
    const uint cut = (word & kLodFadeCutMask) >> kLodFadeCutShift;
    return (word & kLodFadeComplement) != 0u ? 2u * cut < kLodFadeSteps : 2u * cut > kLodFadeSteps;
}

layout(push_constant, scalar) uniform Pc {
    uint spanCount;
    uint totalWork;
    vec3 camPos;// the camera the CPU's ray shadow states were derived for
} pc;

// VulkanRenderer::Impl::entryBeyond: the whole bounding sphere farther from
// the camera than dist. `precise`: the CPU's float ops, unfused.
bool entryBeyond(uint e, vec3 c, float r, float dist) {
    if (r <= 0.0) return false;
    const uint b = e * 16u;
    precise float cx = world[b + 0u] * c.x + world[b + 4u] * c.y + world[b + 8u] * c.z + world[b + 12u];
    precise float cy = world[b + 1u] * c.x + world[b + 5u] * c.y + world[b + 9u] * c.z + world[b + 13u];
    precise float cz = world[b + 2u] * c.x + world[b + 6u] * c.y + world[b + 10u] * c.z + world[b + 14u];
    precise float s0 = world[b + 0u] * world[b + 0u] + world[b + 1u] * world[b + 1u] + world[b + 2u] * world[b + 2u];
    precise float s1 = world[b + 4u] * world[b + 4u] + world[b + 5u] * world[b + 5u] + world[b + 6u] * world[b + 6u];
    precise float s2 = world[b + 8u] * world[b + 8u] + world[b + 9u] * world[b + 9u] + world[b + 10u] * world[b + 10u];
    precise float reach = dist + r * sqrt(max(s0, max(s1, s2)));
    precise float dx = pc.camPos.x - cx, dy = pc.camPos.y - cy, dz = pc.camPos.z - cz;
    precise float d2 = dx * dx + dy * dy + dz * dz;
    precise float r2 = reach * reach;
    return d2 > r2;
}

// VulkanRenderer::Impl::entryRayMask with classifyRayShadow's states: the
// span's mask, dropped on the side of a LOD crossfade no ray hits, made a
// no-shadow one by the ray shadow LOD, kept by a proxy past rayShadowFrom.
uint instanceMask(uint s, uint e) {
    const uint group = spans[s].maskWord >> 24;
    if (group == 0u) return 0u;
    const float dist = spans[s].rayShadowDist, from = spans[s].rayShadowFrom;
    const bool proxy = from > 0.0 && entryBeyond(e, spans[s].center, spans[s].radius, from);
    if (proxy && group != kRayMaskNoShadow) return group;
    if (!lodFadeCasts(lodFades[e])) return 0u;
    if (group == kRayMaskOpaque &&
        ((dist > 0.0 && entryBeyond(e, spans[s].center, spans[s].radius, dist)) || (from > 0.0 && !proxy)))
        return kRayMaskNoShadow;
    return group;
}

void main() {
    const uint g = gl_GlobalInvocationID.x;
    if (g >= pc.totalWork) return;

    uint lo = 0u, hi = pc.spanCount;
    while (lo + 1u < hi) {
        const uint mid = (lo + hi) >> 1u;
        if (spans[mid].workBase <= g) lo = mid;
        else hi = mid;
    }
    const uint j = g - spans[lo].workBase;
    if (j >= spans[lo].count) return;

    const uint e = spans[lo].firstEntry + j;
    const uint o = (spans[lo].instBase + j) * 16u;
    // VkTransformMatrixKHR: row-major 3x4; the world matrix is column-major
    // 4x4 (element [c * 4 + r]).
    for (uint r = 0u; r < 3u; ++r)
        for (uint c = 0u; c < 4u; ++c)
            instWords[o + r * 4u + c] = floatBitsToUint(world[e * 16u + c * 4u + r]);
    instWords[o + 12u] = (e & 0x00FFFFFFu) | (instanceMask(lo, e) << 24);
    instWords[o + 13u] = spans[lo].flagsWord;
    uint64_t blas = spans[lo].blasAddress;
    if (spans[lo].lodRowCount > 0u) {
        const uint level = (lodLevelWords[e >> 2u] >> ((e & 3u) * 8u)) & 0xFFu;
        const uint row   = min(level, spans[lo].lodRowCount);
        if (row > 0u) blas = lodBlas[spans[lo].lodRowBase + row - 1u];
    }
    instWords[o + 14u] = uint(blas & 0xFFFFFFFFul);
    instWords[o + 15u] = uint(blas >> 32);
}
