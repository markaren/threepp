#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : enable

#include "vulkan_shared.h"// ShadePush

// Froxel volumetric lighting — INJECT (Wronski 2014 / Frostbite). One thread
// per froxel of a kFroxelX×kFroxelY×kFroxelZ view-frustum grid (screen tiles ×
// exponential view-Z slices): computes the in-scattered radiance PER UNIT
// LENGTH at a jittered position inside the froxel —
//   • the clustered POINT lights only (the cluster list, not the 8-cap UBO —
//     the soft omnidirectional fog glow; SPOTS are skipped and the directional
//     SUN is NOT injected here — both are high-frequency shafts the froxel grid
//     cannot resolve, so they stay per-pixel in deferred_shade.comp's
//     volumetricSpot/DirScatter marches),
//   • Henyey-Greenstein phase and camera/light-leg extinction matching the
//     per-pixel point-glow terms term for term —
// and EMA-accumulates it against the previous frame's froxel (the sub-froxel
// jitter is what turns 1 sample/froxel into a converged integral; camera
// motion shortens the history so beams track instead of smearing). The
// INTEGRATE pass then folds the slices front-to-back into the 3D LUT the
// shade pass samples with one trilinear fetch per pixel. The LUT's .a channel
// also carries the medium-extinction transmittance the surface path reads.
//
// Shares the DeferredShade set (bindings 0/1/8/33/48/49/50/51) + push block.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0) uniform CameraUbo {
    mat4 viewInverse;
    mat4 projInverse;
    vec4 jitter;
    vec4 camAux;// .x = parallel projection, .yzw = camera world forward
} cam;
#include "camera_ray.glsl"// camViewPointAtDist / camRayOrigin — perspective AND ortho

struct DirLight   { vec3 direction; vec3 color; };
struct PointLight { vec3 position; float range; vec3 color; float decay; float radius; };
struct SpotLight  { vec3 position; float range; vec3 color; float decay;
                    vec3 direction; float cosAngleOuter; float cosAngleInner; float radius; };
struct RectLight  { vec3 position; vec3 halfU; vec3 halfV; vec3 normal; vec3 color; };
layout(set = 0, binding = 1, scalar) uniform LightsUbo {
    vec3       ambient;
    uint       dirCount;
    DirLight   dirLights[8];
    uint       pointCount;
    uint       spotCount;
    uint       rectCount;
    PointLight pointLights[8];
    SpotLight  spotLights[8];
    RectLight  rectLights[4];
} lights;

layout(set = 0, binding = 8) uniform accelerationStructureEXT topAS;

layout(set = 0, binding = 33, scalar) uniform FogUbo {
    vec3  sigmaT;
    float enabled;
    vec3  color;
    float anisotropy;
    float waterSurfaceY;
    vec3  worldUp;
} fog;

// KEEP IN SYNC with cluster_build.comp / deferred_shade.comp.
struct ClusterLight {
    vec3  position;   float range;
    vec3  color;      float decay;
    vec3  direction;  float cosAngleOuter;
    float cosAngleInner;
    float radius;
    float cullRadius;
    float type;
};
layout(set = 0, binding = 48, scalar) readonly buffer ClusterGridBuf { uint clusterGrid[]; };
layout(set = 0, binding = 49, scalar) readonly buffer ClusterLightsBuf { ClusterLight clusterLights[]; };

// Froxel scatter accumulator: .rgb = in-scatter per unit length, .a = histLen.
layout(set = 0, binding = 50, rgba16f) uniform writeonly image3D froxelScatterImage;
layout(set = 0, binding = 51) uniform sampler3D froxelScatterPrevTex;// prev fif (EMA history)

// Cloud + height-fog UBO (heterogeneous near-field medium). Matches the
// deferred_shade / cloud_march scalar block.
layout(set = 0, binding = 58, scalar) uniform CloudUbo {
    float enabled;
    float coverage;
    float density;
    float bottomY;
    float topY;
    float evolveSpeed;
    float timeSec;
    float heteroActive;
    vec3  wind;
    float hfDensity;
    float hfBaseY;
    float hfFalloff;
    float hfNoiseAmount;
    float shadowActive;
} clouds;

layout(set = 0, binding = 65) uniform sampler2D cloudShadowTex;// top-down cloud transmittance
// Cloud shadow transmittance at a world point — KEEP IN SYNC with
// deferred_shade_10_lighting_utils.glsl / cloud_shadow.comp.
float cloudShadowSample(vec3 worldPos) {
    if (clouds.shadowActive < 0.5) return 1.0;
    const float halfExt = 4000.0;
    const vec2  cenXZ   = cam.viewInverse[3].xz;
    const vec2  suv     = (worldPos.xz - cenXZ) / (2.0 * halfExt) + 0.5;
    if (any(lessThan(suv, vec2(0.0))) || any(greaterThan(suv, vec2(1.0)))) return 1.0;
    return texture(cloudShadowTex, suv).r;
}

// Shared ShadePush block (vulkan_shared.h) — this pass reads only the
// fields it names; the host zero-fills the rest.
layout(push_constant) uniform Pc { ShadePush pc; };

const float PI = 3.14159265358979;

// Grid + ladders — KEEP IN SYNC with froxel_integrate.comp + deferred_shade.comp.
const uint  kFroxelX = 128u, kFroxelY = 72u, kFroxelZ = 64u;
const float kFroxelZMin = 0.25, kFroxelZMax = 512.0;
// Cluster grid constants — KEEP IN SYNC with cluster_build.comp.
const uint  kClusterX = 16u, kClusterY = 8u, kClusterZ = 24u;
const uint  kClusterMaxPerCell = 24u;
const float kClusterZMin = 0.1, kClusterZMax = 1024.0;

float froxelDist(float s) {// continuous slice coord [0,kFroxelZ] → view distance
    return kFroxelZMin * pow(kFroxelZMax / kFroxelZMin, s / float(kFroxelZ));
}

uint clusterCellBase(vec2 uv, float viewDist) {
    const uint cx = min(uint(uv.x * float(kClusterX)), kClusterX - 1u);
    const uint cy = min(uint(uv.y * float(kClusterY)), kClusterY - 1u);
    const float t = log(max(viewDist, kClusterZMin) / kClusterZMin)
                  / log(kClusterZMax / kClusterZMin);
    const uint cz = min(uint(max(t, 0.0) * float(kClusterZ)), kClusterZ - 1u);
    return (cx + cy * kClusterX + cz * kClusterX * kClusterY) * (kClusterMaxPerCell + 1u);
}

float hgPhase(float mu, float g) {
    const float g2 = g * g;
    return (1.0 - g2) / (4.0 * PI * pow(max(1.0 + g2 - 2.0 * g * mu, 1e-4), 1.5));
}

uint pcgHash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word  = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}
float rnd(inout uint seed) {
    seed = pcgHash(seed);
    return float(seed) * (1.0 / 4294967296.0);
}

// Binary occlusion toward a light (opaque-only mask matches the surface
// shadow rays: blend/glass never blocks a shaft).
float shadowVis(vec3 origin, vec3 dir, float tMax) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, topAS, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
                          0x01u /*kRayMaskOpaque*/, origin, 1e-3, dir, tMax);
    while (rayQueryProceedEXT(rq)) {}
    return (rayQueryGetIntersectionTypeEXT(rq, true) ==
            gl_RayQueryCommittedIntersectionNoneEXT) ? 1.0 : 0.0;
}

#include "cloud_density.glsl"// heightFogDensity + mediumExtinction (hetero mode)

void main() {
    const uvec3 f = gl_GlobalInvocationID;
    if (f.x >= kFroxelX || f.y >= kFroxelY || f.z >= kFroxelZ) return;
    const ivec3 fi = ivec3(f);

    // Jittered sample position inside the froxel (sub-froxel stratification —
    // the EMA below integrates it; per-frame decorrelated per froxel).
    // Reconstructed FIRST so the heterogeneous medium can sample density at x.
    uint seed = pcgHash(f.x * 7919u + pcgHash(f.y * 104729u + pcgHash(f.z * 6271u + pc.frame * 26699u)));
    const vec2  uv   = (vec2(f.xy) + vec2(rnd(seed), rnd(seed))) / vec2(float(kFroxelX), float(kFroxelY));
    const float dist = froxelDist(float(f.z) + rnd(seed));
    const vec2  ndc  = vec2(uv.x * 2.0 - 1.0, -(uv.y * 2.0 - 1.0));
    // The froxel's world position and the view ray that reaches it. Under a
    // parallel projection the grid is a BOX rather than a frustum: the column
    // through this tile keeps its lateral offset at every depth, and its ray
    // starts at the tile's own near-plane point instead of the shared eye.
    const vec3  viewPos = camViewPointAtDist(ndc, dist);
    const vec3  x       = (cam.viewInverse * vec4(viewPos, 1.0)).xyz;
    const vec3  camPos  = camRayOrigin(ndc);
    // camera → froxel (the view ray). Taken outright under a parallel
    // projection: the near froxels sit a fraction of a metre from the origin
    // this ray starts at, close enough that normalising the difference is at
    // the mercy of which of the two the ladder puts first.
    const vec3  rd      = (cam.camAux.x > 0.5) ? cam.camAux.yzw : normalize(x - camPos);

    // Medium parameters. HOMOGENEOUS (today): scene fog drives σ/g/albedo,
    // max'd with the explicit beam density; pc.volDensity alone gives clear-air
    // beams (the lighthouse). HETEROGENEOUS (setHeightFog): σ_t is the LOCAL
    // mediumExtinction (height fog + any cloud dipping below 512 m) at x; the
    // albedo/anisotropy fall back to the fog UBO when scene fog is present, else
    // a bright neutral mist.
    const bool  hetero    = clouds.heteroActive > 0.5;
    const bool  fogDriven = fog.enabled > 0.5;
    float sigma     = fogDriven ? max(dot(fog.sigmaT, vec3(1.0 / 3.0)), pc.volDensity)
                                : pc.volDensity;
    float hgG       = fogDriven ? fog.anisotropy : pc.volAniso;
    vec3  medAlbedo = fogDriven ? fog.color : vec3(1.0);
    if (hetero) {
        sigma     = mediumExtinction(x, clouds.timeSec);
        // fog.anisotropy is populated whenever ANY medium exists (it is the
        // medium's HG g, set unconditionally by updateFogUbo) — a heightFog-only
        // medium honours setFogAnisotropy instead of a hardcoded mist g.
        hgG       = fog.anisotropy;
        // DUST WITH NO SCENE FOG (plan §3.3): there is no FogUbo to inherit an
        // albedo or a phase from, so the medium's own DensityRepr supplies
        // both. Exactly the pre-phase-2 path when no density field exists
        // (pd.counts.x == 0) or when scene fog owns the medium.
        if (!fogDriven && pd.counts.x > 0u) {
            medAlbedo = pd.albedoAniso.rgb;
            hgG       = pd.albedoAniso.a;
        }
    }
    if (sigma <= 0.0) {
        imageStore(froxelScatterImage, fi, vec4(0.0));
        return;
    }

    // NO waterSurfaceY cap here: the surface-extinction leg (applySceneFog /
    // fogPathLength) is what the wave surface clips — the volumetric marches
    // this replaces always scattered above the water too (the fjord's aerial
    // sun glow, the mist over the swell). Capping it killed them.

    vec3 sum = vec3(0.0);

    // The directional SUN in-scatter is NO LONGER injected here. It was a froxel
    // term ([0, 512 m]) split against the per-pixel far tail, but the froxel
    // grid's depth cells (~12.6% of distance) cannot resolve a shaft narrower
    // than a cell — close-range tree-gap god rays (0.3–2 m) averaged into a
    // featureless glow the HG phase had nothing to shape. The scale-independent
    // per-pixel march (deferred_shade.comp's volumetricDirScatter) now owns the
    // sun over the WHOLE ray [0, tEnd], so there is exactly ONE sun term and no
    // seam. Froxels keep only the clustered POINT-light glow below.

    // Clustered POINT lights — the volumetricSpotScatter per-step terms
    // (1 m-clamped inverse square, range window, HG phase, light-leg
    // extinction) for every point light in this froxel's cluster cell: the
    // soft omnidirectional fog glow the old spot-only march never gave them.
    // SPOT lights are SKIPPED: a tight bright cone (the lighthouse) is a
    // high-frequency feature this grid fundamentally cannot resolve — spots
    // keep the per-pixel analytic beam march in deferred_shade.comp.
    if (pc.clusterLightCount > 0u) {
        const uint base = clusterCellBase(uv, dist);
        const uint cCnt = min(clusterGrid[base], kClusterMaxPerCell);
        for (uint c = 0u; c < cCnt; ++c) {
            const uint li = min(clusterGrid[base + 1u + c], pc.clusterLightCount - 1u);
            if (clusterLights[li].type > 0.5) continue;// spots: per-pixel beam march
            vec3        toL = clusterLights[li].position - x;
            const float d   = length(toL);
            if (d < 1e-3) continue;
            toL /= d;
            float atten = 1.0 / max(d * d, 1.0);
            const float range = (clusterLights[li].range > 0.0) ? clusterLights[li].range : 200.0;
            const float tr  = d / range;
            const float t4  = tr * tr * tr * tr;
            const float wnd = max(1.0 - t4, 0.0);
            atten *= wnd * wnd;
            const float phase = hgPhase(dot(toL, rd), hgG);
            sum += clusterLights[li].color * (atten * phase * exp(-sigma * d));
        }
    }

    // σ_s = σ_t · albedo — in-scattered radiance per unit length. The camera-
    // leg transmittance is applied by the integrate pass (front-to-back T).
    const vec3 S = sum * medAlbedo * sigma;

    // Temporal EMA against the SAME froxel of the previous frame (no
    // reprojection — froxels are view-anchored). Camera motion shortens the
    // history so beams track the view instead of smearing; a held camera
    // converges the jittered samples into smooth shafts.
    const vec4  prev   = texelFetch(froxelScatterPrevTex, fi, 0);
    const float motion = pc.camRot * 3.0 + pc.camDelta * 0.5;
    const float cap    = mix(16.0, 2.0, smoothstep(0.001, 0.02, motion));
    const bool  valid  = prev.a > 0.5 && prev.a < 4096.0 && all(lessThan(abs(prev.rgb), vec3(1e6)));
    const float hist   = valid ? min(prev.a + 1.0, cap) : 1.0;
    const vec3  acc    = valid ? mix(prev.rgb, S, 1.0 / hist) : S;
    imageStore(froxelScatterImage, fi, vec4(acc, hist));
}
