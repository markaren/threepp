#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : enable
// Format-less image LOADS (finalImg below) — SPIR-V StorageImageReadWithoutFormat.
#extension GL_EXT_shader_image_load_formatted : require

// Source pass for the event-camera path: fills the sensor-resolution
// packed-BGRA8 buffer that event_detect.comp compares frame-to-frame.
// Two sources, selected per dispatch by pc.source:
//
//   SOURCE_SHADED (0) — a fast deterministic proxy. Reads the hybrid raster
//   G-buffer (normal + instanceCustomIndex), looks up the hit's MaterialDesc,
//   and shades it with the scene's directional lights only — no shadows, no
//   bounces, no path tracing. Nothing stochastic reaches the detector, so
//   the 1-2 spp reflections/GI of deferred_shade.comp can never read as
//   events; the cost is that only silhouettes, diffuse texture and emissive
//   surfaces fire.
//     What's modelled:
//       • Lambertian diffuse:  albedo · max(0, N·L) · lightColor, summed
//         over up to 8 directional lights.
//       • Ambient: lights.ambient · albedo.
//       • Emissive: mat.emissive · mat.emissiveIntensity (so glowing
//         surfaces light up the event accumulator when they appear / move).
//       • Metalness damping on the diffuse: metals lose most of their light
//         to the specular lobe we deliberately don't compute here. Better
//         to under-shade chrome than to fake a noisy specular term.
//     What's NOT modelled (intentional, for sim-to-real noise reasons):
//       • Specular highlights, shadows, indirect/GI, transmission, point and
//         spot lights — each would need ray traces or screen-space hacks,
//         i.e. the noisy stochastic branch this source exists to avoid.
//
//   SOURCE_FINAL (1) — the presented frame: the post-TAA / upscaled /
//   tonemapped swapchain image, the same pixels readRGBPixels returns.
//   Everything the picture shows fires (water glitter, backlit cloth,
//   light flashes, shadows sweeping). Box-averaged down to the sensor
//   resolution — a DVS pixel integrates over its photodiode, and
//   point-sampling a 1080p frame to 640×360 would alias fine detail into a
//   shimmer that fires from nothing but the resampler. Inherits the
//   picture's temporal residue (denoiser, auto-exposure drift); TAA has
//   already resolved the raster jitter, so that gate stays open.
//
// The output deliberately matches the swapchain BGRA8 layout so
// event_detect.comp consumes either source without modification.

#include "vulkan_shared.h"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

const uint SOURCE_SHADED = 0u;
const uint SOURCE_FINAL  = 1u;

layout(set = 0, binding = 0) uniform sampler2D  gbufNormal;
layout(set = 0, binding = 1) uniform usampler2D gbufIds;

layout(set = 0, binding = 2, scalar) readonly buffer MatBuf {
    MaterialDesc mats[];
};

struct DirLight {
    vec3 direction;
    vec3 color;
};
// Same layout as the main RT pipeline's LightsUbo — we read only the
// ambient + directional block, but declare the full struct so scalar
// block layout matches byte-for-byte against the host-side upload.
struct PointLight {
    vec3 position;
    float range;
    vec3 color;
    float decay;
    float radius;// physical source radius (soft shadows; layout parity with GpuPointLight)
};
struct SpotLight {
    vec3 position;
    float range;
    vec3 color;
    float decay;
    vec3 direction;
    float cosAngleOuter;
    float cosAngleInner;
    float radius;// physical source radius (soft shadows; layout parity with GpuSpotLight)
};
struct RectLight {
    vec3 position;
    vec3 halfU;
    vec3 halfV;
    vec3 normal;
    vec3 color;
};
layout(set = 0, binding = 3, scalar) uniform LightsUbo {
    vec3       ambient;
    uint       dirCount;
    DirLight   dirLights[8];
    uint       pointCount;
    uint       spotCount;
    uint       rectCount;
    PointLight pointLights[8];
    SpotLight  spotLights[8];
    RectLight  rectLights[4];
} lights;

// Packed BGRA8 output — one uint per pixel, byte 0 = B, byte 1 = G,
// byte 2 = R, byte 3 = 0xFF. Matches the swapchain format event_detect
// already knows how to read.
layout(set = 0, binding = 4, scalar) writeonly buffer LumaBuf {
    uint pixels[];
};

// The acquired swapchain image (GENERAL layout), read by the Final source.
// No format qualifier: the swapchain is VK_FORMAT_B8G8R8A8_UNORM and GLSL
// has no bgra8 qualifier — declaring rgba8 mismatches the bound view
// (Undefined-Value-StorageImage-FormatMismatch-ImageView). Loading without
// a format needs shaderStorageImageReadWithoutFormat (enabled at device
// creation when available; the host falls back to SOURCE_SHADED otherwise,
// so this image is never loaded on a device that lacks it). Channel names
// still map by component, so .r is red regardless of the in-memory order.
// Always bound — harmlessly unused under SOURCE_SHADED.
layout(set = 0, binding = 5) uniform readonly image2D finalImg;

layout(push_constant) uniform Pc {
    uint width;       // sensor (output) extent — drives the dispatch
    uint height;
    uint srcWidth;    // source extent — the gbuf (render extent) for SHADED,
    uint srcHeight;   // the swapchain for FINAL; may exceed the sensor when
                      // the user has set a sub-swapchain sensor resolution
    uint source;      // SOURCE_SHADED / SOURCE_FINAL
} pc;

// Upper bound on the Final source's box-filter taps per axis. 1080p →
// 640×360 is a 3×3 box; a 16×16 sensor on a 4K frame would be 240×135
// taps per pixel, so past 8 per axis the footprint is strided instead of
// walked — still an area sample, just a sparser one.
const uint kMaxBoxTaps = 8u;

vec3 shadeProxy(ivec2 pix) {
    // Map sensor-space pixel → gbuf-space texel (nearest-centre). When
    // srcW/H == sensorW/H this collapses to identity. Nearest sampling
    // for both attachments: ids MUST be NN (usampler can't do LINEAR);
    // normal at < 2× downsample is visually indistinguishable from a
    // bilinear filter for the events output (the detector cares about
    // silhouette stability, not surface gradient).
    const ivec2 srcPix = ivec2(
        int((float(pix.x) + 0.5) * float(pc.srcWidth)  / float(pc.width)),
        int((float(pix.y) + 0.5) * float(pc.srcHeight) / float(pc.height))
    );
    const uvec4 ids = texelFetch(gbufIds, srcPix, 0);
    const uint  instCustomIdx = ids.r;

    vec3 color = vec3(0.0);

    // instCustomIdx is gl_InstanceCustomIndexEXT + 1 (the renderer
    // shifts so 0 means "no surface / sky" in the gbuf).
    if (instCustomIdx > 0u) {
        const uint instId = instCustomIdx - 1u;
        const vec3 normal = normalize(texelFetch(gbufNormal, srcPix, 0).xyz);
        const MaterialDesc mat = mats[instId];

        // Metals route most of their incoming light into the specular
        // lobe; the diffuse contribution is small. Reduces brightness
        // for shiny surfaces while keeping the geometry visible.
        const vec3 albedo = mat.albedo * (1.0 - 0.7 * mat.metalness);

        color = lights.ambient * albedo;
        for (uint i = 0u; i < lights.dirCount; ++i) {
            const float NdotL = max(0.0, dot(normal, lights.dirLights[i].direction));
            color += NdotL * lights.dirLights[i].color * albedo;
        }

        // Emissive surfaces stay bright regardless of light direction —
        // important for catching DVS events from blinking / oscillating
        // emissive features (LEDs, indicator lights, displays).
        color += mat.emissive * max(0.0, mat.emissiveIntensity);
    }
    return color;
}

vec3 sampleFinal(ivec2 pix) {
    // The sensor pixel's footprint on the source image, [x0, x1) × [y0, y1).
    // Integer bounds from the exact ratio, so the footprints of adjacent
    // sensor pixels tile the source with no gap and no overlap; at least one
    // texel each so an upscaled (larger-than-source) sensor still samples.
    const uint x0 = (uint(pix.x) * pc.srcWidth) / pc.width;
    const uint y0 = (uint(pix.y) * pc.srcHeight) / pc.height;
    const uint x1 = max(x0 + 1u, ((uint(pix.x) + 1u) * pc.srcWidth) / pc.width);
    const uint y1 = max(y0 + 1u, ((uint(pix.y) + 1u) * pc.srcHeight) / pc.height);
    const uint fw = x1 - x0;
    const uint fh = y1 - y0;
    const uint sx = max(1u, (fw + kMaxBoxTaps - 1u) / kMaxBoxTaps);
    const uint sy = max(1u, (fh + kMaxBoxTaps - 1u) / kMaxBoxTaps);

    vec3  sum = vec3(0.0);
    float n   = 0.0;
    for (uint y = y0; y < y1; y += sy) {
        for (uint x = x0; x < x1; x += sx) {
            sum += imageLoad(finalImg, ivec2(int(x), int(y))).rgb;
            n   += 1.0;
        }
    }
    return sum / n;
}

void main() {
    const ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= int(pc.width) || pix.y >= int(pc.height)) return;

    const vec3 color = clamp(
            (pc.source == SOURCE_FINAL) ? sampleFinal(pix) : shadeProxy(pix),
            vec3(0.0), vec3(1.0));
    // Round, don't truncate: a 1:1 Final sample is an exact 8-bit value
    // coming back as v/255, and v/255*255 can land one ulp under v.
    const uint r = uint(color.r * 255.0 + 0.5);
    const uint g = uint(color.g * 255.0 + 0.5);
    const uint b = uint(color.b * 255.0 + 0.5);
    pixels[uint(pix.y) * pc.width + uint(pix.x)] =
            b | (g << 8u) | (r << 16u) | (0xFFu << 24u);
}
