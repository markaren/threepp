#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : enable

// Splat stage 6/6 — the tile rasterizer. One 16x16 workgroup per tile, one
// thread per pixel, walking that tile's sorted run FRONT to back.
//
// Front-to-back with a running transmittance is the same integral the GL path
// evaluates back-to-front with fixed-function blending — sum of
// c_i * a_i * prod_{j<i}(1 - a_j) either way — but it buys two things a
// back-to-front blend cannot have: the loop can STOP once transmittance falls
// below a visible threshold, and it can stop at the first splat behind the
// opaque geometry (the run is depth-ordered, so everything after it is behind
// it too). That is the software depth test: test on, write off.
//
// Splats are staged through shared memory a tile-worth at a time. 256 threads
// cooperatively load 256 entries, then every thread walks the same 256 — so the
// per-splat record is read once from global memory per tile instead of once per
// pixel, which is the whole reason this arrangement beats a quad rasterizer.
//
// The alpha/transmittance constants (1/255 floor, 0.99 ceiling) and the
// negated comparisons that make NaN fall on the reject side are lifted from
// the GL fragment shader on purpose: the two backends have to agree on which
// fragments exist before they can be compared on what colour those fragments
// are.

layout(local_size_x = 16, local_size_y = 16) in;

#include "splat_common.glsl"

shared vec2  sCenter[kTilePixels];
shared vec3  sConic[kTilePixels];
shared vec3  sColor[kTilePixels];
shared float sOpacity[kTilePixels];
shared float sDist[kTilePixels];
shared uint  sActive;

// View-space distance from a REVERSED-Z NDC depth. Only the projection
// inverse's z/w rows matter; mirrors viewDepth() in dof_coc.comp, which reads
// the same image with the same matrix.
float viewDepth(float zNdc) {
    const float vz = ubo.projInv[2][2] * zNdc + ubo.projInv[3][2];
    const float vw = ubo.projInv[2][3] * zNdc + ubo.projInv[3][3];
    return -(vz / vw);
}

void main() {
    const uint tileId = gl_WorkGroupID.y * ubo.tilesX + gl_WorkGroupID.x;
    const ivec2 px = ivec2(gl_WorkGroupID.xy * uvec2(kTileW, kTileH) + gl_LocalInvocationID.xy);
    const uint lid = gl_LocalInvocationIndex;

    const bool inside = px.x < int(ubo.viewport.x) && px.y < int(ubo.viewport.y);
    const vec2 pxc = vec2(px) + vec2(0.5);

    // Opaque geometry in front of this pixel, as a view distance. Reverse-Z
    // clears to 0, which linearizes to the far plane — so an empty pixel keeps
    // every splat, which is what a sky-heavy framing needs.
    float geomDist = 3.4e38;
    if ((ubo.flags & kSplatFlagDepthTest) != 0u && inside) {
        geomDist = viewDepth(texelFetch(gbufDepth, px, 0).x);
        if (!(geomDist > 0.0)) geomDist = 3.4e38;
    }

    const uvec2 range = tileRange[tileId];

    float T = 1.0;
    vec3  C = vec3(0.0);
    // Alpha-weighted EXPECTED view distance, premultiplied exactly like C. It
    // costs one multiply-add inside a loop that is already reading viewDist for
    // the depth test, and it is what makes a splat cloud's motion vectors
    // computable at all: the cloud is rigid, so per-pixel motion is pure camera
    // reprojection of a depth — and this is the depth.
    float D = 0.0;
    // MEDIAN view distance: where transmittance crosses 0.5, interpolated
    // between the two splats that straddle the crossing (linear in T, which is
    // the only thing known between two samples). The lerp costs one fused
    // multiply-add ONCE per pixel; the compare that finds the crossing is the
    // per-splat cost, and it is the whole difference between a statistic that
    // tracks a surface and one that quantizes to whichever splat happened to
    // tip the sum. 0 = not crossed; the coverage > 0.5 gate below is exactly
    // the condition that it was.
    float medDist  = 0.0;
    float prevDist = -1.0;// distance of the last contributing splat; < 0 = none
    bool  done = !inside;

    uint i = range.x;
    while (i < range.y) {
        barrier();// the previous batch's LDS reads are finished
        if (lid == 0u) sActive = 0u;

        const uint n = min(kTilePixels, range.y - i);
        if (lid < n) {
            const uint s = valsA[i + lid];
            sCenter[lid]  = proj[s].center;
            sConic[lid]   = proj[s].conic;
            sColor[lid]   = proj[s].color;
            sOpacity[lid] = proj[s].opacity;
            sDist[lid]    = proj[s].viewDist;
        }
        barrier();

        if (!done) {
            for (uint k = 0u; k < n; ++k) {
                // Depth-ordered run: the first splat behind the geometry ends
                // this pixel outright.
                if (sDist[k] > geomDist) { done = true; break; }

                const vec2 d = sCenter[k] - pxc;
                const vec3 cn = sConic[k];
                const float power = -0.5 * (cn.x * d.x * d.x + 2.0 * cn.y * d.x * d.y +
                                            cn.z * d.y * d.y);
                // Negated so NaN — which fails every comparison — is rejected.
                if (!(power <= 0.0)) continue;

                float falloff = exp(power);
                if (ubo.pointMix > 0.0) {
                    // The disc: distance from the centre in sigma units is
                    // sqrt(-2 power), the edge is at 3 sigma, and
                    // (3 - t) * sigma is a one-pixel ramp ending there.
                    const float disc = clamp((3.0 - sqrt(max(0.0, -2.0 * power))) * ubo.pointSigma,
                                             0.0, 1.0);
                    falloff = mix(falloff, disc, ubo.pointMix);
                }
                float alpha = sOpacity[k] * falloff;
                if (!(alpha >= kMinAlpha)) continue;
                alpha = min(kMaxAlpha, alpha);

                C += sColor[k] * (alpha * T);
                D += sDist[k] * (alpha * T);
                const float Tprev = T;
                T *= (1.0 - alpha);
                if (medDist == 0.0 && T < 0.5) {
                    // Tprev >= 0.5 by construction: medDist is set the first
                    // time T dips below, and T only decreases.
                    const float w = (Tprev - 0.5) / max(Tprev - T, 1e-8);
                    medDist = prevDist < 0.0 ? sDist[k] : mix(prevDist, sDist[k], w);
                }
                prevDist = sDist[k];
                if (T < kMinAlpha) { done = true; break; }
            }
        }

        if (!done) atomicAdd(sActive, 1u);
        barrier();
        // Uniform across the workgroup, so breaking here is legal and the tile
        // stops the moment every one of its pixels has saturated.
        if (sActive == 0u) break;
        i += n;
    }

    if (!inside || range.y == range.x || T >= 1.0) return;

    const float coverage = 1.0 - T;
    const float expDist  = D / coverage;// alpha-weighted expected view distance

    // Pre-exposure — the factor the shade already baked into every sceneHdr
    // store, and the single easiest thing in this pass to leave out and never
    // see, because it is 1.0 until a physical camera is configured.
    //
    // EXCEPT on solid-background sky pixels: the shade deliberately skips the
    // pre-exposure there so PostComposite can hand the configured background
    // colour back verbatim. Composing against one of those as if it had been
    // pre-exposed would weight the blend against the wrong background.
    float preExp = ubo.preExposure;
    const uvec4 ids = texelFetch(gbufIds, px, 0);
    if ((ubo.flags & kSplatFlagBgSolid) != 0u && ids.x < 1u) preExp = 1.0;

    // ── the view-space point the cloud is "at", for fog and for motion ──────
    // Both want the same thing and the reconstruction is four lines, so it is
    // done once. The UNJITTERED projection is the one to invert: the pixel grid
    // does not move with the jitter, and the motion vector has to land in the
    // same convention the raster's does (unjittered current, unjittered prev).
    const bool ortho = (ubo.flags & kSplatFlagOrtho) != 0u;
    const vec2 ndc = vec2(((float(px.x) + 0.5) / ubo.viewport.x) * 2.0 - 1.0,
                          1.0 - ((float(px.y) + 0.5) / ubo.viewport.y) * 2.0);
    // proj carries the jitter as a shear on m02/m12; subtract it back out.
    const float p02 = ubo.proj[2][0] - ubo.jitterClip.x;
    const float p12 = ubo.proj[2][1] - ubo.jitterClip.y;
    const vec3 viewPos = ortho
            ? vec3((ndc.x - ubo.proj[3][0]) / ubo.proj[0][0],
                   (ndc.y - ubo.proj[3][1]) / ubo.proj[1][1], -expDist)
            : vec3(expDist * (ndc.x + p02) / ubo.proj[0][0],
                   expDist * (ndc.y + p12) / ubo.proj[1][1], -expDist);

    // ── fog ─────────────────────────────────────────────────────────────────
    // Applied to the CLOUD's own radiance only. The background already carries
    // the fog the shade gave it at ITS depth; fogging the composite would
    // double-count it. Reduces to the identity when there is no medium, so a
    // fog-free frame is bit-unchanged.
    vec3 splatDisp = C / coverage;
    if ((ubo.flags & kSplatFlagFog) != 0u) {
        const vec3 worldPos = (ubo.camWorld * vec4(viewPos, 1.0)).xyz;
        vec3 inScatter;
        const float Tfog = splatFog(ubo.camPosWs.xyz, worldPos, inScatter);
        if (Tfog < 1.0) {
            const vec3 lit = splatSrgbToLinear(splatDisp) * Tfog + inScatter;
            splatDisp = splatLinearToSrgb(max(lit, vec3(0.0)));
        }
    }

    // The whole composite in the splat's own display-referred domain — the one
    // its coefficients were fitted in (see splat_common.glsl). The background
    // arrives through the same transfer function the display would put it
    // through and leaves through its exact inverse, so a pixel with T == 1 is
    // untouched (returned above) and one with T == 0 is exactly the splat
    // colour.
    const vec4 dst = imageLoad(sceneHdr, px);
    const vec3 dstDisp = splatLinearToSrgb(dst.rgb / preExp);
    const vec3 outRgb  = splatSrgbToLinear(dstDisp * T + splatDisp * coverage) * preExp;
    imageStore(sceneHdr, px, vec4(outRgb, dst.a));

    // ── motion vectors + reactivity ─────────────────────────────────────────
    // A splat cloud is RIGID, so its per-pixel motion is pure camera
    // reprojection of the expected depth — exactly computable, and free from
    // the accumulation loop. Without it TAA reprojects a splat pixel from
    // whatever the raster left there: the geometry BEHIND the cloud, or (over
    // sky) the far-plane reconstruction, and either one smears the cloud
    // whenever the camera moves.
    //
    // Only where the cloud actually owns the pixel. Below that the background's
    // own motion is the better answer for the majority of what is there, and a
    // thin translucent fringe reprojected by its own average depth is how you
    // get a halo that swims against the geometry it sits on.
    if ((ubo.flags & kSplatFlagMotion) != 0u && !ortho && coverage > 0.5) {
        const vec4 prevClip = ubo.prevVPfromView * vec4(viewPos, 1.0);
        if (abs(prevClip.w) > 1e-6) {
            const vec2 prevNdc = prevClip.xy / prevClip.w;
            const vec4 m = imageLoad(gbufMotion, px);
            imageStore(gbufMotion, px, vec4(prevNdc - ndc, m.z, m.w));
        }
    }

    // ── depth AOV ───────────────────────────────────────────────────────────
    // expDist, exported — or medDist under kSplatFlagDepthMed. The accumulation
    // loop computes the first either way (the motion vectors above cannot exist
    // without it), so the AOV costs one guarded read-modify-write per covered
    // pixel and nothing anywhere else.
    // It is what a consumer OUTSIDE the renderer needs, because a splat cloud
    // is in no BLAS: every ray-traced consumer — picking, lidar, the RT
    // sensors — misses the cloud entirely, and this image is the only place
    // the frame records that something was there.
    //
    // Units are view-space distance in world units, positive, NOT reversed-Z
    // NDC: the consumers unproject it or compare it against a metric range,
    // and neither wants to invert a projection to do so.
    //
    // The same coverage > 0.5 gate the motion write uses, for the same reason
    // spelled out above it — below half coverage the geometry BEHIND the
    // fringe is the better answer, and a translucent halo reported as a
    // surface is a worse lie than no surface at all. So 0 means "no cloud
    // owns this pixel", which is the whole reason the image is cleared at the
    // top of every frame the AOV is enabled.
    //
    // NEAREST WINS. record() dispatches one raster per cloud with a barrier
    // between them and one thread per pixel within a dispatch, so this
    // read-modify-write races nothing; without the comparison the LAST cloud
    // submitted would own every pixel two clouds share, which is submission
    // order — not geometry — deciding what the sensor sees.
    //
    // MEDIAN is the same image and the same rules, one statistic further
    // forward: the expected value sits behind the visible front of a cloud by
    // roughly its own thickness along the ray, which localizes a wall and
    // misplaces a surface. Depth fusion wants the surface
    // (plans/splat-surface-bake.md).
    if ((ubo.flags & kSplatFlagDepthAov) != 0u && coverage > 0.5) {
        // coverage > 0.5 IS T < 0.5, so the crossing happened and medDist is
        // set — the gate and the median's existence are the same condition.
        const float aovDist = (ubo.flags & kSplatFlagDepthMed) != 0u ? medDist : expDist;
        const float prev = imageLoad(splatDepth, px).x;
        if (!(prev > 0.0) || aovDist < prev) {
            imageStore(splatDepth, px, vec4(aovDist));
        }
    }

    if ((ubo.flags & kSplatFlagChecksum) != 0u) {
        // Order-independent hash of the composited result: uint addition is
        // commutative and associative, so the sum is the same however the
        // workgroups interleave. Quantized to 2^-12 so it is a determinism
        // gate, not a last-bit fp16 lottery.
        const uvec3 q = uvec3(clamp(outRgb, vec3(0.0), vec3(64.0)) * 4096.0);
        const uint h = (q.x * 0x9E3779B9u) ^ (q.y * 0x85EBCA6Bu) ^ (q.z * 0xC2B2AE35u) ^
                       (uint(px.y * 8191 + px.x) * 0x27D4EB2Du);
        atomicAdd(g.hashColor, h);
    }
}
