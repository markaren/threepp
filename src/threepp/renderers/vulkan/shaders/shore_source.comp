#version 460
#extension GL_GOOGLE_include_directive                   : enable
#extension GL_EXT_scalar_block_layout                    : require
#extension GL_EXT_buffer_reference                       : require
#extension GL_EXT_buffer_reference2                      : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "ocean_cascade.glsl"    // oceanC1Domain / oceanC1World, sampleBicubicRG
#include "ocean_shore_depth.glsl"// the depth, the sea's statistics, the cascades' gains over the bed

// THE SHORE'S FOAM: what the sea lays where it meets something solid, fed into
// one of the shore's windows of the wake field (WakeFieldPipeline, the shore
// layers) after the field's own step has carried, spread and aged what was
// there (wake_field.comp). One thread a texel of the window.
//
// The field lies on the water's REST coordinates (the shade reads it at a
// pixel's rest point), so a texel is a parcel of water: rest point q, drawn at
// x = q + D(q, t) with height eta(q, t), from the ocean's own cascades (the
// displace set, bound as set 0). Its velocity is how those moved since the last
// step: u = dD/dt over the water, w = d eta/dt up, of the INCOMING sea (the
// cascades before the depth's gains: over a shelf the drawn sea is calmed
// because its waves broke, and the water they broke into still drives into the
// rock behind it). Where x (drawn, the gains taken) lies within a
// splash's reach of the solid (the shore map, shore_jfa.comp), the parcel
// drives into it at
//
//     impact = max(u . n, 0) + 0.5 max(w, 0)     (n toward the solid)
//
// and the surge breaks on the solid and falls back white: foam and air in
// proportion to the impact past kImpact0 (full at kImpact1), over a reach that
// widens with the impact (kReach0 + kReachGain impact), thrown back off the
// solid at half the impact. So the collar comes with each wave that runs into
// a pile or a wall, grows with the sea, and is nothing on a calm one (a sea of
// ripples drives at millimetres a second). The field then carries what was laid
// with its own flow (the throw, relaxing to the wind's drift of the foam,
// kDrift of the wind: Wu 1975 measured the wind drift at about 3 %), stirs it
// with a little turbulence into lace and ages it as it ages a wake's foam.
//
// THE SURF. The drawn sea over shallow water is scaled by its depth
// (ocean_shore_depth.glsl), its tallest waves held at the breaking limit: what
// the limit takes out of the waves is what breaks. So the breaking is read off
// the INCOMING wave, the cascades before the depth's gains: where a parcel's
// incoming crest stands past the limit at its depth (its height eta against
// kCrestShare d, a crest's share of McCowan's 0.78 d) and is still rising or at
// its top, the crest breaks: foam and air laid in proportion to how far past
// kBreak0 it stands, so the white comes with each set over a shoal, grows with
// the sea, and is nothing on a calm one (kSea0: a sea of ripples breaks
// nowhere, however shallow the water). Broken water then runs toward
// the shore as a bore does, at kBore sqrt(g d) (the speed of a shallow-water
// bore, Stoker 1957) inside the surf zone, slowing as the depth falls, along the flood's direction
// to the nearest solid (the shore map's), or with the waves (the wind) out
// over a shoal far from any; and in the last decimetres of a beach it runs up
// and back with the waterline, which moves at w / tan(beta) (the surface's rise
// over the bed's slope), so the foam it leaves slides up the slope and back and
// fades as the field ages it; where it runs into a solid it drives into it as
// the drawn water does (the collar). The field carries it all: the flow is set, the
// foam is moved by it (wake_field.comp), never slid as a picture.
//
// MODE 1, the sea's statistics (one workgroup, before the windows' sources):
// each cascade's drawn significant height 4 sigma from its height field and
// its rms wavenumber from the divergence of its horizontal displacement (for
// a linear sea D is the Riesz transform of the height, div D = -|k| h mode by
// mode), sampled on a 64 x 64 lattice of its texels, into the depth buffer for
// every reader of the gains (the geometry, the shade, mode 0 here).

layout(local_size_x = 8, local_size_y = 8) in;

// The ocean's displace set (WaterDisplacePipeline's layout, the plain set):
// its cascades at bindings 0-5. (10 and 11 are its ripples and its climate,
// not read here.)
layout(set = 0, binding = 0) uniform sampler2D height0;
layout(set = 0, binding = 1) uniform sampler2D displace0;
layout(set = 0, binding = 2) uniform sampler2D height1;
layout(set = 0, binding = 3) uniform sampler2D displace1;
layout(set = 0, binding = 4) uniform sampler2D height2;
layout(set = 0, binding = 5) uniform sampler2D displace2;

// The shore map (distance m, direction to the solid, bed), a layer a window.
layout(set = 1, binding = 0) uniform sampler2DArray shoreMap;
// The field as its step left it: written back with this step's foam.
layout(set = 1, binding = 1, rgba16f) uniform image2DArray fieldState;
layout(set = 1, binding = 2, rg16f)   uniform image2DArray fieldVel;
// Each parcel's (eta, D) at the last step, a layer a window; .a 1 once written.
layout(set = 1, binding = 3, rgba16f) uniform image2DArray lastSurface;

// 96 bytes, mirrored by WakeFieldPipeline::ShoreSourcePush.
layout(push_constant, scalar) uniform Pc {
    float tileSize0;
    float tileSize1;
    float tileSize2;
    float waveScale;
    float choppiness;
    uint  cascadeMask;
    float originX;    // the window's world min corner (= its field patch's)
    float originZ;
    float texel;
    uint  res;
    uint  layer;      // the field's layer
    uint  shoreLayer; // the map's and lastSurface's layer
    float dt;
    uint  history;    // 1 = lastSurface holds this window's parcels at the last step
    float driftX;     // the wind's drift of floating foam (m/s, world)
    float driftZ;
    float keepX;      // no foam is laid inside this square (the near window's inside, for the far one)
    float keepZ;
    float keepHalf;   // 0 = none
    float timeSec;
    float gain;       // the deposit's scale: 1, less where a texel is wider than a collar
    uint  mode;       // 0 a window's foam, 1 the sea's statistics
    uint64_t depthAddr;// OceanShoreDepth (the depth, the sea's statistics)
} pc;

// LOOK and calibration constants (2026-11-18, third round). A fetch-limited
// fjord sea drives at peaks of about 0.3 m/s at 5 m/s of wind, 0.5 at 10 and
// 0.7 at 15, a light air's ripples at a few centimetres a second: the ramp
// is linear over that span (a smoothstep's slow start left 5 m/s bare).
const float kImpact0   = 0.02;// m/s: a sea that drives slower lays nothing
const float kImpact1   = 0.7; // m/s: full foam
const float kReach0    = 0.3; // m: the splash's reach off the solid
const float kReachGain = 1.0; // s: ... and how it widens with the impact (m per m/s)
const float kAir       = 0.2; // the air a surge takes down, a share of its foam: the pale water under a collar
const float kThrow     = 0.5; // the throw off the solid, a share of the impact
const float kDriftTau  = 1.5; // s: foam takes the wind's drift over this
// The furthest a deposit is ever laid from the solid, with the waves' own
// horizontal travel: texels further off do nothing at all.
const float kBand      = 6.0; // m

// THE SURF's constants (2026-11-18, first round).
const float kCrestShare = 0.39;// a crest at the breaking limit stands this times the depth (half of 0.78)
const float kBreak0    = 0.60; // eta / (kCrestShare d): the crest starts to break here ...
const float kBreak1    = 0.95; // ... and is fully broken here
const float kSea0      = 0.08; // m: a sea whose significant height (in deep water) is under this breaks nowhere ...
const float kSea1      = 0.30; // m: ... and one this high breaks wherever the depth makes it
const float kCrestMin  = 0.01; // m: a crest lower than this lays nothing however shallow the water
const float kBreakFoam = 0.7;  // the film a fully broken crest lays at most (torn: a quarter of it at the least)
const float kBreakAir  = 0.16; // ... the air it takes down (the pale water of a broken band)
const float kBreakTurb = 0.3;  // m/s: ... and the churn, whose eddies strain what it laid into streaks (wake_field.comp)
const float kSurfDepth = 6.0;  // m: deeper texels make no surf (a 15 m/s fjord sea breaks from 3 m)
const float kBore      = 0.8;  // broken water runs in at this share of sqrt(g d)
const float kRunTau    = 0.6;  // s: the field's flow takes the bore's over this
const float kSwash0    = 0.10; // m: the swash's flow is the waterline's below this depth ...
const float kSwash1    = 0.45; // m: ... and the bore's above this
const float kSwashMax  = 1.5;  // m/s: the fastest the waterline is taken to run

float sHash(ivec3 p) {
    uint h = uint(p.x) * 0x8da6b343u ^ uint(p.y) * 0xd8163841u ^ uint(p.z) * 0xcb1ab31fu;
    h ^= h >> 15; h *= 0x2c1b3c6du;
    h ^= h >> 12; h *= 0x297a2d39u;
    h ^= h >> 15;
    return float(h) * (1.0 / 4294967296.0);
}
// Value noise over (x, y, time) in 0..1, quintic fade.
float sNoise(vec3 p) {
    const ivec3 i = ivec3(floor(p));
    const vec3  f = p - vec3(i);
    const vec3  u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    const float a = mix(mix(mix(sHash(i), sHash(i + ivec3(1, 0, 0)), u.x),
                            mix(sHash(i + ivec3(0, 1, 0)), sHash(i + ivec3(1, 1, 0)), u.x), u.y),
                        mix(mix(sHash(i + ivec3(0, 0, 1)), sHash(i + ivec3(1, 0, 1)), u.x),
                            mix(sHash(i + ivec3(0, 1, 1)), sHash(i + ivec3(1, 1, 1)), u.x), u.y), u.z);
    return a;
}

float sampleBicubicR1(sampler2D tex, vec2 uv) { return sampleBicubicRG(tex, uv).r; }

// The drawn surface's (D.x, eta, D.z) at rest point q: water_displace.comp's
// sampleDisplacement without its per-vertex mip levels (the window's texels are
// finer than any spacing those serve).
// Each cascade scaled by its gain over the bed g (as water_displace.comp
// scales it); `incoming` is the same surface with every gain 1: the waves as
// they come in from deep water, before the depth has taken anything from them.
vec3 surfaceAt(vec2 q, vec3 g, out vec3 incoming) {
    vec3 c0 = vec3(0.0), c1 = vec3(0.0), c2 = vec3(0.0);
    if ((pc.cascadeMask & 1u) != 0u) {
        const float inv = 1.0 / pc.tileSize0;
        const vec2  uv  = q * inv;
        c0.y = sampleBicubicR1(height0, uv) * inv;
        c0.xz = sampleBicubicRG(displace0, uv) * inv;
    }
    if ((pc.cascadeMask & 2u) != 0u) {
        const float inv = 1.0 / pc.tileSize1;
        const vec2  uv  = oceanC1Domain(q) * inv;
        c1.y = sampleBicubicR1(height1, uv) * inv;
        c1.xz = oceanC1World(sampleBicubicRG(displace1, uv)) * inv;
    }
    if ((pc.cascadeMask & 4u) != 0u) {
        const float inv = 1.0 / pc.tileSize2;
        const vec2  uv  = q * inv;
        c2.y = textureLod(height2, uv, 0.0).r * inv;
        c2.xz = textureLod(displace2, uv, 0.0).rg * inv;
    }
    const vec3 k = vec3(pc.choppiness, pc.waveScale, pc.choppiness);
    incoming = (c0 + c1 + c2) * k;
    return (g.x * c0 + g.y * c1 + g.z * c2) * k;
}

// ── MODE 1: the sea's statistics ──────────────────────────────────────────
shared vec3 sStat[64][3];// per thread, per cascade: (sum h, sum h^2, sum (div D)^2)

// One cascade's sums over this thread's share of a 64 x 64 lattice of its
// texels (h and D in metres, at waveScale and choppiness 1).
vec3 cascadeSums(sampler2D h, sampler2D dsp, float tile, uint t) {
    const ivec2 sz  = textureSize(h, 0);
    const float inv = 1.0 / tile;
    const float dx  = tile / float(sz.x);// m a texel
    vec3 acc = vec3(0.0);
    for (uint s = t; s < 4096u; s += 64u) {
        const ivec2 p  = ivec2(int(s & 63u) * sz.x / 64, int(s >> 6u) * sz.y / 64);
        const float e  = texelFetch(h, p, 0).r * inv;
        const ivec2 xp = ivec2((p.x + 1) % sz.x, p.y), xm = ivec2((p.x + sz.x - 1) % sz.x, p.y);
        const ivec2 zp = ivec2(p.x, (p.y + 1) % sz.y), zm = ivec2(p.x, (p.y + sz.y - 1) % sz.y);
        const float dv = (texelFetch(dsp, xp, 0).r - texelFetch(dsp, xm, 0).r +
                          texelFetch(dsp, zp, 0).g - texelFetch(dsp, zm, 0).g) * inv / (2.0 * dx);
        acc += vec3(e, e * e, dv * dv);
    }
    return acc;
}

void seaStatistics() {
    const uint t = gl_LocalInvocationIndex;
    sStat[t][0] = (pc.cascadeMask & 1u) != 0u ? cascadeSums(height0, displace0, pc.tileSize0, t) : vec3(0.0);
    sStat[t][1] = (pc.cascadeMask & 2u) != 0u ? cascadeSums(height1, displace1, pc.tileSize1, t) : vec3(0.0);
    sStat[t][2] = (pc.cascadeMask & 4u) != 0u ? cascadeSums(height2, displace2, pc.tileSize2, t) : vec3(0.0);
    barrier();
    if (t != 0u) return;
    vec4 hs = vec4(0.0), km = vec4(0.0);
    for (int c = 0; c < 3; ++c) {
        vec3 a = vec3(0.0);
        for (int k = 0; k < 64; ++k) a += sStat[k][c];
        a *= 1.0 / 4096.0;
        const float var = max(a.y - a.x * a.x, 0.0);
        hs[c] = 4.0 * sqrt(var) * pc.waveScale;
        km[c] = var > 1e-12 ? sqrt(a.z / var) : 0.0;
    }
    hs.w = length(hs.xyz);
    OceanShoreDepth b = OceanShoreDepth(pc.depthAddr);
    b.hs = hs;
    b.km = km;
}

void main() {
    if (pc.mode == 1u) {
        seaStatistics();
        return;
    }
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    const int   res = int(pc.res);
    if (px.x >= res || px.y >= res) return;
    const float sl = float(pc.shoreLayer);

    // The water's depth at this texel (0 on land; the window's own lattice).
    OceanShoreDepth sd = OceanShoreDepth(pc.depthAddr);
    const uint  di    = (pc.shoreLayer * pc.res + uint(px.y)) * pc.res + uint(px.x);
    const float depth = sd.res == pc.res ? sd.depth[di] : 1.0e3;
    const bool  surf  = depth > 0.0 && depth < kSurfDepth;

    // Open water: nothing to do (the band is the splash's reach and the waves'
    // own travel, plus a texel either way), unless it is shallow enough to break.
    const vec4 map0 = texelFetch(shoreMap, ivec3(px, int(pc.shoreLayer)), 0);
    if (map0.r > kBand + 2.0 * pc.texel && !surf) return;

    // The drawn surface (the gains over the bed taken) and the incoming one
    // (the waves before the depth took anything): the parcel is DRAWN where
    // the first puts it, but what drives into a solid and what breaks is the
    // incoming wave, whose energy the depth's limit takes out of the drawn
    // sea by breaking it. Kept from step to step is the incoming surface.
    const vec2  q   = vec2(pc.originX, pc.originZ) + (vec2(px) + 0.5) * pc.texel;
    const vec3  g   = oceanShoreGain(pc.depthAddr, q);
    vec3        s0;
    const vec3  s3  = surfaceAt(q, g, s0);
    const vec2  D   = s3.xz;
    const float eta = s0.y;// the incoming crest
    const ivec3 dstL = ivec3(px, int(pc.shoreLayer));
    const vec4  last = imageLoad(lastSurface, dstL);
    imageStore(lastSurface, dstL, vec4(s0.y, s0.xz, 1.0));
    if (pc.history == 0u || last.a < 0.5 || pc.dt <= 0.0) return;

    const vec2  u = (s0.xz - last.gb) / pc.dt;// the incoming parcel's horizontal speed
    const float w = (s0.y - last.r) / pc.dt;  // ... and its rise
    // The drawn sea's significant height over the incoming one's, here: the
    // waterline moves with the drawn water (the swash below).
    const vec4  hs4 = sd.hs;
    const float hh  = dot(hs4.xyz, hs4.xyz);
    const float gH  = hh > 1e-8 ? sqrt(dot(g * g, hs4.xyz * hs4.xyz) / hh) : 1.0;

    // Where it is drawn, and the solid from there (outside the window: none).
    const vec2 x  = q + D;
    const vec2 uv = (x - vec2(pc.originX, pc.originZ)) / (pc.texel * float(res));
    float dist = 1.0e4;
    vec2  n    = vec2(0.0);
    if (all(greaterThan(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0)))) {
        const vec4 m = textureLod(shoreMap, vec3(uv, sl), 0.0);
        dist = m.r;
        const float nl = length(m.gb);
        n = nl > 1e-3 ? m.gb / nl : vec2(0.0);
    }

    const ivec3 dst = ivec3(px, int(pc.layer));
    vec4 s = imageLoad(fieldState, dst);
    vec2 v = imageLoad(fieldVel, dst).rg;
    const vec2 drift = vec2(pc.driftX, pc.driftZ);

    // The drive into the solid: the drawn water's (stage 1's collar), or,
    // where broken water has run in over shallow water, the bore's: the
    // field's own flow toward the solid where it carries air (a wave that
    // broke on the shelf before a rock still runs into the rock, though the
    // drawn surface there is calm).
    const float bore   = surf ? max(dot(v, n), 0.0) * clamp(s.g / 0.1, 0.0, 1.0) : 0.0;
    const float impact = max(max(dot(u, n), 0.0) + 0.5 * max(w, 0.0), bore);
    const float reach  = kReach0 + kReachGain * min(impact, 1.0);
    const bool  kept   = pc.keepHalf > 0.0 && all(lessThan(abs(q - vec2(pc.keepX, pc.keepZ)), vec2(pc.keepHalf)));
    // The distance is to the nearest solid texel's centre; the solid's face
    // lies about half a texel nearer (a far window's 2 m texels would
    // otherwise lay its whole collar on the land side of the line).
    // A collar narrower than a texel is held by the texels next to the face:
    // in a coarse window the reach is at least most of a texel (pc.gain
    // scales the film).
    const float d      = max(dist - 0.5 * pc.texel, 0.0);
    const float r      = max(reach, 0.75 * pc.texel);
    const float dep    = kept ? 0.0
                              : pc.gain * clamp((impact - kImpact0) / (kImpact1 - kImpact0), 0.0, 1.0) *
                                    exp(-(d * d) / (r * r));
    // The surf: the incoming crest against the breaking limit at this
    // texel's depth, rising or at its top (not its back), in a sea that is
    // more than ripples. The further past the limit the incoming crest
    // stands (the more of it the depth takes), the more of it breaks, at
    // each crest that passes.
    float brk = 0.0;
    if (surf && !kept) {
        const float b = eta / (kCrestShare * depth);
        brk = smoothstep(kBreak0, kBreak1, b) * smoothstep(kSea0, kSea1, sd.hs.w) *
              smoothstep(kCrestMin, 2.0 * kCrestMin, eta) * smoothstep(-0.05, 0.05, w);
    }

    if (dep > 1e-3) {
        // A surge does not break as a ribbon: in gulps along the solid,
        // quick in time (two noises over half a metre and over two, never
        // finer than the window's texel).
        const float g1   = sNoise(vec3(x / max(0.5, pc.texel) + 7.1, 1.9 * pc.timeSec));
        const float g2   = sNoise(vec3(x / max(2.0, 2.0 * pc.texel) - 3.3, 0.7 * pc.timeSec + 4.0));
        const float gulp = 0.6 * g1 + 0.4 * g2;
        s.r = max(s.r, 0.85 * dep * smoothstep(0.25, 0.65, gulp));
        s.g = max(s.g, kAir * dep);
        s.b = max(s.b, 0.05 * dep);
        v   = mix(v, drift - n * (kThrow * impact), min(2.0 * dep, 1.0));
    } else if (surf && (brk > 1e-3 || s.r > 0.01 || s.g > 0.01)) {
        if (brk > 1e-3) {
            // A breaking crest is torn as it goes: its white is uneven along
            // the crest (one noise over a few metres, never finer than two
            // texels), and the air it takes down reaches further than its
            // white (brk^0.5):
            // a broken patch is white over pale green water with a torn,
            // see-through rim, and what it leaves behind thins into lace as
            // the field carries and ages it.
            const float tear = sNoise(vec3(q / max(1.5, 2.0 * pc.texel) + 2.3, 0.9 * pc.timeSec + 1.7));
            s.r = max(s.r, kBreakFoam * pc.gain * brk * mix(0.25, 1.0, tear));
            s.g = max(s.g, kBreakAir * sqrt(brk));
            s.b = max(s.b, kBreakTurb * brk);
        }
        // The run-in: along the flood's direction to the nearest solid where
        // there is one within the flood's reach (64 texels), with the waves
        // (the wind's way) further out over a shoal.
        const float n0l  = length(map0.gb);
        const vec2  n0   = n0l > 1e-3 ? map0.gb / n0l : vec2(0.0);
        const float wl   = length(drift);
        const vec2  wind = wl > 1e-4 ? drift / wl : vec2(0.0);
        const float near = n0l > 1e-3 ? 1.0 - smoothstep(30.0 * pc.texel, 60.0 * pc.texel, map0.r) : 0.0;
        vec2 dir = near * n0 + (1.0 - near) * wind;
        const float dl = length(dir);
        dir = dl > 0.1 ? dir / dl : wind;
        // A bore runs only in the surf zone, where the depth holds the waves
        // down (the drawn sea under the incoming one) or a crest is breaking
        // now; broken water carried out of it drifts with the wind, so a
        // patch that broke over a shoal leaves a trail behind it.
        const float zone = max(smoothstep(0.02, 0.25, 1.0 - gH), brk);
        vec2 vt = drift + dir * (zone * kBore * sqrt(9.81 * depth));
        // The swash: in the last decimetres the waterline's own motion, up
        // the slope while the water rises and back while it falls. The bed's
        // slope from the depth either side (a texel's tent-smoothed depth).
        if (depth < kSwash1 && n0l > 1e-3) {
            const int   i0 = max(px.x - 1, 0), i1 = min(px.x + 1, res - 1);
            const int   j0 = max(px.y - 1, 0), j1 = min(px.y + 1, res - 1);
            const uint  row = pc.shoreLayer * pc.res;
            const float gx = (sd.depth[(row + uint(px.y)) * pc.res + uint(i1)] -
                              sd.depth[(row + uint(px.y)) * pc.res + uint(i0)]) / (float(i1 - i0) * pc.texel);
            const float gz = (sd.depth[(row + uint(j1)) * pc.res + uint(px.x)] -
                              sd.depth[(row + uint(j0)) * pc.res + uint(px.x)]) / (float(j1 - j0) * pc.texel);
            const float slope = max(length(vec2(gx, gz)), 0.05);
            const vec2  vs    = n0 * clamp(gH * w / slope, -kSwashMax, kSwashMax);
            vt = mix(vs, vt, smoothstep(kSwash0, kSwash1, depth));
        }
        v = mix(v, vt, 1.0 - exp(-pc.dt / kRunTau));
    } else if (s.r > 0.01 || s.g > 0.01) {
        v = mix(v, drift, 1.0 - exp(-pc.dt / kDriftTau));
    }
    imageStore(fieldState, dst, s);
    imageStore(fieldVel, dst, vec4(v, 0.0, 0.0));
}
