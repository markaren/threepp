#version 460

// HiZ depth pyramid — one dispatch per mip (HiZPyramid::record).
//
// Mip 0 copies the resolved reverse-Z G-buffer depth into R32F; every
// further mip is a CONSERVATIVE 2×2 MIN reduce (per-cell FARTHEST surface):
// what the occlusion-culling test needs ("is the whole scene in this region
// provably closer than the box?"). The safe direction: a cell value BELOW
// the true farthest only draws boxes that were actually hidden; one ABOVE
// would cull visible geometry into holes.
//
// The reduce folds odd-dimension leftovers (NPOT mips: floor-halving
// orphans the last row/column) into the edge cells rather than dropping
// them, and clamps reads instead of wrapping — over-conservative, never
// wrong-sided.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D srcDepth;              // reverse-Z depth (fromDepth, 1×)
layout(set = 0, binding = 1, r32f) uniform readonly  image2D srcMip;  // HiZ mip i-1 (reduce pass)
layout(set = 0, binding = 2, r32f) uniform writeonly image2D dstMip;  // HiZ mip i
// MSAA source (occlusion culling under setGbufferMsaa: the resolved depth
// doesn't exist mid-frame, so mip 0 reduces the raw MS attachment's samples
// directly — same conservatism rules per sample). A 1×1 dummy when unused.
layout(set = 0, binding = 3) uniform sampler2DMS srcDepthMS;

layout(push_constant) uniform Pc {
    ivec2 dstSize;
    ivec2 srcSize;
    uint  fromDepth;// 1 = mip-0 copy from the depth buffer, 0 = 2×2 reduce
    uint  msSamples;// >1 = mip 0 reads srcDepthMS, reducing across samples
} pc;

float reduceOp(float a, float b) {
    return min(a, b);
}

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.dstSize.x || p.y >= pc.dstSize.y) return;

    if (pc.fromDepth == 1u) {
        const ivec2 sp = min(p, pc.srcSize - 1);
        if (pc.msSamples > 1u) {
            float m = texelFetch(srcDepthMS, sp, 0).x;
            for (int s = 1; s < int(pc.msSamples); ++s)
                m = reduceOp(m, texelFetch(srcDepthMS, sp, s).x);
            imageStore(dstMip, p, vec4(m));
        } else {
            imageStore(dstMip, p, vec4(texelFetch(srcDepth, sp, 0).x));
        }
        return;
    }

    const ivec2 b  = p * 2;
    const ivec2 mx = pc.srcSize - 1;
    float m = imageLoad(srcMip, min(b, mx)).x;
    m = reduceOp(m, imageLoad(srcMip, min(b + ivec2(1, 0), mx)).x);
    m = reduceOp(m, imageLoad(srcMip, min(b + ivec2(0, 1), mx)).x);
    m = reduceOp(m, imageLoad(srcMip, min(b + ivec2(1, 1), mx)).x);
    // Odd source dims: fold the orphaned last column/row into every cell that
    // could touch it (clamped loads make the extra taps duplicates elsewhere —
    // pure over-conservatism, never wrong-sided).
    if ((pc.srcSize.x & 1) != 0) {
        m = reduceOp(m, imageLoad(srcMip, min(b + ivec2(2, 0), mx)).x);
        m = reduceOp(m, imageLoad(srcMip, min(b + ivec2(2, 1), mx)).x);
    }
    if ((pc.srcSize.y & 1) != 0) {
        m = reduceOp(m, imageLoad(srcMip, min(b + ivec2(0, 2), mx)).x);
        m = reduceOp(m, imageLoad(srcMip, min(b + ivec2(1, 2), mx)).x);
        if ((pc.srcSize.x & 1) != 0)
            m = reduceOp(m, imageLoad(srcMip, min(b + ivec2(2, 2), mx)).x);
    }
    imageStore(dstMip, p, vec4(m));
}
