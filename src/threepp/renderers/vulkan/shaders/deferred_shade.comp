#version 460
#extension GL_EXT_scalar_block_layout : require
#ifndef THREEPP_NO_RAY_QUERY
#extension GL_EXT_ray_query : require
#endif
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive : enable
// Divergent bindless indexing: albedoMaps[] indices come from per-hit / per-ray
// material data, so neighbouring invocations index DIFFERENT descriptors.
// Without nonuniformEXT that is spec-UB — the compiler may assume the index is
// wave-uniform and hoist ONE descriptor load for the whole wave, so whichever
// lane "wins" defines every lane's texture (and the winner shifts with the TAA
// jitter's wave composition → per-frame texture flicker that scales with
// material diversity). Requires shaderSampledImageArrayNonUniformIndexing.
#extension GL_EXT_nonuniform_qualifier : require
// Subgroup vote: spatial dilation of the moving-occluder shadow flag
// (analyticDirectSplit) — the outer penumbra's 1-2 ray economy rarely hits the
// mover itself, so without the vote those pixels keep their long stale history
// and trail the swept shadow as a faint ghost ring.
#extension GL_KHR_shader_subgroup_vote : require

// Raster-first deferred shading. Shades the material G-buffer
// from the raster prepass into a clean, analytic base + adds ray-traced
// accents, writing linear HDR straight into the bloom sceneHdr image:
//   • direct analytic lights (dir/point/spot) with ray-query HARD shadows,
//   • emissive (flat material emissive × intensity),
//   • split-sum specular: ray-query REFLECTIONS on near-mirror surfaces
//     (reflected hits are fully shaded — lit + shadowed), prefiltered-env IBL
//     on rough surfaces,
//   • approximate diffuse IBL.
//
// Geometry fetch for the reflection hit uses a GeometryDesc (buffer-reference
// vertex/normal/index buffers + barycentric interpolation) mirroring
// GeometryDesc (VulkanGeometryState.hpp).

layout(local_size_x = 8, local_size_y = 8) in;

#include "deferred_shade_00_common.glsl"

void main() {
#include "deferred_shade_05_prologue_pixel.glsl"

    if (id == 0u) {
        // Dispatch B never shades sky (a sky sample can't be the "largest
        // non-dominant cluster" of a real surface pixel in practice, but
        // guard anyway — sky has no lit contribution to accumulate).
        if (pc.shadeMode == 1u) return;
        const vec3 dirWS = gPrimaryDir;
        // Sky pixels march the beams too — a lighthouse beam against the night
        // sky is exactly where the volumetric is most visible.
        // COVERAGE-WEIGHTED at MSAA complex pixels: a sky-DOMINANT edge pixel
        // reserves geoMinW for dispatch B exactly like the geometry path does.
        // Storing the sky at full weight here let B add the geometry minority
        // ON TOP (energy = 1 + geoMinW) — a bright rim hugging the sky side of
        // every silhouette, glowing hardest where the sky/haze is bright.
        // Sky radiance, then composite the volumetric cloud layer over it
        // (clouds sit in front of the infinite sky background). Physical
        // radiance shares the sky's value domain, so the skyPe scale below
        // carries the clouds too — consistent under the solid-bg bypass.
        // SUBMERGED: an env miss is not the sky, it is the unbounded water
        // column — applyMurkSky's infinite-murk limit replaces the whole sky
        // dispatch (aerial perspective and stars included; both belong to an
        // atmosphere this ray never reaches). Exact no-op above water or with
        // no murk medium bound.
        vec3 skyRad = camUnderwater()
                    ? applyMurkSky(dirWS)
                    : applySkyFog(sampleBackground(dirWS) + proceduralStars(dirWS), dirWS);
        skyRad = compositeClouds(skyRad, px, 1e30);// upsampled half-res cloud layer over the sky
        // Dust in front of the sky. Without this the cloud is invisible against
        // the background and only reads where it covers geometry — the whole
        // silhouette of a dust curtain lives here.
        skyRad = applyParticleFog(skyRad, camPos, dirWS, 1e30);
        vec3 sky = skyRad * domWeight;
        // SOLID-COLOUR background (flags bit 10): the bg is DISPLAY-referred
        // (the exact clear colour, restored verbatim by the composite's sky
        // bypass), not physical radiance — store it UNexposed so it lives in
        // the same value domain as the pre-exposed geometry. Without this,
        // any cross-pixel mixing into sky (DoF, bloom) gets amplified by
        // 1/preExposure at the bypass → white silhouette rims. Legacy mode:
        // preExp is 1.0 and both branches are identical.
        const float skyPe = (flagOn(1024u)) ? 1.0 : uintBitsToFloat(pc.preExpBits);
        sky *= skyPe;
        // Volumetric sun glow / god rays added on top → blooms THROUGH the
        // haze. Per-pixel view-ray integral: full weight, independent of
        // coverage. Sky = the full froxel range (the far marches were
        // σ-extinct anyway) + the per-pixel spot beams (a lighthouse against
        // the night sky). Physical radiance → always pre-exposed.
        sky += (froxelInscatter(uv, kFroxelZMax)
              + volumetricSpotScatter(camPos, dirWS, 2000.0, px)
              + volumetricDirScatter(camPos, dirWS, 2000.0, px)
              // Shafts against open water: on a background pixel the murk march
              // is the ONLY structure in the frame, so it is what stops the
              // endless blue from being a flat gradient.
              + murkSunScatter(camPos, dirWS, 2000.0, px)) * uintBitsToFloat(pc.preExpBits);
        // Waterline band, if this pixel's port point sits within a centimetre of
        // the surface (no-op otherwise — see applyMeniscus). Last, so it grades
        // the finished pixel: it is water on the GLASS, in front of everything.
        imageStore(outImage, px, vec4(applyMeniscus(sky, uintBitsToFloat(pc.preExpBits)), 1.0));
        imageStore(indirectImage, px, vec4(0.0));
        imageStore(shadowVisImage, px, vec4(0.0));// cold-start marker for the ping-pong
        imageStore(directUImage, px, vec4(0.0));
        imageStore(demodColorImage, px, vec4(0.0));
        return;
    }

    // Unlit (MeshBasicMaterial, roughness sentinel < 0): emit base colour
    // (fogged by primary distance — three.js fogs basic materials too).
    if (nTap.w < 0.0) {
        if (pc.shadeMode == 1u) return;// dispatch B: skip (rare — unlit minority sample at an edge)
        const float depthU = texelFetch(gbufDepthTex, px, 0).x;
        const vec4  vhU    = cam.projInverse * vec4(ndc, depthU, 1.0);
        const vec3  wpU    = (cam.viewInverse * vec4(vhU.xyz / vhU.w, 1.0)).xyz;
        // Same coverage weighting as the main path: dominant fraction + the
        // sky minority blended here (dispatch B pays the geometry minority).
        // Surface fog matches the lit path's dispatch (hetero air medium vs the
        // vestigial homogeneous path) so an unlit MeshBasicMaterial fades to the
        // same haze as everything else — no crisp unlit island in the mist. Then
        // the underwater murk on the below-surface leg portion (no-op above water).
        const float distU = length(wpU - camPos);
        vec3 outU = applyParticleFog(
                            applyMurk((clouds.heteroActive > 0.5)
                                      ? applyHeteroSurfaceFog(albedo, uv, distU, camPos, wpU)
                                      : applySceneFog(albedo, camPos, wpU), camPos, wpU),
                            camPos, (wpU - camPos) / max(distU, 1e-6), distU) * domWeight;
        if (skyEdgeW > 0.0) outU += skyEdgeW * skyBackground(ndc, camPos);
        // setUnlitFogScatter (flags bit 28): the per-pixel view-ray integrals
        // the lit and water branches add after their coverage scale: the cloud
        // layer in front, the clustered point-light glow, the spot beams and
        // the sun shafts / aerial glow. Off, an unlit surface behind sunlit
        // haze is a cut-out: extinction and ambient only, nothing scattered in
        // front of it (the cabin project's "ghost trees").
        if (flagOn(268435456u)) {
            const vec3 dirU = (wpU - camPos) / max(distU, 1e-6);
            outU = compositeClouds(outU, px, distU);
            outU += froxelInscatter(uv, max(-(vhU.z / vhU.w), 0.0))
                  + volumetricSpotScatter(camPos, dirU, distU, px)
                  + volumetricDirScatter(camPos, dirU, distU, px);
        }
        // Murk sun shafts over the submerged part of this leg — a per-pixel
        // view-ray integral, so full weight, after the coverage scale. (This
        // path carries no other volumetric term; the murk march is added
        // wherever applyMurk is, or an unlit surface would sit in front of
        // shafts that stop at its silhouette.)
        outU += murkSunScatter(camPos, (wpU - camPos) / max(distU, 1e-6), distU, px);
        imageStore(outImage, px, vec4(applyMeniscus(outU * uintBitsToFloat(pc.preExpBits),
                                                    uintBitsToFloat(pc.preExpBits)), 1.0));
        imageStore(indirectImage, px, vec4(0.0));
        imageStore(shadowVisImage, px, vec4(0.0));
        imageStore(directUImage, px, vec4(0.0));
        imageStore(demodColorImage, px, vec4(0.0));
        return;
    }

#include "deferred_shade_06_prologue_surface.glsl"

    // ── OCEAN water surface only: analytic deep-water shade (Fresnel reflect ⊕
    // absorption-tinted body + foam), replacing the opaque shade entirely. Gated
    // on the per-mesh FOAM ATTRIBUTE (foamAddress) — i.e. an actual FFT-displaced
    // DisplacedMesh — NOT just `thinWalled`. glTF glass is almost always
    // thin-walled too (no KHR_volume → thinWalled), and routing it here painted
    // it milky-teal ocean water instead of clear refraction. Thin-walled glass
    // now falls through to the refractive glass branch below like closed glass.
    if (pm.thinWalled != 0 && pm.transmission > 0.0 && geoms[id - 1u].foamAddress != 0ul) {
        // Dispatch B skips water's minority-sample refinement (rare at an
        // ocean's silhouette against sky/terrain, and shadeWater's own
        // internal accumulation state is dispatch-A-only) — dispatch A's
        // dominant-sample result stands alone for these pixels, same as
        // pre-Phase-2 behaviour. Not a regression: msaa=1 never reaches here
        // with shadeMode==1 at all.
        if (pc.shadeMode == 1u) return;
        // Its point and spot lights are this pixel's cluster cell: the slice by
        // view-space -z, as the opaque path's (matches cluster_build's AABB axis).
        vec3 wcol = shadeWater(worldPos, N, V, pm, int(id - 1u),
                               shadowsOn, maxLod, pc.frame, seed, fineKernelSq, Nmacro,
                               px, max(-(viewH.z / viewH.w), 0.0));
        // Coverage weighting as in the main path — water-dominant edge pixels
        // reserve geoMinW for dispatch B and blend their own sky minority;
        // the volumetric in-scatter is per-pixel and stays at full weight.
        const float distW = length(worldPos - camPos);
        wcol = applyParticleFog(
                       applyMurk((clouds.heteroActive > 0.5)
                                 ? applyHeteroSurfaceFog(wcol, uv, distW, camPos, worldPos)
                                 : applySceneFog(wcol, camPos, worldPos), camPos, worldPos),
                       camPos, (worldPos - camPos) / max(distW, 1e-6), distW) * domWeight;
        if (skyEdgeW > 0.0) wcol += skyEdgeW * skyBackground(ndc, camPos);
        // Volumetric in-scatter — the SAME three terms the opaque path adds
        // below: froxel clustered point-light glow, per-pixel spot beams, and
        // the per-pixel directional sun shafts / aerial glow. The sun term
        // (volumetricDirScatter) was previously omitted here — a leftover from
        // when the froxel LUT still carried directional in-scatter (the stale
        // "sun shafts ... new on water" note). After directional moved to the
        // per-pixel march (the grid blurred the shafts to nothing), water lost
        // it entirely, so a scene whose ONLY light is the sun (spot_slam: no
        // point/spot lights) showed effectively un-fogged water while the
        // terrain got the full aerial glow.
        wcol = compositeClouds(wcol, px, length(worldPos - camPos));// depth-aware cloud layer in front of the water
        wcol += froxelInscatter(uv, max(-(viewH.z / viewH.w), 0.0))
              + volumetricSpotScatter(camPos, -V, length(worldPos - camPos), px)
              + volumetricDirScatter(camPos, -V, length(worldPos - camPos), px)
              + murkSunScatter(camPos, -V, length(worldPos - camPos), px);// shafts under the surface
        imageStore(outImage, px, vec4(applyMeniscus(wcol * uintBitsToFloat(pc.preExpBits),
                                                    uintBitsToFloat(pc.preExpBits)), 1.0));
        imageStore(indirectImage, px, vec4(0.0));
        imageStore(reflectImage, px, vec4(0.0));// water shades its own reflection inline
        imageStore(shadowVisImage, px, vec4(0.0));// water shadows its own lighting inline
        imageStore(directUImage, px, vec4(0.0));
        imageStore(demodColorImage, px, vec4(0.0));
        return;
    }

#include "deferred_shade_07_prologue_material.glsl"

    // ADAPTIVE GI SAMPLE COUNT — probe the reprojected prev history length (binding
    // 17 .a). Fresh / just-disoccluded pixels (low/zero history) carry all the
    // 1-spp noise, so spend MORE rays there to converge them with SAMPLES (stays
    // crisp) rather than a wide blur (which reads as a moving "cloud"). Converged
    // pixels coast on 2 rays + temporal history. Cost only spikes in disoccluded
    // regions during motion — exactly where it's needed and tolerable.
    int giSpp = 3;
    bool giSkip = false;// checkerboard carry (set in the adaptive block below)
    int nSRays = 2;// shadow-ratio rays: 2 while fresh / in-penumbra, 1 converged
    if (demodIndirect) {
        // ONE motion tap for both halves of the reproject: .rg is the NDC delta and
        // .b this surface's prev NDC depth, and the depth gate below samples the
        // same texel at the same uv, so a second fetch returns the same bits.
        const vec3 mot  = texture(gbufMotionTex, paneToPhys(gbufMotionTex, uv)).rgb;
        const vec2 mv   = mot.rg;
        const vec2 pNdc = vec2(uv.x * 2.0 - 1.0, -(uv.y * 2.0 - 1.0)) + mv;
        const vec2 pUv  = vec2(pNdc.x * 0.5 + 0.5, 0.5 - pNdc.y * 0.5);
        float ph = 0.0;// prev histLen at the reprojected pixel (0 = off-screen / disoccluded ⇒ fresh)
        if (all(greaterThanEqual(pUv, vec2(0.0))) && all(lessThanEqual(pUv, vec2(1.0)))) {
            const vec3  pn = texture(gbufNormalPrevTex, paneToPhys(gbufNormalPrevTex, pUv)).xyz * 2.0 - 1.0;
            const float surfD = mot.b;    // this surface's prev NDC depth
            const float bufD  = texture(gbufDepthPrevTex, paneToPhys(gbufDepthPrevTex, pUv)).x;// prev depth buffer at the reproject
            const vec4  svh = cam.projInverse * vec4(pNdc, surfD, 1.0);
            const vec4  bvh = cam.projInverse * vec4(pNdc, bufD, 1.0);
            const float svz = svh.z / svh.w;
            // same surface = loose normal match AND its own prev depth matches the
            // buffer (depth is primary; loose normal avoids treating a deforming
            // skinned surface as fresh → keeps its history → no dust).
            if (dot(N, normalize(pn)) > 0.7 &&
                abs(svz - bvh.z / bvh.w) <= 0.1 * max(abs(svz), 1e-3)) {
                ph = texture(giPrevTex, paneToPhys(giPrevTex, pUv)).a;
                // Shadow-channel adaptive rays: a CONVERGED pixel outside any
                // penumbra (long history, near-zero temporal variance of the
                // visibility ratio) coasts on 1 ray/frame; fresh/disoccluded
                // and penumbra pixels (where E[R²]−R² stays > 0) keep 2 so
                // they converge with samples instead of blur.
                const vec4 sPrev = texture(shadowVisPrevTex, paneToPhys(shadowVisPrevTex, pUv));
                if (sPrev.z >= 8.0 && (sPrev.y - sPrev.x * sPrev.x) < 0.005) nSRays = 1;
            } else {
                // The GI accumulation below KEEPS its history when this surface
                // (normal within 90°, either side when double-sided, and its own
                // prev view-Z) is anywhere in the 3×3 at the reproject. The
                // single-tap test above fails frame after frame on sub-pixel
                // foliage and detail-normal terrain under the jitter, so those
                // pixels drew the fresh tier's 6 rays into a history the
                // accumulation was keeping all along. The ray tier now takes
                // the accumulation's verdict: same history, fewer rays.
                const uvec4 tIds = (msSampleIdx >= 0) ? texelFetch(gbufIdsMS, px, msSampleIdx)
                                                      : texelFetch(gbufIdsTex, px, 0);
                const bool  tDs  = ifDoubleSided(tIds.z);
                const ivec2 ip   = ivec2(pUv * vec2(float(pc.width), float(pc.height)));
                const ivec2 mx   = ivec2(int(pc.width), int(pc.height)) - 1;
                bool found = false;
                for (int dy = -1; dy <= 1 && !found; ++dy) {
                    for (int dx = -1; dx <= 1 && !found; ++dx) {
                        const ivec2 tp = clamp(ip + ivec2(dx, dy), ivec2(0), mx);
                        float nd = dot(N, normalize(texelFetch(gbufNormalPrevTex, tp, 0).xyz * 2.0 - 1.0));
                        if (tDs) nd = abs(nd);
                        if (nd <= 0.0) continue;
                        const vec4 tb = cam.projInverse * vec4(pNdc, texelFetch(gbufDepthPrevTex, tp, 0).x, 1.0);
                        if (abs(svz - tb.z / tb.w) <= 0.1 * max(abs(svz), 1e-3)) found = true;
                    }
                }
                // ...and its trailing-edge id guard over the history read's
                // 2×2 footprint, so a pixel the accumulation restarts behind a
                // mover or under camera translation keeps the fresh tier.
                if (found) {
                    const ivec2 fb = ivec2(floor(pUv * vec2(float(pc.width), float(pc.height)) - 0.5));
                    const bool camMoved = pc.camDelta > 0.001;
                    for (int dy = 0; dy <= 1 && found; ++dy)
                        for (int dx = 0; dx <= 1 && found; ++dx) {
                            const uvec4 pids = texelFetch(gbufIdsPrevTex, clamp(fb + ivec2(dx, dy), ivec2(0), mx), 0);
                            if ((pids.x == 0u && camMoved) ||
                                (pids.x > 0u && pids.y != tIds.y && (ifMoving(pids.z) || camMoved))) found = false;
                        }
                }
                if (found) ph = texture(giPrevTex, paneToPhys(giPrevTex, pUv)).a;
            }
        }
        // EFFECTIVE history = min(prev history, the motion-scaled cap this pixel will
        // get in the accumulation). So a fast camera PAN (no disocclusion, but a
        // short effective history) ALSO gets more rays — killing the pan "cloud",
        // not just disocclusions. Disoccl (ph=0) → 8, pan → 4, static → 2.
        // WORLD-MOTION term: a body panel that is SCREEN-static but WORLD-moving
        // (car paint under a chase/POV cam) has mv≈0 yet its GI integrand changes
        // every frame as the surrounding trees/road/grass sweep past. A screen-only
        // cap pins history at 48 and the 1/48 EMA chases a non-stationary signal
        // forever (colour boil + lag), AND keeps the pixel in the 1-ray static tier.
        // Fold in camera world motion (the chase-cam proxy reflReproject already
        // uses) so these surfaces get a shorter responsive history and drop into the
        // 2-ray tier — more samples on a tracking mean = less boil. Collapses to
        // length(mv) when the camera is still (byte-identical static-settle).
        const float giCamNdc = pc.camRot * 1.7 + 1.7 * pc.camDelta / max(length(worldPos - camPos), 0.25);
        const float capF  = mix(48.0, 6.0, smoothstep(0.002, 0.03, max(length(mv), giCamNdc)));
        const float effPh = min(ph, capF);
        // Tiers 8/3/1 (was 8/4/2): converged static pixels ride 1 ray/frame —
        // the TAA now actually converges statics, so the long-history tier can
        // lean on accumulation instead of fresh rays.
        giSpp = effPh < 4.0 ? 6 : (effPh < 16.0 ? 2 : 1);// 6/2/1 (was 8/3/1): flattens
        // the motion cost spike — a fast pan puts the WHOLE frame in the mid
        // tier, so its ray count dominates frame time exactly when input
        // responsiveness matters most. With the checkerboard halving, the pan
        // tier now costs ~the static tier; the SVGF variance blur carries the
        // slightly higher fresh-pixel noise.
        // CHECKERBOARD: with ≥8 frames of valid history, alternating pixels
        // skip the ENTIRE gather + ReSTIR this frame and carry their
        // accumulated history through — halves the gather cost at EVERY tier
        // (including the expensive motion tiers, which the per-hit cuts
        // didn't touch). Fresh/disoccluded pixels (effPh < 8) always trace,
        // so convergence quality is unchanged where it matters.
        giSkip = ((((px.x ^ px.y) ^ int(pc.frame)) & 1) == 1) && effPh >= 4.0;
    }

    // Diffuse indirect: visibility-gated env irradiance (RT, flags bit 1).
    const bool aoOn    = flagOn(2u);
    const bool probesOn = probesEnabled();
    // Half-res RT ambient occlusion + bent normal (rtao.comp), depth-aware
    // upsampled to this pixel. ao=1 / bentN=N when AO is off (identity).
    float rtAo = 1.0;
    float rtAoNear = 1.0;
    float rtSkyVis = 1.0;// far-field sky visibility (enclosure): env/ambient gate
    vec3  bentN = N;
    if (aoOn && pc.shadeMode != 1u) rtaoGather(px, viewH.z / viewH.w, N, rtAo, rtAoNear, rtSkyVis, bentN);
    // Phase B's probe tap, taken here so the checkerboard below knows whether
    // this pixel runs the gather; the Phase B branch reuses it (one tap).
    float probeConf = 0.0;
    vec3  probeE    = vec3(0.0);
    if (aoOn && probesOn && pc.shadeMode != 1u)
        probeE = probeIrradianceConf(worldPos + N * SHADOW_EPS, N, probeConf) * (1.0 / PI);
    // The share of the probe path's fill that its stochastic gather supplies
    // (see the UNMEASURED SHARE note in Phase B). Flags bit 14
    // (THREEPP_VK_DIAG_NOGATHER): diagnostic, never gather.
    const float probeGatherW = flagOn(16384u) ? 0.0 : 1.0 - smoothstep(0.25, 0.5, probeConf);
    // Flags bit 15 (THREEPP_VK_PROBE_FAR): 1 beyond the coarsest cascade window,
    // where the probe path's fill is the ray-free sky term instead of the gather.
    const float probeFarW = (flagOn(32768u) && aoOn && probesOn && pc.shadeMode != 1u)
                          ? probeBeyondWindows(worldPos + N * SHADOW_EPS, N) : 0.0;
    // Checkerboard only pays off on the stochastic RT gather: always on the
    // no-probe path (Phase A), and on the probe path (Phase B) where the probes
    // measured too little and the gather fills that share (beyond the coarsest
    // cascade window, starved probes). A pixel the probes cover is a cheap
    // smooth tap, never skipped; with AO off there is no gather to skip.
    if (!aoOn || (probesOn && !(demodIndirect && probeGatherW > 0.0 && probeFarW < 1.0))) giSkip = false;
    vec3 diffInd;
    if (pc.shadeMode == 1u) {
        // Dispatch B: cheap deterministic fill only — no RT gather, no
        // ReSTIR (both own dispatch-A-exclusive temporal state: the GI
        // accumulator and the reservoir ping-pong). A minority sample's
        // indirect term is a small correction at an edge pixel; the same
        // cost/accuracy call as the inline reflection fold-in above. This is
        // the GI-recombine-albedo approximation documented at the SVGF gate
        // near the end of main().
        // PROBE-GATED like the glass-retrace hit fill (same shape: a point
        // shaded without rays). The raw env fill ignores occlusion, so in an
        // ENCLOSED interior every silhouette's minority sliver carried
        // full-sky irradiance on top of dispatch A's probe-dark surround —
        // invisible outdoors (gated ≈ ungated), but auto-exposure gain on a
        // dark interior amplified it into a lit white rim on every edge
        // (Sponza + MSAA4 + auto-exposure). Saturated-confidence blend, same
        // rationale as the retrace fill: a partially-valid interior
        // neighbourhood is trusted outright; a starved one (conf → 0) means
        // "unmeasured", not "dark" — fall back to the env fill, never black.
        diffInd = sampleEnvDiffuse(N) + lights.ambient + hemiAmbient(N);
        if (probesEnabled()) {
            float bConf;
            const vec3 bFill = probeIrradianceConf(worldPos, N, bConf) * (1.0 / PI);
            diffInd = mix(diffInd, bFill, smoothstep(0.0, 0.25, bConf));
        }
    } else if (giSkip) {
        diffInd = vec3(0.0);// unused — the accumulation below carries history
        // ReSTIR reservoirs PING-PONG (read prev fif, write curr): a skipped
        // pixel must still pass its reservoir through, or next frame's read
        // sees stale data in a checkerboard pattern.
        if (flagOn(8u)) {
            imageStore(reservoirPosWrite, px, imageLoad(reservoirPosRead, px));
            imageStore(reservoirWWrite,  px, imageLoad(reservoirWRead,  px));
        }
    } else if (aoOn && probesOn) {
        // ── Phase B: probe + bent-normal env diffuse indirect ────────────────
        // The probe field already carries the sky + multi-bounce interior GI
        // (what the stochastic 1-bounce rays approximated); RT AO restores the
        // near-field occlusion the SH-L1 grid can't represent. This REPLACES
        // the per-pixel gatherEnv GI rays — a smooth, ray-free indirect.
        //
        // OCCLUSION SPLIT (the Sponza black-floor fix): the probe tap's own
        // Chebyshev depth is already a far-field visibility term, so gating
        // probeE by the FULL hemisphere AO double-counts occlusion — a floor
        // shadowed by columns 1-2 m away went near-black while the GI-ray path
        // kept its wall bounce. probeE gets only the NEAR-FIELD AO (contact
        // darkening the grid can't see).
        //
        // ENCLOSURE (the Sponza corridor sky-leak fix): the env/sky and flat
        // scene ambient carry NO probe visibility, but finite-radius ao ≈ 1 on a
        // flat wall mid-corridor ("no occluder within 2 m" ≠ "sky visible") let
