    // minority, a documented approximation.
    const uint idsW0 = texelFetch(gbufIdsTex, px, 0).w;
    const bool isComplex = (idsW0 & 0x8000u) != 0u;
    if (pc.shadeMode == 1u && !isComplex) return;

