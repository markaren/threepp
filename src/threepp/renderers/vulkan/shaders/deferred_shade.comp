        imageStore(momentsImage, px, vec4(0.0));
        // The no-ratio marker (-1, histLen 0), not 0: a 0 here is a "fully
        // shadowed" vote in every neighbour's a-trous ratio filter (the taps
        // skip only sky, unlit and the marker), which blacked out a thin stem
        // standing in front of a glass pane.
        imageStore(shadowVisImage, px, vec4(-1.0, 0.0, 0.0, 0.0));// glass/inline: no shadow channel
    }
    // Unshadowed analytic direct for the recombine (U × R̃). UNWEIGHTED like
    // indirect/reflect — the denoise applies recombineCoverage at consumption.
    // vec3(0) whenever the channel is off, so the recombine adds nothing.
    // fp16-SAFE clamp — same bound + rationale as the diffInd clamp above: the
    // GGX peak at the 0.04 roughness floor times a physical-unit light pushes U
    // past fp16 max (65504); an Inf store turns NaN at the recombine's dU × R̃
    // whenever the filtered ratio is exactly 0 (converged umbra), and that NaN
    // poisons the pixel's TAA history permanently.
    // .a: the indirect-diffuse share (see diffBaseShare). The recombine no
    // longer reads it; it takes the share from demodColor, stored next.
    imageStore(directUImage, px, vec4(min(directU, vec3(6.5e4)), demodIndirect ? diffBaseShare : 1.0));
    imageStore(demodColorImage, px, vec4(demodColor, 0.0));
}
