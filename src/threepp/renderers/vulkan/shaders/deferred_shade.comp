    // grows ~linearly past that so the sun's tmin=0.0 shadow ray clears the
    // surface even when float precision at large |worldPos| swallows 1mm.
    SHADOW_EPS = max(1e-3, max(max(abs(worldPos.x), abs(worldPos.y)), abs(worldPos.z)) * 1e-5);

    vec3        N         = normalize(nTap.xyz * 2.0 - 1.0);// mutable: FFT chop below
    // GEOMETRIC SPECULAR AA (Kaplanyan-style): widen the GGX roughness by the
    // 4-neighbour G-buffer normal variance, so sub-pixel normal detail (dense
    // normal maps, curvature, distant meshes) shades with the roughness its
    // pixel footprint actually spans. At 1 spp under the Halton jitter a
    // sub-pixel glint otherwise flips bright/dark every frame — an alternating
    // input TAA can never converge (the "distant edges shimmer" bug; the
    // original fix measured 4.5× lower consecutive-frame diff on the ocean
    // harness). kernel² capped at 0.04 so macro geometry edges don't go matte.
    float specAaKernelSq = 0.0;
    {
        const ivec2 saMax = ivec2(int(pc.width), int(pc.height)) - 1;
        const ivec2 saOff[4] = ivec2[4](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
        float varN = 0.0;
        for (int i = 0; i < 4; ++i) {
            const vec4 nn = texelFetch(gbufNormalTex, clamp(px + saOff[i], ivec2(0), saMax), 0);
            if (nn.w <= 0.0) continue;// sky (0) / unlit (<0) neighbours carry no surface normal
            const vec3 dn = normalize(nn.xyz * 2.0 - 1.0) - N;
            varN += dot(dn, dn) * 0.25;
        }
        specAaKernelSq = min(2.0 * varN, 0.04);
    }
    const float roughMat  = clamp(nTap.w, 0.04, 1.0);
    const float roughness = min(sqrt(roughMat * roughMat + specAaKernelSq), 1.0);
    const float metalness = clamp(am.a, 0.0, 1.0);

    const MaterialDesc pm = mats[id - 1u];
    // Emissive: factor × emissive MAP. glTF sets emissiveFactor=(1,1,1) whenever
    // an emissive texture is present (the MAP, not the factor, carries the actual
    // emission), so applying the bare factor makes textured-emissive submeshes
    // (e.g. the SWAT exoskeleton) glow full white. The primary UV comes from the
    // G-buffer (gbuffer.frag attachment 3). Mirrors the reflection-hit path
    // (hitTex at the hit UV); texIndex < 0 → factor unchanged (no regression).
    const vec2 primUv     = (msSampleIdx >= 0) ? texelFetch(gbufUvMS, px, msSampleIdx).rg : texelFetch(gbufUvTex, px, 0).rg;
    const vec3 emissive   = hitTex(pm.emissiveTexIndex, pm.uvTransformEmissive, primUv,
                                   pm.emissive * pm.emissiveIntensity);

    const vec3 V          = normalize(camPos - worldPos);
    const bool shadowsOn  = (pc.flags & 1u) != 0u;
    // Per-pixel RNG stream (frame-jittered) for emissive NEE; advanced through
    // the primary + reflection shades so the draws decorrelate. TAA averages.
    // Temporally stable (no `frame`) — same reasoning as gatherEnv: reflections /
    // emissive-NEE settle to a fixed result instead of flickering. Different
    // constant so this stream decorrelates from the AO/GI stream above.
    uint seed = pcgHash(uint(px.x) ^ pcgHash(uint(px.y) ^ 0x85ebca6bu));

    // ── FFT fine-cascade normal: recover the sub-mesh chop the rasterised wave
    // geometry can't resolve, via an oceanFineHeight central-difference gradient.
    // Gated on thin-shell + an active ocean (dummy tex + tile size 0 otherwise),
    // so it's a no-op for every non-ocean surface. Must run before N is used.
    // Removed sub-pixel FFT-chop slope variance, banked into the water roughness
    // below (declared out here so it survives the block's scope).
    float fineKernelSq = 0.0;
    // MACRO surface normal — the gbuffer normal BEFORE the fine-cascade tilt
    // (and before any stochastic jitter). shadeWater clamps its reflection ray
    // against this plane; see the self-hit note there. Orientation-agnostic,
    // so a rotated (Z-up) ocean works without a world-up assumption.
    vec3 Nmacro = N;
    // foamAddress gate — same ocean marker the water branch below uses, for the
    // same reason its comment gives: glTF transmission glass is almost always
    // thin-walled too (no KHR_volume → thinWalled), and oceanFineTileSize is
    // scene-GLOBAL, so without it every thin-walled glass surface in an ocean
    // scene had its normal flipped and tilted by wave slope sampled at its own
    // worldPos.xz (the lantern glazing wobbled at ocean-wave frequency).
    if (pm.thinWalled != 0 && pc.oceanFineTileSize > 0.0 && geoms[id - 1u].foamAddress != 0ul) {
        // The FFT DisplacedMesh's gbuffer normal comes out INVERTED (pointing down
        // into the water) → NdotV≈0 → Fresnel pinned at ~1 → the ocean read as a
        // flat, dull sky reflection with NO depth gradient. Water is
        // always viewed from above, so face the camera. Done BEFORE the fine-cascade
        // perturbation so the chop tilt is added in the correct (up) frame.
        if (dot(N, V) < 0.0) N = -N;
        Nmacro = N;// post-flip, pre-tilt: the surface's own plane
        const float invTile = 1.0 / pc.oceanFineTileSize;
        const float eps     = pc.oceanFineTileSize / 32.0;
        const float depsUV  = eps * invTile;
        const vec2  uvW     = worldPos.xz * invTile;
        const float hL = textureLod(oceanFineHeight, uvW + vec2(-depsUV, 0.0), 0.0).r * invTile;
        const float hR = textureLod(oceanFineHeight, uvW + vec2( depsUV, 0.0), 0.0).r * invTile;
        const float hD = textureLod(oceanFineHeight, uvW + vec2(0.0, -depsUV), 0.0).r * invTile;
        const float hU = textureLod(oceanFineHeight, uvW + vec2(0.0,  depsUV), 0.0).r * invTile;
        const vec2  grad = vec2(hR - hL, hU - hD) / (2.0 * eps);
        // ── Distance filtering (LEAN-style specular AA for water) ──────────────
        // oceanFineHeight is a single-mip texture (no prefilter), sampled here at
        // a FIXED world-space eps regardless of distance. At the altitudes this
        // water is viewed from (100 m – 2 km up) the fine cascade's metre-and-
        // below wave detail sits far below the pixel footprint, so point-sampling
        // its slope and shading a razor-sharp GGX lobe against it decorrelates the
        // sun glint into a pure-noise speckle field. Fix: FADE the chop out of N
        // as the pixel footprint outgrows the ~2·eps slope baseline, and BANK the
        // removed slope variance into the water roughness (fineKernelSq) so the
        // glint broadens into a coherent glitter sheen instead of aliasing. Near
        // water (small footprint) keeps its full crisp sparkle.
        // Under a PARALLEL projection the footprint doesn't grow with distance —
        // projInverse[1][1] is already half the frustum height in world units,
        // so the leg drops out and every pixel covers the same patch of water.
        const float pixWorld = (cam.camAux.x > 0.5 ? 1.0 : length(worldPos - camPos))
                             * 2.0 * cam.projInverse[1][1]
                             / max(float(pc.height), 1.0);            // world m / pixel (FOV+res correct)
        // The central-difference `tilt` measures wave slope at the ~2·eps (≈0.44 m)
        // scale; once the pixel footprint outgrows that, the slope it samples is
        // sub-pixel and must move from GEOMETRY (a razor-glinted N) into ROUGHNESS
        // (a broadened glitter lobe), or the sun highlight aliases to speckle. The
        // old fade completed at 12·eps (≈2.6 m/px) — but the demo views this ocean
        // from 100 m–2 km up, where much of the water sits at 0.3–1.5 m/px: the
        // chop stayed in N, razor-glinted, = the reported per-pixel noise. Complete
        // the hand-off by ~5·eps so mid-distance water converts to sheen.
        const float subPix   = smoothstep(0.5 * eps, 1.5 * eps, pixWorld);// 0 near → 1 sub-pixel
        // Full physical slope: N ∝ up − ∇h. Until 2026-08 this carried a 0.5
        // (undocumented, from the first deferred commit) that rendered the
        // sub-mesh chop at HALF its steepness — the 1–9 m wind waves read as
        // a glassy sheen and a 10 m hull looked like a bath toy on the swell.
        // The speckle that factor presumably guarded against is handled by
        // the footprint fade + roughness banking below.
        const vec3  tilt     = vec3(-grad.x, 0.0, -grad.y);
        N = normalize(N + (1.0 - subPix) * tilt);
        // σ_slope² ≈ 2·roughness²; move the faded-out tilt's variance into roughness
        // so shadeWater's glint + reflection lobe broaden as the chop leaves N.
        fineKernelSq = 2.0 * dot(tilt, tilt) * subPix;
        // FOOTPRINT FLOOR. The fine-cascade slope alone is tiny for a calm sea
        // (Phillips amplitude ∝ windSpeed⁴ → a 4 m/s coastal sea has a millimetric
        // fine cascade), so banking only IT leaves effRough ≈ the base 0.03 and the
        // razor sun lobe still glints the RASTERISED mesh normal — the coarse FFT
        // vertex grid (here ~25 m verts over a 9.6 km tile) displaced by cascades
        // 0/1, itself sub-pixel at 100 m–2 km and aliasing to the reported speckle.
        // The fine-cascade fade can't touch that geometry normal, so floor the
        // banked variance on the pixel FOOTPRINT: distant water always carries a
        // broad-enough lobe to integrate the unresolved wave-normal distribution
        // into a coherent glitter sheen. Near water (footprint ≤ ~0.25 m/px) floors
        // at ~0 and keeps its crisp near-mirror sparkle. Independent of wave energy,
        // so it holds for a glassy calm sea and a choppy one alike.
        const float footRough = 0.45 * smoothstep(0.25, 4.0, pixWorld);
        fineKernelSq = min(max(fineKernelSq, footRough * footRough), 0.25);
    }

    // ── OCEAN water surface only: analytic deep-water shade (Fresnel reflect ⊕
    // absorption-tinted body + foam), replacing the opaque shade entirely. Gated
    // on the per-mesh FOAM ATTRIBUTE (foamAddress) — i.e. an actual FFT-displaced
    // DisplacedMesh — NOT just `thinWalled`. glTF glass is almost always
    // thin-walled too (no KHR_volume → thinWalled), and routing it here painted
    // it milky-teal ocean water instead of clear refraction. Thin-walled glass
    // now falls through to the refractive glass branch below like closed glass.
    if (pm.thinWalled != 0 && pm.transmission > 0.0 && geoms[id - 1u].foamAddress != 0ul) {
        // Dispatch B skips water's minority-sample refinement (rare at an
        // ocean's silhouette against sky/terrain, and shadeWater's own
        // internal accumulation state is dispatch-A-only) — dispatch A's
        // dominant-sample result stands alone for these pixels, same as
        // pre-Phase-2 behaviour. Not a regression: msaa=1 never reaches here
        // with shadeMode==1 at all.
        if (pc.shadeMode == 1u) return;
        vec3 wcol = shadeWater(worldPos, N, V, pm, int(id - 1u),
                               shadowsOn, maxLod, pc.frame, seed, fineKernelSq, Nmacro);
        // Coverage weighting as in the main path — water-dominant edge pixels
        // reserve geoMinW for dispatch B and blend their own sky minority;
        // the volumetric in-scatter is per-pixel and stays at full weight.
        const float distW = length(worldPos - camPos);
        wcol = applyParticleFog(
                       applyMurk((clouds.heteroActive > 0.5)
                                 ? applyHeteroSurfaceFog(wcol, uv, distW, camPos, worldPos)
                                 : applySceneFog(wcol, camPos, worldPos), camPos, worldPos),
                       camPos, (worldPos - camPos) / max(distW, 1e-6), distW) * domWeight;
        if (skyEdgeW > 0.0) wcol += skyEdgeW * skyBackground(ndc, camPos);
        // Volumetric in-scatter — the SAME three terms the opaque path adds
        // below: froxel clustered point-light glow, per-pixel spot beams, and
        // the per-pixel directional sun shafts / aerial glow. The sun term
        // (volumetricDirScatter) was previously omitted here — a leftover from
        // when the froxel LUT still carried directional in-scatter (the stale
        // "sun shafts ... new on water" note). After directional moved to the
        // per-pixel march (the grid blurred the shafts to nothing), water lost
        // it entirely, so a scene whose ONLY light is the sun (spot_slam: no
        // point/spot lights) showed effectively un-fogged water while the
        // terrain got the full aerial glow.
        wcol = compositeClouds(wcol, px, length(worldPos - camPos));// depth-aware cloud layer in front of the water
        wcol += froxelInscatter(uv, max(-(viewH.z / viewH.w), 0.0))
              + volumetricSpotScatter(camPos, -V, length(worldPos - camPos), px)
              + volumetricDirScatter(camPos, -V, length(worldPos - camPos), px)
              + murkSunScatter(camPos, -V, length(worldPos - camPos), px);// shafts under the surface
        imageStore(outImage, px, vec4(applyMeniscus(wcol * uintBitsToFloat(pc.preExpBits),
                                                    uintBitsToFloat(pc.preExpBits)), 1.0));
        imageStore(indirectImage, px, vec4(0.0));
        imageStore(reflectImage, px, vec4(0.0));// water shades its own reflection inline
        imageStore(shadowVisImage, px, vec4(0.0));// water shadows its own lighting inline
        imageStore(directUImage, px, vec4(0.0));
        return;
    }

    const float NdotV = max(dot(N, V), 1e-4);
    vec3        F0    = mix(vec3(0.04) * pm.specularIntensity * pm.specularColor, albedo, metalness);
    // Thin-film iridescence (KHR_materials_iridescence). Modulates F0 with the
    // wavelength-dependent interference colour; lobe shape (GGX) is unchanged.
    // Skipped when factor == 0 → non-iridescent surfaces pay only the branch.
    if (pm.iridescence > 0.0) {
        const vec3 irid = evalIridescence(1.0, pm.iridescenceIOR, NdotV,
                                          pm.iridescenceThicknessNm, F0);
        F0 = mix(F0, irid, pm.iridescence);
    }
    const vec3  shadowOrig = worldPos + N * SHADOW_EPS;

    // Demodulated (binding 16, accumulated + denoised) vs INLINE diffuse indirect.
    // demodIndirect (opaque, non-sheen) → the GI is demodulated, temporally
    // accumulated + à-trous denoised. INLINE (transparent/glass/sheen) → the GI is
    // used directly. Computed BEFORE gatherEnv so the gather picks the right path:
    // stochastic real GI ONLY for the demod path (it gets accumulated/denoised);
    // the INLINE path uses the DETERMINISTIC GI (1-spp would just be noisy there —
    // that was the transparent-quad wobble).
    const bool denoiseOn = (pc.flags & 4u) != 0u;
    // Dispatch B forces the INLINE path (demodIndirect=false) — same
    // precedent as glass/sheen: a self-contained pixel color with no
    // dependency on the demod GI accumulator's cross-frame state, which
    // dispatch B never writes (see the GI/SVGF gate near the end of main()).
    const bool demodIndirect = pc.shadeMode != 1u && denoiseOn && (pm.transmission <= 0.0) &&
                               (dot(pm.sheenColor, pm.sheenColor) <= 0.0);

    // ADAPTIVE GI SAMPLE COUNT — probe the reprojected prev history length (binding
    // 17 .a). Fresh / just-disoccluded pixels (low/zero history) carry all the
    // 1-spp noise, so spend MORE rays there to converge them with SAMPLES (stays
    // crisp) rather than a wide blur (which reads as a moving "cloud"). Converged
    // pixels coast on 2 rays + temporal history. Cost only spikes in disoccluded
    // regions during motion — exactly where it's needed and tolerable.
    int giSpp = 3;
    bool giSkip = false;// checkerboard carry (set in the adaptive block below)
    int nSRays = 2;// shadow-ratio rays: 2 while fresh / in-penumbra, 1 converged
    if (demodIndirect) {
        const vec2 mv   = texture(gbufMotionTex, paneToPhys(gbufMotionTex, uv)).rg;
        const vec2 pNdc = vec2(uv.x * 2.0 - 1.0, -(uv.y * 2.0 - 1.0)) + mv;
        const vec2 pUv  = vec2(pNdc.x * 0.5 + 0.5, 0.5 - pNdc.y * 0.5);
        float ph = 0.0;// prev histLen at the reprojected pixel (0 = off-screen / disoccluded ⇒ fresh)
        if (all(greaterThanEqual(pUv, vec2(0.0))) && all(lessThanEqual(pUv, vec2(1.0)))) {
            const vec3  pn = texture(gbufNormalPrevTex, paneToPhys(gbufNormalPrevTex, pUv)).xyz * 2.0 - 1.0;
            const float surfD = texture(gbufMotionTex, paneToPhys(gbufMotionTex, uv)).b;    // this surface's prev NDC depth
            const float bufD  = texture(gbufDepthPrevTex, paneToPhys(gbufDepthPrevTex, pUv)).x;// prev depth buffer at the reproject
            const vec4  svh = cam.projInverse * vec4(pNdc, surfD, 1.0);
            const vec4  bvh = cam.projInverse * vec4(pNdc, bufD, 1.0);
            const float svz = svh.z / svh.w;
            // same surface = loose normal match AND its own prev depth matches the
            // buffer (depth is primary; loose normal avoids treating a deforming
            // skinned surface as fresh → keeps its history → no dust).
            if (dot(N, normalize(pn)) > 0.7 &&
                abs(svz - bvh.z / bvh.w) <= 0.1 * max(abs(svz), 1e-3)) {
                ph = texture(giPrevTex, paneToPhys(giPrevTex, pUv)).a;
                // Shadow-channel adaptive rays: a CONVERGED pixel outside any
                // penumbra (long history, near-zero temporal variance of the
                // visibility ratio) coasts on 1 ray/frame; fresh/disoccluded
                // and penumbra pixels (where E[R²]−R² stays > 0) keep 2 so
                // they converge with samples instead of blur.
                const vec4 sPrev = texture(shadowVisPrevTex, paneToPhys(shadowVisPrevTex, pUv));
                if (sPrev.z >= 8.0 && (sPrev.y - sPrev.x * sPrev.x) < 0.005) nSRays = 1;
            }
        }
        // EFFECTIVE history = min(prev history, the motion-scaled cap this pixel will
        // get in the accumulation). So a fast camera PAN (no disocclusion, but a
        // short effective history) ALSO gets more rays — killing the pan "cloud",
        // not just disocclusions. Disoccl (ph=0) → 8, pan → 4, static → 2.
        // WORLD-MOTION term: a body panel that is SCREEN-static but WORLD-moving
        // (car paint under a chase/POV cam) has mv≈0 yet its GI integrand changes
        // every frame as the surrounding trees/road/grass sweep past. A screen-only
        // cap pins history at 48 and the 1/48 EMA chases a non-stationary signal
        // forever (colour boil + lag), AND keeps the pixel in the 1-ray static tier.
        // Fold in camera world motion (the chase-cam proxy reflReproject already
        // uses) so these surfaces get a shorter responsive history and drop into the
        // 2-ray tier — more samples on a tracking mean = less boil. Collapses to
        // length(mv) when the camera is still (byte-identical static-settle).
        const float giCamNdc = pc.camRot * 1.7 + 1.7 * pc.camDelta / max(length(worldPos - camPos), 0.25);
        const float capF  = mix(48.0, 6.0, smoothstep(0.002, 0.03, max(length(mv), giCamNdc)));
        const float effPh = min(ph, capF);
        // Tiers 8/3/1 (was 8/4/2): converged static pixels ride 1 ray/frame —
        // the TAA now actually converges statics, so the long-history tier can
        // lean on accumulation instead of fresh rays.
        giSpp = effPh < 4.0 ? 6 : (effPh < 16.0 ? 2 : 1);// 6/2/1 (was 8/3/1): flattens
        // the motion cost spike — a fast pan puts the WHOLE frame in the mid
        // tier, so its ray count dominates frame time exactly when input
        // responsiveness matters most. With the checkerboard halving, the pan
        // tier now costs ~the static tier; the SVGF variance blur carries the
        // slightly higher fresh-pixel noise.
        // CHECKERBOARD: with ≥8 frames of valid history, alternating pixels
        // skip the ENTIRE gather + ReSTIR this frame and carry their
        // accumulated history through — halves the gather cost at EVERY tier
        // (including the expensive motion tiers, which the per-hit cuts
        // didn't touch). Fresh/disoccluded pixels (effPh < 8) always trace,
        // so convergence quality is unchanged where it matters.
        giSkip = ((((px.x ^ px.y) ^ int(pc.frame)) & 1) == 1) && effPh >= 4.0;
    }

    // Diffuse indirect: visibility-gated env irradiance (RT, flags bit 1).
    const bool aoOn = (pc.flags & 2u) != 0u;
    if (!aoOn) giSkip = false;// checkerboard only pays off on the RT gather
    vec3 diffInd;
    if (pc.shadeMode == 1u) {
        // Dispatch B: cheap deterministic fill only — no RT gather, no
        // ReSTIR (both own dispatch-A-exclusive temporal state: the GI
        // accumulator and the reservoir ping-pong). A minority sample's
        // indirect term is a small correction at an edge pixel; the same
        // cost/accuracy call as the inline reflection fold-in above. This is
        // the GI-recombine-albedo approximation documented at the SVGF gate
        // near the end of main().
        // PROBE-GATED like the glass-retrace hit fill (same shape: a point
        // shaded without rays). The raw env fill ignores occlusion, so in an
        // ENCLOSED interior every silhouette's minority sliver carried
        // full-sky irradiance on top of dispatch A's probe-dark surround —
        // invisible outdoors (gated ≈ ungated), but auto-exposure gain on a
        // dark interior amplified it into a lit white rim on every edge
        // (Sponza + MSAA4 + auto-exposure). Saturated-confidence blend, same
        // rationale as the retrace fill: a partially-valid interior
        // neighbourhood is trusted outright; a starved one (conf → 0) means
        // "unmeasured", not "dark" — fall back to the env fill, never black.
        diffInd = sampleEnvLod(N, maxLod) + lights.ambient + hemiAmbient(N);
        if (probeGrid.enabled > 0.5) {
            float bConf;
            const vec3 bFill = probeIrradianceConf(worldPos, N, bConf) * (1.0 / PI);
            diffInd = mix(diffInd, bFill, smoothstep(0.0, 0.25, bConf));
        }
    } else if (giSkip) {
        diffInd = vec3(0.0);// unused — the accumulation below carries history
        // ReSTIR reservoirs PING-PONG (read prev fif, write curr): a skipped
        // pixel must still pass its reservoir through, or next frame's read
        // sees stale data in a checkerboard pattern.
        if ((pc.flags & 8u) != 0u) {
            imageStore(reservoirPosWrite, px, imageLoad(reservoirPosRead, px));
            imageStore(reservoirWWrite,  px, imageLoad(reservoirWRead,  px));
        }
    } else if (aoOn) {
        float openness;
        gGiMovFrac = 0.0;// set by gatherEnv: fraction of GI rays hitting moving geometry
        diffInd = gatherEnv(worldPos, N, px, pc.frame, shadowsOn, demodIndirect, giSpp, openness) + (lights.ambient + hemiAmbient(N)) * openness;
    } else {
        diffInd = sampleEnvLod(N, maxLod) + lights.ambient + hemiAmbient(N);
    }
    // ReSTIR DI emissive area lighting → DEMOD irradiance folded into the diffuse-
    // indirect channel so it rides the SVGF temporal + à-trous denoise (the reservoir
    // converges light selection; this denoises the 1-sample radiance). Added before
    // the demod split so it flows through BOTH the denoise accum path AND the inline
    // (denoise-off) path. restirEmissiveDI also persists this pixel's reservoir.
    if (pc.shadeMode != 1u && !giSkip && (pc.flags & 8u) != 0u) {
        const float rNdotV = max(dot(N, V), 1e-4);
        diffInd += restirEmissiveDI(worldPos, N, rNdotV, F0, shadowsOn);// F0 already iridescence-modulated
    }
    const vec3 diffIndShade = demodIndirect ? vec3(0.0) : diffInd;

    // ── Denoised direct-shadow channel (demod path only) ─────────────────────
    // Split the analytic direct into the exact unshadowed sum U (directUImage)
    // and a 1-2 ray visibility-ratio estimate (accumulated below, filtered +
    // recombined as U × R̃ by deferred_gi_filter). The inline path (denoise off,
    // glass/sheen, dispatch B) keeps the old fully-inline shadowed loops.
    const bool shadowChannel = demodIndirect && shadowsOn;
    vec3  directU = vec3(0.0);
    float visEst  = 1.0;
    bool  sOccMoved = false;// this pixel's shadow (or a subgroup neighbour's) hit a MOVING occluder
    bool  sTopUp    = false;// visEst carries the 16-ray sunShadowVis top-up (cap-1 eligible)
    if (shadowChannel) {
        // Cluster slice by view-space -z (matches cluster_build's AABB axis).
        const float clusterDist = max(-(viewH.z / viewH.w), 0.0);
        gShadowMovingOccluder = false;
        directU = analyticDirectSplit(worldPos, N, V, albedo, roughness, metalness, F0,
                                      pm.sheenColor, pm.sheenRoughness, px, clusterDist,
                                      nSRays, visEst);
        sOccMoved = gShadowMovingOccluder;
        sTopUp    = gShadowSunTopUp;
        gSkipAnalyticDirect = true;// shadeDiffuseDirect: skip dir/point/spot loops
    }

    // Diffuse + direct (shadowed) + emissive-NEE + diffuse indirect + emissive.
    vec3 lit = shadeDiffuseDirect(worldPos, N, V, albedo, roughness, metalness,
                                  emissive, shadowsOn, diffIndShade,
                                  pm.sheenColor, pm.sheenRoughness,
                                  pm.specularIntensity, pm.specularColor,
                                  pm.iridescence, pm.iridescenceIOR, pm.iridescenceThicknessNm, seed,
                                  /*addEmissive=*/((pc.flags & 8u) == 0u),// ReSTIR on → emissive via main()/diffInd; off → coherent emissiveNEE here
                                  /*cheapHit=*/false);// primary: exhaustive lights + full NEE
    gSkipAnalyticDirect = false;// reflection/GI/glass hits below keep inline lights

    // ── Foliage translucency (MaterialWithTranslucency) — RASTER PRIMARY ONLY ──
    // Thin leaf cards transmit the light that reaches their BACK face, so a
    // backlit canopy GLOWS instead of going flat-dark. Per directional (sun)
    // light: a wrapped back-diffuse (peaks with the sun straight behind the leaf)
    // plus a view-dependent forward-scatter halo (looking toward the sun THROUGH
    // the leaf), gated by the SUN'S OWN shadow — plus a small env fill at -N for
    // shaded interiors. Added straight into `lit` (a smooth, low-frequency term
    // that needs no shadow-channel denoise). The demod shadow split
    // (analyticDirectSplit) can't supply this visibility: it only sums the
    // FRONT-lit hemisphere (dot(N,L) > 0) and returns visEst = 1 for exactly the
    // backlit pixels translucency targets, so a shadowed backlit leaf would glow
    // wrongly. One cheap sun shadow ray per translucent pixel is therefore the
    // minimal correct cost — and it is paid ONLY where translucency > 0, so every
    // existing opaque material is byte-for-byte unchanged (no new rays, no term).
    // Ray-hit shading (reflections / GI / lidar / probes) never reaches main(), so
    // those paths are untouched, matching the detail-layer precedent.
    if (pm.translucency > 0.0) {
        const vec3  tCol  = albedo * pm.translucencyColor;
        vec3        tSum  = vec3(0.0);
        for (uint i = 0u; i < lights.dirCount; ++i) {
            const vec3  L    = normalize(lights.dirLights[i].direction);
            const float ndl  = dot(N, L);
            const float back = max(-ndl, 0.0);// sun behind the card
            const float fwd  = pow(max(dot(V, -L), 0.0), kTransScatterPower) * kTransScatterWeight;
            const float w    = back + fwd;
            if (w <= 0.0) continue;
            // Offset toward the LIGHT's side of the card, per light: the back-lit
            // term fires exactly when L is on the -N side, and a +N (camera-side)
            // origin re-crosses the card's own plane at t ≈ EPS/|ndl| — where the
            // cutout alpha test re-samples this fragment's own solid texel and
            // commits: vis was identically 0 and the whole wrapped back-light
            // vanished whenever shadows were on (the backlit canopy read flat).
            const vec3 tOrig = worldPos + ((ndl < 0.0) ? -N : N) * SHADOW_EPS;
            const float vis = shadowsOn
                    ? sunShadowVis(tOrig, L, pc.sunTanHalfAngle, /*cheapHit=*/true)
                    : 1.0;
            tSum += lights.dirLights[i].color * (w * vis);
        }
        // Back-face env fill: sky/env irradiance reaching the shaded underside so
        // canopy interiors are dim, not dead black. Cheap env LOD tap (no rays).
        const vec3 backEnv = sampleEnvLod(-N, maxLod);
        lit += pm.translucency * tCol * (tSum + backEnv * kTransAmbient);
    }

    // Sharp surfaces trace the exact mirror ray; glossy surfaces GGX-importance-
    // sample the reflection lobe so the reflection BLURS with roughness and
    // shows real SCENE geometry — not just the prefiltered environment (the old
    // behaviour, which cut RT reflections off at roughness 0.18 and fell back to
    // env-only). Missed rays read the env at the roughness mip (pre-blurred). A
    // few frame-jittered GGX samples + TAA converge it cleanly on static
    // surfaces; the firefly clamp bounds glossy variance on moving ones. Above
    // ~0.7 roughness the lobe is so wide that prefiltered-env IBL is both
    // cheaper and indistinguishable, so RT bows out there.
    // Specular env strategy: glossy/mirror surfaces (roughness ≲ 0.7) ray-trace
    // real scene geometry (env at the roughness mip on miss); ROUGH surfaces take
    // split-sum env-IBL specular off the PMREM below. The IBL fallback was once
    // dropped because envTex was a plain mip chain (the HDRI sun mirrored as a
    // blocky glare) — but EnvPrefilter has since GGX-prefiltered it (Karis
    // PMREM), so the fallback is restored: without it every matte material had a
    // Fresnel energy hole (rough metals read soot-black under bright HDRIs).
    const vec3  R         = reflect(-V, N);
    const vec2  ab        = envBRDFApprox(NdotV, roughness);
    const float reflBlend = 1.0 - smoothstep(0.55, 0.70, roughness);
    // ONE SHARP MIRROR RAY → the reflection buffer (binding 25). A single ray has
    // NO discrete-GGX ghost copies (the doubled/tripled-object artifact the
    // 8-sample spiral produced) and no per-sample noise. The reflection filter
    // (deferred_refl_filter.comp) then BLURS this by roughness — the spatial blur
    // IS the gloss — and recombines. Pre-weighted by the spec BRDF × reflBlend so
    // the filter just blurs + adds. Glass/sheen reflect inline below (excluded).
    const bool opaqueRefl = (pm.transmission <= 0.0) && (dot(pm.sheenColor, pm.sheenColor) <= 0.0);
    // Rough remainder (1 − reflBlend): split-sum env specular off the GGX PMREM.
    // No visibility term (the standard split-sum caveat) — the traced band keeps
    // true occlusion; this only fills the ≥0.7-roughness matte range where the
    // lobe is wide and prefiltered env is indistinguishable from tracing.
    // PROBE-GI mode: apply SPECULAR OCCLUSION. The un-occluded PMREM lookup is
    // exactly what made enclosed interiors read "lit with no light" — every
    // rough wall received full-sky specular ambient regardless of visibility.
    // The probe field measures the irradiance that ACTUALLY arrives, so its
    // ratio to the unoccluded env irradiance is a smooth, converged local
    // sky-visibility proxy: 1 outdoors (term unchanged), → 0 deep inside an
    // enclosure (the leak dies; the probe-fed gather carries the real light).
    // SHEEN surfaces take this env term too: they're excluded from the traced
    // reflection channel (opaqueRefl, denoiser-channel ownership) but their
    // inline shade (shadeDiffuseDirect + IBL sheen lobe) carries NO base-lobe
    // specular env — a METALLIC sheen fabric (glTF sofa "Fringe": default
    // metallicFactor 1, rough 0.8) has zero diffuse, so it rendered near-black.
    // This add is inline (no channel conflict); transmission keeps its own path.
    // Sheen has no traced band at ANY roughness, so it takes the env term at
    // FULL weight (env-mip gloss stands in for the missing mirror ray);
    // opaqueRefl keeps the usual rough remainder (1 − reflBlend).
    const float envSpecW = opaqueRefl ? (1.0 - reflBlend) : 1.0;
    if (pm.transmission <= 0.0 && envSpecW > 0.0) {
        float envSpecVis = 1.0;
        if (probeGrid.enabled > 0.5) {
            // Pure measured ratio — NO validity-confidence floor. A conf-mix
            // toward 1.0 here re-admitted (1−conf) of the full-sky specular on
            // every interior wall (probes near walls are only partially valid)
            // and measurably re-brightened the Sponza corridors the probe
            // model had fixed. The starved-neighbourhood concern belongs to
            // the glass retrace fill (probeHitFill), not this term.
            const vec3  LUMW   = vec3(0.2126, 0.7152, 0.0722);
            float conf;
            const float actE   = dot(probeIrradianceConf(worldPos, N, conf), LUMW) * (1.0 / PI);
            const float unoccE = dot(sampleEnvLod(N, maxLod), LUMW);
            envSpecVis = clamp(actE / max(unoccE, 1e-5), 0.0, 1.0);
            // …EXCEPT when the neighbourhood measured NOTHING (conf → 0: every
            // trilinear probe invalid — inside geometry — or fully crushed).
            // probeIrradiance then returns black meaning "unmeasured", and the
            // raw ratio read that as "fully occluded": on ≥0.7-rough METALS
            // (diffuse ≡ 0, this env split-sum is their ENTIRE shade) it
            // painted probe-cell-sized black squares on models thinner than a
            // grid cell (glTF AnisotropyStrengthTest / SheenWoodLeatherSofa /
            // RecursiveSkeletons). The steep gate keeps the interior ratio
            // untouched — a wall with ANY valid, visible probe has conf well
            // above 0.1 — and only bails to unoccluded env where nothing
            // measured at all (there the ratio is noise, not signal).
            envSpecVis = mix(1.0, envSpecVis, smoothstep(0.0, 0.1, conf));
        }
        lit += sampleEnvLod(R, roughness * maxLod) * (F0 * ab.x + ab.y) * envSpecW * envSpecVis;
    }
    // ── Emitter-specular ESTIMATOR SPLIT by lobe width ──────────────────────
    // specNEET: 0 = near-mirror (the BRDF ray owns emitter spec — tight lobe hits
    // the emitter every frame, no variance, crisp lamp image), 1 = rough (the
    // coherent emissiveSpecNEE owns it — deterministic, settles instantly; the
    // ray's emitter self-emission is scaled out via gReflEmitterScale so nothing
    // double-counts). The NEE add is faded by reflBlend so emitter spec follows
    // the same ≥0.7-roughness specular cutoff as the rest of the spec model.
    const float specNEET = smoothstep(0.10, 0.25, roughness);
    if (opaqueRefl && reflBlend > 0.0 && specNEET > 0.0 && pc.emissiveCount > 0u) {
        const float kS = (roughness + 1.0) * (roughness + 1.0) / 8.0;
        lit += (specNEET * reflBlend)
             * emissiveSpecNEE(worldPos, N, V, NdotV, F0, roughness, kS, shadowsOn);
    }
    vec3 reflOut = vec3(0.0);
    float reflHitT = -1.0;// reflected-content distance (see the trace below)
    // CHECKERBOARD reflections (OPPOSITE parity to giSkip → an eligible pixel
    // traces exactly ONE indirect channel per frame): with ≥4 frames of usable
    // history, skip the whole traceRadiance chain and HOLD the accumulation.
    // reflReproject's policy vetoes holding under CAMERA motion (near-mirror
    // hard-resets, histCap < 1.5) — but that is NOT the only way a held reflection
    // goes stale. At a STATIC camera reflecting MOVING content (an orbiting lamp /
    // gem, a car driving past a parked mirror) the reproject succeeds, so the held
    // half shows the moving object at its PREVIOUS position while the traced half
    // shows it CURRENT — interleaved every frame into a DOUBLED, offset reflection
    // (plus a visible checkerboard) that the sharp near-mirror blur cannot hide.
    // So only checkerboard the STOCHASTIC/rough reflections (roughness ≥
    // kReflStochastic 0.25): their wide roughness blur absorbs any held/traced
    // alternation, and their GGX trace is where the 2× perf saving actually matters.
    // Near-mirror DETERMINISTIC reflections trace fresh every frame — a single
    // mirror ray, cheap, and stale-hold-free (the cause of the pbr_showcase double).
    bool reflSkip = false;
    if (demodIndirect && reflBlend > 0.0 && opaqueRefl && roughness >= 0.25 &&
        ((((px.x ^ px.y) ^ int(pc.frame)) & 1) == 0)) {
        vec2 rUv; float rCap;
        if (reflReproject(uv, N, roughness, length(worldPos - camPos), rUv, rCap))
            reflSkip = rCap >= 4.0 && texture(reflAuxPrevTex, paneToPhys(reflAuxPrevTex, rUv)).x >= 4.0;
    }
    if (reflBlend > 0.0 && opaqueRefl && !reflSkip) {
        // Emitter self-emission scale for the ray (the other half of the split):
        // (1−specNEET) for EVERYONE — near-mirror keeps the sharp BRDF-sampled
        // lamp image, rough hands the energy to the NEE above. Safe for
        // dielectrics because the scale is nonzero ONLY in the deterministic
        // band (roughness < kReflStochastic — specNEET hits 1 at 0.25): the
        // mirror ray is traced fresh every frame with zero variance, so the
        // stochastic full-radiance speckles the old dielectric→0 rule guarded
        // against cannot occur — the stochastic GGX band has scale 0 either
        // way. The old hard 0 left roughness ≤ 0.10 dielectrics (below the
        // specNEET ramp) with NO owner for emitter specular at all: a
        // lacquered floor reflected a lamp as a dark, unlit object while the
        // same floor at roughness 0.3 showed it — the Fresnel composite
        // already keeps the dielectric's reflected lamp appropriately faint.
        gReflEmitterScale = 1.0 - specNEET;
        // GGX-importance-sample the reflection LOBE — but ONLY where it's WIDE
        // (roughness ≥ kReflStochastic). A NARROW lobe at 1 spp is a spike train
        // on any high-contrast reflected content (a lamp, a tight highlight: hit
        // probability p ≪ 1 per frame → clamped binomial boiling that the narrow
        // low-rough blur correctly refuses to smooth — the "speckles persist
        // below 0.25" band). There the DETERMINISTIC mirror ray is the better
        // estimator: a stable image every frame, with the reflection denoise's
        // roughness-scaled blur AS the gloss (the original design). Where the
        // lobe is wide, the stochastic sample is the better estimator: correct
        // parallax + roughening, low-contrast per sample, wide blur, the SVGF
        // temporal converges it — and emissiveSpecNEE owns emitter spec (the
        // threshold aligns with specNEET's upper edge so the handoff is exact).
        const float kReflStochastic = 0.25;
        uint reflSeed = pcgHash(uint(px.x) + pcgHash(uint(px.y) + pcgHash(pc.frame * 2654435761u + 7u)));
        // MOTION proxy (mirrors reflReproject's mvLen: screen-space surface
        // motion OR camera world motion) — drives the miss-LOD floor and the
        // radiance clamp below. It USED to also swap the GGX sample for the
        // deterministic mirror ray while moving (the boil guard for a SCREEN-
        // stationary, WORLD-moving glossy panel whose short history never
        // converged the 1-spp lobe). That made every rough metal a MIRROR
        // whenever the camera moved: the gloss filter's widening is driven by
        // history length and residual variance, and a 1-frame deterministic
        // history has neither, so a roughness-0.4 steel bed showed a crisp
        // reflection of the object on it during an orbit and relaxed to its
        // glossy self over the next 16 frames at rest — two different
        // materials depending on whether you were dragging. The rough band
        // now keeps the stochastic sample in BOTH states (same estimator, so
        // stopping is a seamless convergence, not a material change) and the
        // gloss filter widens to the lobe while history is short
        // (deferred_refl_filter.comp, stochT); the motion-path clamp below
        // bounds the bright-source speckle that the guard worried about.
        const vec2  reflMv     = texture(gbufMotionTex, paneToPhys(gbufMotionTex, uv)).rg;
        const float reflCamNdc = pc.camRot * 1.7 + 1.7 * pc.camDelta / max(length(worldPos - camPos), 0.25);
        const bool  reflMoving = max(length(reflMv), reflCamNdc) > 0.004;
        // Ray-miss env LOD: the roughness-blurred PMREM mip — FLOORED while
        // MOVING. On the moving path the deterministic mirror ray reads the env
        // near-sharp while the reflection history is collapsed (1-6 frames), so
        // an HDRI sun texel arrives at full radiance with nothing to average
        // it; the clamp below only caps the spike, leaving clamp-bright "dust"
        // sweeping across curved surfaces. Two extra mips spread the sun over
        // ~16× the texels (each ~16× dimmer) exactly while the history can't
        // converge; a settled view re-sharpens. Scaled in by roughness so true
        // mirrors (roughness < 0.02) keep their exact sharp reflection.
        const float missLod = max(roughness * maxLod,
                                  reflMoving ? min(2.0, maxLod) * smoothstep(0.02, 0.10, roughness)
                                             : 0.0);
        vec3 Rd = (roughness < kReflStochastic)
                      ? R : sampleGGXReflection(V, N, roughness, reflSeed);
        // BELOW-HORIZON guard: plain NDF sampling (no VNDF) reflects under the
        // surface for a good fraction of samples at grazing view / high roughness.
        // Those rays start at shadowOrig pointing INTO the surface → graze the
        // backside / floor at epsilon distance → dark+erratic samples = grain that
        // no amount of denoising should have to absorb. Mirror fallback matches
        // the bounce-continuation guard inside traceRadiance.
        if (dot(Rd, N) <= 0.0) Rd = R;
        vec3 r = traceRadiance(shadowOrig, Rd, shadowsOn, maxLod, missLod, reflSeed,
                               /*cheapHits=*/true,// reflection channel: blur+temporal absorb
                               /*probeHitFill=*/true);
        // SPLATS IN THE MIRROR, glossy path — the water/glass legs' block
        // (deferred_shade_50_water_glass.glsl:113), verbatim on this path's own
        // ray and hit: the traced leg cannot see a SplatCloud (composited AFTER
        // this shade), so the baked volume stands in for it. BEFORE the
        // roughness clamp on purpose — the splat is reflected CONTENT, and a
        // bright cloud takes the same anti-speckle ceiling as a bright sun
        // texel. gTraceHitT is read before reflHitT latches it, and svLeg
        // leaves it untouched.
        if ((pc.flags & 4096u) != 0u) {
            vec3 svEmis;
            const float svT = svLeg(shadowOrig, Rd, gTraceHitT > 0.0 ? gTraceHitT : 1e30, svEmis);
            r = r * svT + svEmis;
        }
        // Reflected-content distance for the denoiser's gloss-blur footprint:
        // env miss → 0 (already lobe-filtered via missLod — no extra blur),
        // geometry hit → its distance.
        reflHitT = max(gTraceHitT, 0.0);
        gReflEmitterScale = 1.0;
        // Roughness-aware reflection clamp (moving path only). A glossy surface
        // integrates a bright point source — the sun, a sky-gap between trees —
        // over its WHOLE BRDF lobe, so the peak is spread thin and dim. A SETTLED
        // surface's temporal lobe does that for free; while MOVING the history is
        // short and a single sample (mirror ray below 0.25, or a 1-spp GGX sample
        // that happens to hit the source) carries it at FULL radiance, which the
        // gloss blur only smears into a bright BLOB / speckle (the "env-map-probe"
        // speckles on the moving car / floor). Cap toward a glossy ceiling as
        // roughness rises: near-mirror keeps the loose clamp (a sharp bright sun
        // reflection IS correct); glossy paint dims bright sources to a
        // lobe-appropriate peak. min() never loosens a tighter user fireflyClamp
        // and stays 1e30-sentinel-safe; moving-only so the settled lobe integral
        // stays unbiased.
        const float reflClamp = reflMoving
                ? min(pc.fireflyClamp, mix(30.0, 4.0, smoothstep(0.05, 0.30, roughness)))
                : pc.fireflyClamp;
        const float rl = max(max(r.r, r.g), r.b);
        if (rl > reflClamp) r *= reflClamp / rl;
        reflOut = r * (F0 * ab.x + ab.y) * reflBlend;
    }
    if (pc.shadeMode == 1u) {
        // Dispatch B: fold the reflection term in INLINE (no reflSVGFTemporal —
        // that's a cross-frame temporal accumulator keyed to the dominant-
        // sample reflectImage channel; dispatch A owns it exclusively). The
        // minority sample's reflection is a small correction at an edge
        // pixel, not a full BRDF-lobe integral — inline-and-move-on is the
        // right cost/accuracy tradeoff here.
        lit += reflOut;
    } else if (demodIndirect) {
        // Denoise ON: temporally AA the sharp reflection, then hand it to the
        // roughness-blur denoise pass. (Matte pixels run this too with cur=0 —
        // keeping their history alive through per-frame roughness-map
        // classification flips; the moving-mesh ID guard inside reflReproject
        // is what keeps a moving glossy object's reflection from leaking into
        // the matte ground it just vacated. A hard zero-store here instead
        // cold-restarted every straddling pixel = "the car blinks".)
        imageStore(reflectImage, px, reflSVGFTemporal(vec4(reflOut, roughness), px, uv, N, length(worldPos - camPos), reflSkip, reflHitT, gTraceHitMoved));
    } else {
        // Denoise OFF (or glass/sheen, where reflOut==0): inline sharp reflection.
        lit += reflOut;
        imageStore(reflectImage, px, vec4(0.0));
    }

    // ── Refractive glass (any transmissive surface that ISN'T the ocean) ──────
    // Ocean water returned far above. Everything else with transmission — closed
    // glass (spheres/bottles) AND thin-walled glass (glTF glass with no
    // KHR_volume, the common case) — BLENDS a Fresnel reflect+refract glass look
    // over the opaque shade, weighted by `transmission` (matches the path
    // tracer's reflect/refract-vs-opaque split in expectation: transmission=1 →
    // pure glass; 0.8 → 80% glass + 20% the opaque PBR above). shadeGlass does
    // the 2-interface refraction either way (a thin shell just has a short
    // in-glass path → minimal tint → near-clear).
    // Dispatch B skips the additive/alpha-blend/glass refinement entirely —
    // all three re-trace a full radiance path (traceRadiance/shadeGlass) and
    // the glass branch also owns a reflectImage temporal slot exclusively
    // via reflSVGFTemporal (dispatch-A state). A minority sample landing on
    // transmissive geometry at an edge keeps dispatch A's dominant-sample
    // result — same as the pre-Phase-2 (msaa=1) behaviour for that pixel,
    // not a regression, just an untreated edge on (rare) glass/blend props.
    if (pc.shadeMode != 1u) {
        if (pm.transmission > 1.0) {
            // ADDITIVE blend (muzzle flashes, sparks, energy glows). The surface
            // GLOWS over the scene behind: dst = behind + src*strength. The opaque
            // G-buffer already overwrote the scene behind this pixel, so re-trace a
            // straight (-V) ray to recover it. Host encodes strength = transmission-1
            // (transmission>1 is the additive marker).
            const float strength = clamp(pm.transmission - 1.0, 0.0, 1.0);
            gEnvFillVis = probeEnvFillVis(worldPos, N, maxLod);// surface sky visibility for the env hit fill
            const vec3  behind   = traceRadiance(worldPos - V * SHADOW_EPS, -V, shadowsOn, maxLod, 0.0, seed,
                                                 /*cheapHits=*/false,// straight into lit, unblurred
                                                 /*probeHitFill=*/false);// content behind a blend surface
            lit = behind + lit * strength;
        } else if (pm.transmission > 0.0) {
            if (pm.ior < 1.05) {
                // CLEAN ALPHA blend (transparent, opacity<1; host sets ior=1,
                // transmission=1-opacity). Straight-through to the re-traced scene
                // behind, blended by opacity — flat alpha, NO glass Fresnel/refraction
                // darkening. (One transparent layer over opaque: the behind ray sees
                // opaque geometry shaded as PBR; overlapping transparent isn't sorted.)
                const float opacity = 1.0 - clamp(pm.transmission, 0.0, 1.0);
                gEnvFillVis = probeEnvFillVis(worldPos, N, maxLod);// surface sky visibility for the env hit fill
                const vec3  behind  = traceRadiance(worldPos - V * SHADOW_EPS, -V, shadowsOn, maxLod, 0.0, seed,
                                                    /*cheapHits=*/false,// straight into lit, unblurred
                                                    /*probeHitFill=*/false);// content behind a blend surface
                lit = mix(behind, lit, opacity);
            } else {
                // REAL refractive glass (ior>1). ONE sharp Fresnel reflect+refract
                // sample (no ghost copies); the reflection denoise blurs it by the glass
                // roughness (the frost) + recombines — same channel as opaque reflections.
                const float gt       = clamp(pm.transmission, 0.0, 1.0);
                const vec3  glassCol = shadeGlass(worldPos, N, V, pm, albedo, shadowsOn, maxLod, seed);
                if (denoiseOn) {
                    // Demodulate the mix(): hand glassCol·t to the reflection denoise
                    // (which ADDS blur(reflect)) and scale the opaque base by (1-t), so
                    // the recombine reconstructs mix(lit, blur(glass), t) — frosted.
                    // Same clamped roughness as shadeGlass (see kGlassMaxRough) so the
                    // denoise blur matches the lobe that produced the sample.
                    const float gr = glassRough(pm.roughness);
                    // .a NEGATIVE = glass marker: the denoise gives it a minimum AA blur
                    // + an ID-based (not normal) edge stop so the blur smooths ACROSS the
                    // curved surface — refraction is far more normal-sensitive than
                    // reflection, so 1 ray aliases into blocky speckles without it.
                    imageStore(reflectImage, px, reflSVGFTemporal(vec4(glassCol * gt, -gr), px, uv, N, length(worldPos - camPos), /*hold=*/false, /*hitT=*/-1.0, /*hitMoved=*/gTraceHitMoved));// glass: full rate (refraction aliases at half)
                    lit = lit * (1.0 - gt);
                } else {
                    lit = mix(lit, glassCol, gt);// denoise off → inline (sharp, no frost)
                }
            }
        }
    }

    // Volumetric spot/directional scatter is a per-PIXEL view-ray integral
    // (independent of which G-buffer sample "won" that pixel) — dispatch A
    // already added it once; dispatch B must NOT add it again (would double-
    // count the beam/aerial contribution at every complex pixel). Fog
    // extinction, in contrast, multiplies the surface radiance itself
    // (different per sample's worldPos/albedo), so both dispatches apply it
    // to their own `lit`.
    // Surface extinction. HETEROGENEOUS air medium (scene.fog / setHeightFog):
    // from the froxel LUT (per-slice height-fog σ) + closed-form beyond 512 m; the
    // in-scatter is added below via froxelInscatter. The vestigial homogeneous
    // branch runs only when no medium is present (a no-op then). The underwater
    // murk (below-surface leg) composes on top; the beam march carries its own
    // extinction either way.
    {
        const float distL = length(worldPos - camPos);
        lit = applyParticleFog(
                      applyMurk((clouds.heteroActive > 0.5)
                                ? applyHeteroSurfaceFog(lit, uv, distL, camPos, worldPos)
                                : applySceneFog(lit, camPos, worldPos), camPos, worldPos),
                      camPos, (worldPos - camPos) / max(distL, 1e-6), distL);
    }
    if (pc.shadeMode == 1u) {
        // Dispatch B: weighted accumulate into dispatch A's already-written
        // pixel (which stored domWeight*lit for the SAME complex pixel — see
        // domWeight above; domWeight + msWeight sums the K samples' cluster
        // populations back to exactly K/K = 1.0 for the 2-cluster case).
        // Safe read-modify-write — dispatch B is the ONLY writer at this
        // point for complex pixels (dispatch A finished and barriered before
        // dispatch B starts), and each pixel is touched by exactly one
        // invocation, so there's no cross-invocation race.
        const vec3 base = imageLoad(outImage, px).rgb;// already pre-exposed by dispatch A
        // Dispatch A composited the cloud layer over its (coverage-weighted)
        // result — this minority sample sits behind the same cloud, so its add
        // must carry the cloud TRANSMITTANCE too (not the in-scatter: dispatch
        // A already added that once). Without it, complex pixels under cloud
        // grow a bright unattenuated geometry rim.
        float cloudMeanDistUnused;
        const float cloudT = (clouds.enabled > 0.5)
                ? cloudGather(px, length(worldPos - camPos), cloudMeanDistUnused).a : 1.0;
        // The waterline band applies to this minority sample too — but only its
        // MULTIPLICATIVE half (tintScale 0): dispatch A already added the murk-
        // colour pull once for this pixel, and the two adds would double it.
        imageStore(outImage, px, vec4(base + applyMeniscus(lit * (msWeight * cloudT * uintBitsToFloat(pc.preExpBits)), 0.0), 1.0));
    } else {
        // Dispatch A: at a complex pixel, scale down by the dominant
        // cluster's population fraction and blend the SKY minority's
        // coverage right here (sky is a background colour — no per-sample
        // shading needed; this is what anti-aliases every silhouette
        // against the sky). Simple pixels and msaa=1 keep domWeight==1,
        // skyEdgeW==0 — byte-identical to the pre-MSAA output.
        vec3 outC = lit * domWeight;
        if (skyEdgeW > 0.0) outC += skyEdgeW * skyBackground(ndc, camPos);
        // DEPTH-AWARE cloud layer: march camera→surface and composite the cloud
        // in-scatter/extinction in FRONT of the terrain (a drone above the deck
        // sees clouds between it and the ground). tSceneMax = surface distance
        // clips the march at the G-buffer depth. No-op when clouds are off.
        outC = compositeClouds(outC, px, length(worldPos - camPos));// depth-aware cloud layer in front of the terrain
        // Volumetric in-scatter is a per-PIXEL view-ray integral, independent
        // of which G-buffer sample won — add it ONCE at FULL weight AFTER the
        // coverage weighting. (It used to be folded into `lit` before the
        // domWeight scale, which silently dimmed the beams/aerial glow by the
        // minority coverage at every edge pixel — a dark fringe in fog.)
        outC += froxelInscatter(uv, max(-(viewH.z / viewH.w), 0.0))// clustered point-light glow
              + volumetricSpotScatter(camPos, -V, length(worldPos - camPos), px)// crisp spot beams
              + volumetricDirScatter(camPos, -V, length(worldPos - camPos), px)// sun shafts / aerial glow
              + murkSunScatter(camPos, -V, length(worldPos - camPos), px);// the same, through water
        imageStore(outImage, px, vec4(applyMeniscus(outC * uintBitsToFloat(pc.preExpBits),
                                                    uintBitsToFloat(pc.preExpBits)), 1.0));
    }
    // Dispatch B never touches the GI/SVGF accumulator channels (indirect/
    // momentsImage) — those are dispatch-A-exclusive temporal state keyed to
    // the DOMINANT sample; a minority sample writing a second, DIFFERENT
    // "current" value into the same pixel's accumulator would corrupt next
    // frame's history for every consumer (denoise, GI reproject). This is
    // the GI-recombine-albedo approximation noted in the MSAA plan: complex
    // pixels' indirect lighting is entirely the dominant sample's — a static
    // bias at edges, not fixed in this pass.
    if (pc.shadeMode == 1u) return;

    // SVGF TEMPORAL stage for the demod GI — now with REPROJECTION (kills motion
    // ghosting). Read the 1-frame GI history (the OTHER fif index, giPrevTex) at
    // the MOTION-REPROJECTED pixel, exp-moving-average the current stochastic GI
    // into it with a history-length α (1/histLen → converged pixels barely change),
    // and write the result for the denoise + next frame. DISOCCLUSION RESET: if the
    // reprojected pixel is off-screen OR its prev mesh-ID ≠ this surface's, the
    // history is stale → start fresh (α=1) so a moving / newly-revealed surface
    // doesn't drag a ghost. NaN-guard the feedback. Motion convention matches
    // taa_resolve exactly.
    if (demodIndirect) {
        const vec2 motionGL = texture(gbufMotionTex, paneToPhys(gbufMotionTex, uv)).rg;
        const vec2 currNDC  = vec2(uv.x * 2.0 - 1.0, -(uv.y * 2.0 - 1.0));
        const vec2 prevNDC  = currNDC + motionGL;
        const vec2 prevUv   = vec2(prevNDC.x * 0.5 + 0.5, 0.5 - prevNDC.y * 0.5);
        bool valid = all(greaterThanEqual(prevUv, vec2(0.0))) &&
                     all(lessThanEqual(prevUv, vec2(1.0)));
        // Per-instance ids texel: .y = stable per-object id (trailing-edge
        // guard below), .z = flag bits (double-sided normal test + the
        // persistent-deformer history cap at the bottom of this block).
        const uvec4 giIds = (msSampleIdx >= 0) ? texelFetch(gbufIdsMS, px, msSampleIdx)
                                               : texelFetch(gbufIdsTex, px, 0);
        const uint giFlagsZ = giIds.z;
        // GEOMETRIC (normal-based) JITTER-ROBUST DISOCCLUSION: the current surface's
        // world normal must match SOMEWHERE in the 3×3 prev-normal neighbourhood at
        // the reprojected pixel. Normals are draw-order-INDEPENDENT (so firing —
        // which spawns a tracer and renumbers every instanceCustomIndex — does NOT
        // false-reset, the bug an ID test had) AND camera-INDEPENDENT (so camera
        // motion doesn't false-reset). The 3×3 absorbs the sub-pixel jitter coverage
        // flip; a MOVING object that vacated this pixel reveals a differently-facing
        // surface → no match → reset → the stale GI is cleared instead of trailing
        // as a "dust cloud".
        if (valid) {
            const ivec2 ip = ivec2(prevUv * vec2(float(pc.width), float(pc.height)));
            const ivec2 mx = ivec2(int(pc.width), int(pc.height)) - 1;
            // DOUBLE-SIDED surfaces (ids flags bit 4): the raster flips N to
            // face the viewer, so on cutout foliage the jittered coverage
            // flips a pixel's normal SIGN frame to frame — a signed test then
            // cold-starts the GI history EVERY frame (1-spp boil across a
            // tree canopy, read as "flickering shadows"; single-siding the
            // leaves measured 8× less frame-to-frame diff). ±N is the same
            // surface for irradiance-history purposes, so compare
            // orientation-agnostically. Single-sided geometry keeps the
            // signed test (a wall's two faces ARE different surfaces).
            const bool dsided = ifDoubleSided(giFlagsZ);
            // JOINT normal+depth neighbourhood test. The depth check is the
            // primary disocclusion (a view-Z jump = a different surface — kills
            // the object-trail "dust" a normal test alone leaves), but sampled
            // at a SINGLE texel it alternates valid/invalid with the sub-pixel
            // jitter at every DEPTH EDGE (road-ribbon edges over their cut
            // bench, silhouettes, grazing relief): the reproject rounds onto
            // the neighbouring surface every other frame, resetting the GI
            // history → permanent 1-spp edge flicker on ALL backends (measured
            // p99 26/255 at a static converged camera; the exact mechanism of
            // the "everything shakes" reports). So ask the same question the
            // normal test already asks, jointly, over the 3×3: was THIS
            // surface (normal AND my own prev view-Z) anywhere in the
            // reprojected neighbourhood last frame? A truly vacated pixel has
            // no matching texel → still resets; a jitter-rounded edge finds
            // its surface one texel over → history survives.
            const float surfD = texture(gbufMotionTex, paneToPhys(gbufMotionTex, uv)).b;// this surface's prev NDC depth
            const vec4  svh   = cam.projInverse * vec4(prevNDC, surfD, 1.0);
            const float svz   = svh.z / svh.w;
            bool found = false;
            for (int dy = -1; dy <= 1; ++dy) {
                for (int dx = -1; dx <= 1; ++dx) {
                    const ivec2 tp = clamp(ip + ivec2(dx, dy), ivec2(0), mx);
                    const vec3 pn = texelFetch(gbufNormalPrevTex, tp, 0).xyz * 2.0 - 1.0;
                    float nd = dot(N, normalize(pn));
                    if (dsided) nd = abs(nd);
                    if (nd <= 0.0) continue;// reject only GROSS (>90°) flips: a 45°
                                            // threshold false-reset every frame on
                                            // sloped/detail-normal terrain (jittered
                                            // shading normal aliases past 45°) →
                                            // distant-terrain boil. >0 still catches
                                            // a wall's opposite face; depth (below)
                                            // does the real surface discrimination.
                    const float bufD = texelFetch(gbufDepthPrevTex, tp, 0).x;
                    const vec4  bvh  = cam.projInverse * vec4(prevNDC, bufD, 1.0);
                    if (abs(svz - bvh.z / bvh.w) <= 0.1 * max(abs(svz), 1e-3)) found = true;
                }
            }
            valid = found;
            // MOVING-MESH TRAILING-EDGE GUARD: the joint test above is deliberately
            // permissive ("was my surface ANYWHERE in the 3×3?") and its depth
            // tolerance is RELATIVE (10% of view-Z) — a low-profile moving object
            // over ground (car over road: Δz≈1.2 m at 14 m view-Z → tolerance 1.4 m;
            // feet over floor: Δz≈0.2 m) passes BOTH gates at its trailing edge, so
            // the bilinear giPrevTex read blends the departed object's bright/dark
            // GI history into the revealed ground = the "history edge smear" behind
            // every moving car / the character's dust-trail feet. The ID compare is
            // exact where depth is proportionally blind. Compares the STABLE
            // per-object id (.y) and reads the prev texel's OWN moved-sticky bit
            // (.z, kInstFlagMoving, stamped at draw time) — both identity-stable —
            // NOT prev ids .x, which indexes the PREV frame's draw list and names
            // the wrong entry in geoms[] after any topology renumber (terrain tile
            // streaming removes a parent mid-list every few frames; the old
            // geoms[pid-1] read went stale or out of range for the whole burst).
            // Static scenes can't fire this (no moved bit), and a static tile
            // swap keeps history because the departed parent was never moving.
            // All 4 texels of the history read's bilinear footprint are checked —
            // the snap texel alone leaves a 1-px bleed.
            if (valid) {
                const vec2  fpx = prevUv * vec2(float(pc.width), float(pc.height)) - 0.5;
                const ivec2 fb  = ivec2(floor(fpx));
                // Fire on OBJECT motion (prev texel's moved bit) or CAMERA
                // TRANSLATION (pc.camDelta): parallax past a STATIC occluder
                // (tree, pole) reveals ground with no moved bit anywhere, and
                // the depth/normal gates are proportionally blind at driving
                // distances — before the identity-stable ids, the global
                // topology resets were accidentally masking this leak (history
                // never lived long enough to smear); now the id mismatch IS a
                // true surface change whenever the camera actually moved.
                // Pure rotation reprojects exactly (no parallax) and stays
                // lenient, so static contact edges don't churn.
                const bool camMoved = pc.camDelta > 0.001;
                for (int dy = 0; dy <= 1 && valid; ++dy)
                    for (int dx = 0; dx <= 1 && valid; ++dx) {
                        const uvec4 pids = texelFetch(gbufIdsPrevTex, clamp(fb + ivec2(dx, dy), ivec2(0), mx), 0);
                        // Prev-SKY texels (.x == 0) are not "safe": sky pixels
                        // stop accumulating, so their history holds whatever
                        // surface last covered the texel — with history now
                        // surviving topology changes, that can be many frames
                        // old. A camera translating past a feathery silhouette
                        // (fjord trees: most canopy pixels have mixed tree/sky
                        // footprints) kept blending that STALE canopy back in —
                        // the subtle "smooshing" on trees under motion. Reject
                        // sky-footprint texels when the camera moved; a static
                        // camera keeps its converged edge mix (same texel, same
                        // blend, every frame — rejecting there would just make
                        // silhouettes permanently noisy).
                        const bool skyStale = pids.x == 0u && camMoved;
                        const bool objChange = pids.x > 0u && pids.y != giIds.y && (ifMoving(pids.z) || camMoved);
                        if (skyStale || objChange) valid = false;
                    }
            }
        }
        // Checkerboard carry: prefer the reprojected history; if this skip-
        // frame pixel's reproject fails (rare gate mismatch), carry the
        // same-pixel history rather than cold-starting on no data.
        const vec4  prevT = valid ? texture(giPrevTex, paneToPhys(giPrevTex, prevUv))
                                  : (giSkip ? texture(giPrevTex, paneToPhys(giPrevTex, uv)) : vec4(0.0));
        const vec3  prev  = prevT.rgb;
        valid = valid && all(lessThan(abs(prev), vec3(1e6)));// NaN/garbage guard
        // fp16-SAFE clamp on the NEW sample: indirect + the à-trous ping-pongs
        // are rgba16f (max 65504) and NOT pre-exposed (pre-exposure applies at
        // the sceneHdr store). Physical light units (sun in klux) push the
        // demodulated indirect past that — an unclamped accumulate stores Inf,
        // the |prev| guard above then resets the history EVERY frame (permanent
        // 1-frame GI = flicker) and E[L²]−E[L]² turns the SVGF variance NaN.
        // Radiance this hot is beyond any exposure the tonemapper meets, so
        // the clamp is visually free; prev ≤ the same bound by induction.
        diffInd = min(diffInd, vec3(6.5e4));
        // MOTION-SCALED temporal cap: a fixed cap can't be both clean (static needs
        // a LONG history to average the 1-spp noise) and lag-free (motion needs a
        // SHORT one, else the slow running mean trails the camera/object as a
        // "cloud"). Scale the cap by the motion-vector magnitude — static pixels
        // keep the long clean history; moving pixels get a short responsive one.
        // Temporal analogue of the TAA velocity bump: decouples static cleanliness
        // from motion lag (so we don't have to trade one for the other).
        // Same camera-world-motion term as the adaptive-tier cap above (:2607): a
        // screen-static / world-moving surface (chase-cam car paint) must NOT pin
        // its history at 48 and chase a non-stationary GI integrand — fold in the
        // camera world flow so it tracks. Collapses to length(motionGL) when the
        // camera is still.
        const float giCamNdc = pc.camRot * 1.7 + 1.7 * pc.camDelta / max(length(worldPos - camPos), 0.25);
        // IRRADIANCE-REACTIVE content (sources + channel semantics:
        // instance_flags.glsl — today: persistent per-frame deformers): the
        // surface deforms EVERY frame, so |motionGL| swings across the
        // smoothstep window with the wobble and the motion-scaled cap
        // oscillates with it — dragging the blend alpha, the despeckle gate
        // (histLen<8) and the variance fallback (histLen<4) along. That reads
        // as per-frame pumping on soft bodies even at a steady frame rate.
        // Pin a CONSTANT cap instead — the pumping came from the OSCILLATION,
        // not from which gates are active. 6 sits INSIDE the despeckle range
        // (histLen<8) so the outlier clamp runs steadily — a persistently-
        // deforming 1-spp surface sheds isolated GI sparks every frame and
        // NEEDS it (pinning at 10 disabled it: visible white speckle on soft
        // bodies) — while staying above the spatial variance fallback (4).
        // mix() on the [0..1] reactivity: exact motion-scaled cap at 0; at 1
        // the pin may sit an ULP off 6.0 — both gates have miles of margin.
        const float capF = mix(mix(48.0, 6.0, smoothstep(0.002, 0.03, max(length(motionGL), giCamNdc))),
                               6.0, ifIrradianceReactivity(giFlagsZ));
        // CONTENT-CHANGE TREND ANTILAG (moments .g) — the reflection/shadow
        // channels' mechanism, applied to the GI accumulator (previously the only
        // temporal channel WITHOUT one). The receiver's motion vectors can't see a
        // MOVING OCCLUDER or a moving bounce source: ground the car just vacated
        // reprojects "valid" while its accumulated gather is stale (the car's
        // contact darkening / body bounce), so a long motion cap drags it as a
        // dark/bright smear trailing the object (worst on near-screen-static
        // ground in a chase cam, cap up to 48). Zero-mean 1-spp boil ALTERNATES
        // around the mean (trend EMA → ~±0.2, no collapse); real content change
        // pushes the SAME direction every frame (EMA → ±1) → cap collapses to 3 →
        // the mean tracks the change in a few frames. Same smoothstep window as
        // the reflection channel's trendCap.
        // σ-NORMALISED deviation: the raw brightness-relative sdev treats a
        // pixel's EXPECTED sampling fluctuation as content change. ReSTIR DI
        // rides this channel as a 1-SAMPLE radiance whose visibility discards
        // produce dark-frame RUNS (not zero-mean alternation!) near occluders —
        // the raw sdev trended on them, collapsed the cap to 3, and the
        // denoiser could no longer smooth ReSTIR at all: permanent boil on the
        // Bistro lamp walls (bisected: pre-antilag beac67b5 clean). The channel
        // already stores its own E[L²] (moments .r), so measure the deviation
        // against the accumulated σ: a high-variance pixel (1-spp emitter
        // sampling) gets a proportionally larger deadband — its flicker reads
        // as noise — while a converged smooth pixel (chase-cam road) has σ≈0
        // and keeps the antilag's full sensitivity. Worst case (σ stays large)
        // a real content change degrades to the pre-antilag cap-48 fade — the
        // exact behaviour the clean bisect reference had.
        const float curLum  = dot(diffInd, vec3(0.2126, 0.7152, 0.0722));
        const float prevLum = dot(prev, vec3(0.2126, 0.7152, 0.0722));
        const vec2  prevM   = valid ? texture(momentsPrevTex, paneToPhys(momentsPrevTex, prevUv)).rg
                                    : (giSkip ? texture(momentsPrevTex, paneToPhys(momentsPrevTex, uv)).rg : vec2(curLum * curLum, 0.0));
        const float prevTr  = prevM.g;
        const float prevSig = sqrt(max(prevM.r - prevLum * prevLum, 0.0));
        const float sdev    = clamp((curLum - prevLum) / (0.05 + 0.25 * max(curLum, prevLum) + 2.0 * prevSig), -1.0, 1.0);
        const float trend   = giSkip ? prevTr : mix(prevTr, sdev, 0.34);// ~3-frame EMA
        float capTr         = mix(capF, 3.0, smoothstep(0.45, 0.9, abs(trend)));
        // MOVING-CONTENT dwell cut (see gGiMovFrac decl): while this pixel's
        // gather sees moving geometry, its irradiance is attached to the mover,
        // not the surface — keep the history shallow so nothing is left to smear
        // when the mover departs. Statistics-free where the trend (drowned by
        // 1-spp gather noise) limps. The adaptive-spp tier reads the short
        // history and supplies extra rays here (rays-follow-short-history).
        // RELEASE with hysteresis: the dwell pin (histLen ≤ 3) doubles as the
        // "was under moving content" marker — hold the short-history regime
        // until the reprojected history agrees with the fresh gather (|sdev|
        // gate; adaptive-spp gives these short-history pixels extra rays, so
        // the comparison isn't 1-spp flicker), then let history regrow. Kills
        // both the harmonic dark tail the growing histLen left behind a
        // departing occluder AND the cap-regime stutter of a per-frame noisy
        // flag.
        const bool giRelease = valid && prevT.a <= 3.5 && abs(sdev) > 0.5;
        if (gGiMovFrac > 0.1 || giRelease) capTr = min(capTr, 3.0);
        // Skip frames carry the history UNCHANGED (no new sample → no histLen
        // increment, no blend); trace frames accumulate as before.
        const float histLen = giSkip ? max(prevT.a, 1.0)
                            : (valid ? min(prevT.a + 1.0, capTr) : 1.0);
        const vec3  accum   = giSkip ? prevT.rgb
                            : (valid ? mix(prev, diffInd, 1.0 / histLen) : diffInd);
        imageStore(indirectImage, px, vec4(accum, histLen));

        // SVGF second moment E[L²] of the indirect luminance — accumulated with the
        // SAME reproject + α, so the denoiser can form the TEMPORAL variance
        // var = E[L²] - lum(accum)². A stable edge has low temporal var (preserve →
        // crisp); flickering 1-spp noise has high var (blur → clean). E[L] needs no
        // storage: luminance is linear, so lum(accum) (the running-mean GI's luma)
        // IS the running-mean luminance E[L].
        const float prevSq = prevM.r;// fetched with the trend (.rg) above
        const float accSq  = giSkip ? prevSq : mix(prevSq, curLum * curLum, 1.0 / histLen);
        imageStore(momentsImage, px, vec4(accSq, trend, 0.0, 0.0));

        // ── Shadow-ratio temporal accumulation ───────────────────────────────
        // Same reproject + disocclusion gates as the GI above (prevUv/valid are
        // exactly the surface-identity tests the ratio needs). Two extra
        // history cuts the GI doesn't have:
        //   • TREND antilag (.w): the receiver's motion vectors can't see a
        //     MOVING OCCLUDER, so a shadow sweeping across a static floor
        //     reprojects "valid" and a long EMA would trail it as a smear.
        //     Consistent same-sign deviations (visEst vs the running mean)
        //     accumulate in a ~3-frame EMA; zero-mean sample noise cancels.
        //     A firing trend collapses the cap → the mean tracks the edge.
        //   • The motion-scaled cap (same term as the GI) for camera/receiver
        //     motion. Static, settled penumbras keep the long clean history.
        if (shadowChannel) {
            // EDGE-AWARE 4-TAP (2×2) HISTORY FETCH — replaces the old history
            // fetch's single-texel snap. NOTE: shadowVisPrevTex (like giPrevTex/
            // gbufNormalPrevTex/gbufDepthPrevTex) is bound through gbufSampler_,
            // which this pass creates NEAREST (DeferredShade.cpp ~line 46: "the
            // shader uses texelFetch, sampler ignored, still required") — so the
            // OLD `texture(shadowVisPrevTex, prevUv)` was already a nearest snap,
            // not hardware bilinear. Under motion prevUv drifts continuously, and
            // at a shadow boundary the nearest-neighbour rounding OCCASIONALLY
            // snaps a shadowed pixel onto a LIT neighbour's full history value
            // (R̃≈1) instead of its own — a 100%-weight contamination event that
            // frame (vs. a small blended sliver), which then compounds through
            // the EMA frame after frame (measured up to 7.5× at deep-shadow
            // pixels). Manually gather the 4 integer-texel neighbours with their
            // bilinear proximity weights so a genuine sub-pixel reproject blends
            // a SMALL, bounded fraction of a neighbour instead of an all-or-
            // nothing snap, then edge-stop each tap two ways before accepting it:
            //   1) GEOMETRIC consistency — same predicates/thresholds as the GI
            //      reproject above (depth-plane test via cam.projInverse, normal
            //      dot with the same double-sided abs(dot) handling) — this is
            //      what the GI reuses to reject a tap that landed on a DIFFERENT
            //      surface (disocclusion / silhouette crossing).
            //   2) VALUE-range consistency — geometry alone can't separate "same
            //      floor, different shadow state" (a penumbra boundary on a flat
            //      surface has NO depth/normal discontinuity to key off). The
            //      spatial à-trous filter below (deferred_gi_filter.comp:
            //      `wlS = exp(-abs(cS.x - sqS.x) / visPhi)`) already range-
            //      stops this exact ratio signal by its own temporal variance —
            //      reused here verbatim (same exp/variance-scale form). The
            //      reference for "what value should this pixel's history be" is
            //      the NEAREST tap's own stored ratio (nearV.x below) — the exact
            //      value the OLD nearest-snap fetch would have used alone — NOT
            //      this frame's visEst (1-2 ray Monte Carlo estimate, too noisy
            //      per-frame to anchor a gate on). Anchoring on the nearest tap
            //      means: agreeing neighbours blend in for a genuinely smoother
            //      sub-pixel reproject; a neighbour on the OTHER side of a
            //      shadow boundary disagrees with the nearest tap and is cut,
            //      so the result degrades to (at worst) the same single-tap
            //      value the old code already used — never worse, only smoother
            //      when the 2×2 neighbourhood agrees.
            // Renormalize by the surviving weight; if every tap is out (or
            // off-screen), fall through to sValid=false below, matching how the
            // GI path cold-starts on total invalidity.
            vec4 sPrev = vec4(0.0);
            bool sAnyTap = false;
            if (valid) {
                const vec2  texel   = prevUv * vec2(float(pc.width), float(pc.height)) - 0.5;
                const ivec2 base    = ivec2(floor(texel));
                const vec2  frac    = texel - vec2(base);
                const ivec2 mx      = ivec2(int(pc.width), int(pc.height)) - 1;
                // Re-derive dsided locally — the GI 3×3 pass above scopes its own
                // copy inside its `if (valid)` block; giFlagsZ (the source flag) is
                // still in scope here so this is the same bit test, not a new heuristic.
                const bool  dsided  = ifDoubleSided(giFlagsZ);
                const float surfD   = texture(gbufMotionTex, paneToPhys(gbufMotionTex, uv)).b;// this surface's prev NDC depth (shared by all 4 taps)
                const vec4  svh     = cam.projInverse * vec4(prevNDC, surfD, 1.0);
                const float svz     = svh.z / svh.w;
                // Nearest tap = what the old `texture()` NEAREST fetch would have
                // picked (GL/Vulkan NEAREST samples texel floor(uv*size), no
                // half-texel offset) — the value anchor below.
                const ivec2 nearTp  = clamp(ivec2(floor(prevUv * vec2(float(pc.width), float(pc.height)))), ivec2(0), mx);
                const vec4  nearV   = texelFetch(shadowVisPrevTex, nearTp, 0);
                const float nearVar = max(nearV.y - nearV.x * nearV.x, 0.0);
                // Tight floor (measured: a looser 4x-of-variance floor matching
                // deferred_gi_filter.comp's own visPhi scale left a residual bleed —
                // this is a TEMPORAL accumulator, where a small per-frame leak
                // compounds every frame instead of being re-filtered from a clean
                // source each time like the spatial à-trous is, so it needs a much
                // tighter stop than the one-shot spatial blur to stay put-together
                // over hundreds of frames of camera motion).
                const float nearPhi = 0.25 * sqrt(nearVar) + 1e-4;
                float wSum = 0.0;
                vec4  accTap = vec4(0.0);
                for (int ty = 0; ty <= 1; ++ty) {
                    for (int tx = 0; tx <= 1; ++tx) {
                        const ivec2 tp = clamp(base + ivec2(tx, ty), ivec2(0), mx);
                        const float bw = (tx == 0 ? (1.0 - frac.x) : frac.x) *
                                         (ty == 0 ? (1.0 - frac.y) : frac.y);
                        if (bw <= 0.0) continue;
                        const vec3 pn = texelFetch(gbufNormalPrevTex, tp, 0).xyz * 2.0 - 1.0;
                        float nd = dot(N, normalize(pn));
                        if (dsided) nd = abs(nd);
                        if (nd <= 0.7) continue;// same 45° gate as the GI 3×3 normal test
                        const float bufD = texelFetch(gbufDepthPrevTex, tp, 0).x;
                        const vec4  bvh  = cam.projInverse * vec4(prevNDC, bufD, 1.0);
                        if (abs(svz - bvh.z / bvh.w) > 0.1 * max(abs(svz), 1e-3)) continue;// same depth-plane gate as the GI
                        const vec4  tapV = texelFetch(shadowVisPrevTex, tp, 0);
                        // Value-range stop vs the nearest tap (see comment above);
                        // same exp/variance form as deferred_gi_filter.comp's wlS.
                        const float wl = exp(-abs(nearV.x - tapV.x) / nearPhi);
                        const float w  = bw * wl;
                        if (w <= 1e-5) continue;
                        accTap += w * tapV;
                        wSum   += w;
                    }
                }
                if (wSum > 1e-4) { sPrev = accTap / wSum; sAnyTap = true; }
            }
            // .z==0 = cold-start marker (sky/glass/off); the magnitude guards
            // reject first-frame / garbage fp16 history (NaN compares false).
            const bool sValid = sAnyTap && sPrev.z > 0.5 && sPrev.z < 4096.0 &&
                                abs(sPrev.x) <= 1.5 && abs(sPrev.w) <= 1.5;
            const float dev      = visEst - sPrev.x;
            const float trend    = sValid ? mix(sPrev.w, dev, 0.34) : 0.0;
            const float trendCut = smoothstep(0.10, 0.30, abs(trend));
            // VARIANCE-GATED INSTANT CUT — the trend antilag above needs 2-3
            // frames to charge and still leaves a cap-4..8 EMA, which reads as a
            // dark smudge dragging ~10 frames behind a character's shadow
            // sweeping across a floor (tps_shooter hero trail). The history
            // already stores E[R²] (.y), so measure this frame's deviation in
            // sigmas of the SETTLED history: a converged lit or umbra pixel has
            // σ≈0, so the first frame the occluder's edge arrives (|dev|≈1) is
            // a >4σ event and the history is cut SHORT that frame — the shadow
            // tracks its caster with no charge-up lag. A static penumbra keeps
            // σ≈0.5 (1-2 ray Bernoulli noise), so per-frame noise sits at ≤2σ
            // and the long clean history is untouched (the 0.08 σ-floor also
            // absorbs fp16 quantisation of E[R²]−E[R]²).
            //
            // The cut floors at kShadowStepFloor frames, NOT 1: a ground pixel
            // the moving shadow just reached was a converged-LIT pixel, so the
            // adaptive-ray tier gave it 1 ray/frame (a BINARY visEst∈{0,1}).
            // Cutting to histLen=1 makes sAcc = that lone binary sample at full
            // weight → salt-and-pepper "dusting" on the sweeping edge. Flooring
            // at ~5 keeps every incoming 1-2 ray sample at ≤1/5 weight, so the
            // edge CONVERGES over a few frames (smooth) instead of snapping to a
            // single noisy sample — still ~half the old smudge's lag, and only
            // where the σ-step actually fires.
            const float sSigma   = sqrt(max(sPrev.y - sPrev.x * sPrev.x, 0.0)) + 0.08;
            const float stepCut  = sValid ? smoothstep(2.0, 4.0, abs(dev) / sSigma) : 0.0;
            const float sCapMot  = mix(32.0, 8.0, smoothstep(0.002, 0.03, max(length(motionGL), giCamNdc)));
            // Compose the trend + step reductions as a MIN so neither can raise
            // the cap above the other (a nested mix could: mix(4, floor, step)
            // rises to `floor` when floor>4). Both collapse to sCapMot when idle.
            // MOVING-OCCLUDER cut (sOccMoved): this pixel is shadowed by a mesh
            // that is currently moving — a sweeping shadow cannot be temporally
            // accumulated (ANY history trails it as a smear; shadow-map engines
            // regenerate per frame for exactly this reason), so run it
            // FRAMELESS: cap 1 when the visEst carries the 16-ray top-up
            // (sTopUp) — the static-dithered sunShadowVis is per-frame stable
            // by construction (the denoise-off path displays it raw), so it
            // needs NO temporal smoothing, and any deeper cap leaves DISCRETE
            // ghost outlines: a cap-2 EMA holds the previous frame's shadow at
            // 50% (and 25% at two frames), which at fast per-frame shadow
            // displacement reads as 1-2 separated shadow copies, not a smear.
            // Cap 1 also recovers a vacated pixel in exactly one frame. Without
            // the top-up (no sun share — point/spot casters) the floor stays 2:
            // a cap-1 mean of 1-2 BINARY rays is salt-and-pepper dusting.
            // Statistics-free on purpose: the trend needs frames to charge and
            // the σ-step's variance estimate is degraded over a swept band (the
            // feedback rewrites the mean but not E[R²]) — both limped exactly
            // where this direct signal cuts instantly.
            const float sCapTrend = mix(sCapMot, 4.0, trendCut);
            const float sCapStep  = mix(sCapMot, kShadowStepFloor, stepCut);
            float sCap            = min(sCapTrend, sCapStep);
            // RELEASE with hysteresis: the dwell pin (histLen ≤ 2) doubles as a
            // per-pixel MARKER "was under a moving shadow". Growing histLen out
            // of a dwell while the mean is still stale fades the dark harmonically
            // (1/n) — the long trail — so keep the pixel in the short-history
            // regime until its history AGREES with the current estimate (which
            // the was-dwell ray top-up makes a confident 16-ray value, so the
            // comparison is meaningful, not 1-ray binary flicker). Converged →
            // release ends, history regrows: a PARKED car's settled penumbra
            // exits within a frame of agreement (no permanent noise), and the
            // marker's hysteresis kills the cap-regime stutter a noisy per-frame
            // flag caused at the shadow fringe.
            // sTopUp-GATED: the release compare is only meaningful against the
            // CONFIDENT (16-ray, sun-dominant) estimate. Without it (night /
            // point-light scenes) a multi-light pixel's 1-2 ray visEst is a
            // per-frame binary that never agrees with the mean within 0.1 —
            // an ungated release TRAPPED those pixels at cap 2 forever
            // (permanent shadow boil on the Bistro lamp walls).
            const bool sRelease   = sTopUp && sValid && sPrev.z <= 2.5 && abs(visEst - sPrev.x) > 0.1;
            if ((pc.flags & 512u) == 0u && (sOccMoved || sRelease))// bit 9 = dwell kill switch
                sCap = min(sCap, sTopUp ? 1.0 : 2.0);
            const float sHist    = sValid ? min(sPrev.z + 1.0, sCap) : 1.0;
            const float sAcc     = sValid ? mix(sPrev.x, visEst, 1.0 / sHist) : visEst;
            const float sSq      = sValid ? mix(sPrev.y, visEst * visEst, 1.0 / sHist) : visEst * visEst;
            imageStore(shadowVisImage, px, vec4(sAcc, sSq, sHist, trend));
        } else {
            imageStore(shadowVisImage, px, vec4(0.0));// shadows off: recombine adds 0 (directU=0)
        }
    } else {
        imageStore(indirectImage, px, vec4(0.0));// histLen=0 → next frame cold-starts
        imageStore(momentsImage, px, vec4(0.0));
        imageStore(shadowVisImage, px, vec4(0.0));// glass/sheen/inline: no shadow channel
    }
    // Unshadowed analytic direct for the recombine (U × R̃). UNWEIGHTED like
    // indirect/reflect — the denoise applies recombineCoverage at consumption.
    // vec3(0) whenever the channel is off, so the recombine adds nothing.
    // fp16-SAFE clamp — same bound + rationale as the diffInd clamp above: the
    // GGX peak at the 0.04 roughness floor times a physical-unit light pushes U
    // past fp16 max (65504); an Inf store turns NaN at the recombine's dU × R̃
    // whenever the filtered ratio is exactly 0 (converged umbra), and that NaN
    // poisons the pixel's TAA history permanently.
    imageStore(directUImage, px, vec4(min(directU, vec3(6.5e4)), 1.0));
}
