#version 460
#extension GL_EXT_scalar_block_layout                    : require
#extension GL_EXT_buffer_reference                       : require
#extension GL_EXT_buffer_reference2                      : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive                   : enable

#include "ocean_cascade.glsl"// cascade-1 domain rotation (repeat-lattice break), sampleBicubicRG

// World-space foam accumulator. One texel = one fixed point in world XZ;
// foam value is preserved frame-to-frame regardless of how the ocean's
// vertices are laid out. This is the foundation for adaptive-resolution
// ocean meshes: the mesh can re-tessellate however it likes and foam
// stays where it was deposited.
//
// Coverage is the cascade-0 tile (typically 1000 m), REPEAT-sampled. Texel
// size = tileSize / res; at 2048² over 1000 m that's ≈0.49 m.
//
// It holds what vessels and explicit disturbances leave. The sea's own
// whitecaps are the crest foam's (foam_crest.comp): they ride the water,
// where a texture fixed to the world left them standing behind the crest.
//
// Per frame: decay last frame's foam, recompute the two instant
// sources at every texel, take the max, write to the current target.
// Ping-pong via prevFoam (sampler) / currFoam (storage image) bindings.

layout(local_size_x = 8, local_size_y = 8) in;

// FFT cascades: no longer read (the natural whitecaps that differenced them
// are gone); the bindings stay declared for the descriptor layout.
layout(set = 0, binding = 0) uniform sampler2D height0;
layout(set = 0, binding = 1) uniform sampler2D displace0;
layout(set = 0, binding = 2) uniform sampler2D height1;
layout(set = 0, binding = 3) uniform sampler2D displace1;
layout(set = 0, binding = 4) uniform sampler2D height2;
layout(set = 0, binding = 5) uniform sampler2D displace2;

// Foam accumulator — read previous value (imageLoad) and write the new
// one (imageStore) on the same image. Each invocation only touches its
// own texel, so there's no cross-thread race; ping-pong textures aren't
// needed. deferred_shade.comp (oceanFoamWorld) samples this same image via a
// separate sampler-typed descriptor for filtered reads at arbitrary world XZ.
layout(set = 0, binding = 6, r32f) uniform image2D foam;

// Per-disturbance point source — splatted into the foam texture with a
// gaussian falloff. Layout matches DisplacedMesh::FoamDisturbance.
struct DisturbPoint {
    float worldX;
    float worldZ;
    float radius;
    float intensity;
};
layout(buffer_reference, scalar) buffer DisturbBuf { DisturbPoint p[]; };

// Historical wake sample — mirrors DisplacedMesh::WakeSample / the
// matching struct in water_displace.comp.
struct WakeSample {
    float worldX;
    float worldZ;
    float sinYaw;
    float cosYaw;
    float speed;
    float age;
    float _p0;
    float _p1;
};
layout(buffer_reference, scalar) buffer WakeTrailBuf { WakeSample s[]; };
layout(buffer_reference, scalar) buffer OceanHullBuf { OceanHull h[]; };

// 68 bytes, mirrored field-for-field by FoamWorldPipeline::PushConstants. The
// vessels are the same per-frame buffer water_displace.comp reads.
layout(push_constant, scalar) uniform Pc {
    uint64_t disturbAddr;   // 0 = no disturbance buffer
    uint64_t wakeTrailAddr; // every vessel's trail; each reads its own slice
    uint64_t hullAddr;      // OceanHull[hullCount]
    uint   foamRes;
    float  foamTileSize;
    float  tileSize0;
    float  tileSize1;
    float  tileSize2;
    float  waveScale;
    float  choppiness;
    uint   cascadeMask;
    uint   disturbCount;
    float  decay;
    uint   hullCount;       // active vessels; 0 = no vessel foam
} pc;

// The analytic trail's peak deposit, lateral spread (x half-beam) and bow
// ridge strength. A peak of 0.95 over 1.5 half-beams sits far above the
// shading's solid-sheet knee (coverage 0.55 after its x1.3), and every vessel
// dragged a white carpet two to three beams wide; these leave the centre
// solid and let the edges break into lace.
const float kTrailPeak   = 0.55;
const float kTrailSpread = 1.0;
const float kRidgePeak   = 0.4;

// Toroidal world-XZ delta: a − b, wrapped into (−tileSize/2, +tileSize/2].
// The foam texture covers one cascade-0 tile and REPEAT-samples beyond,
// so any boat/disturbance world position folds modulo `tileSize` into the
// texel domain. Without this wrap, a boat at world (−200, 0) gets distance
// ≈ tileSize from any texel covering its modular twin at (+800, 0) — and
// the wake/disturbance gaussians fall to zero, so no foam appears at all.
vec2 toroidalDelta(vec2 a, vec2 b, float tileSize) {
    vec2 d = a - b;
    return d - tileSize * floor(d / tileSize + 0.5);
}

void main() {
    const uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= pc.foamRes || px.y >= pc.foamRes) return;

    // World XZ this texel anchors. UV is [0,1)² mapped onto the foam tile.
    const vec2 uv      = (vec2(px) + 0.5) / float(pc.foamRes);
    const vec2 worldXZ = uv * pc.foamTileSize;

    // ── Vessel wake foam ─────────────────────────────────────────────
    // Per vessel, iterates its historical pose trail and takes MAX over
    // each sample's contribution, so the foam line traces the boat's
    // actual sailed curve through turns instead of snapping to the
    // current heading every frame. Two contributions per sample:
    //   A — straight foam trail behind the stern (gaussian × exp)
    //   D — bow V-wedge ridge foam (sharp crest along the V boundary)
    // Toroidal delta handles the cascade-tile wrap so the boat at
    // negative world coords still gets foam at its modular twin texel.
    //
    // Falls back to a single current-pose evaluation when the vessel's
    // trail is empty (just spawned, or no samples emitted). Vessels combine
    // by MAX, like the samples within one trail.
    //
    // Nothing new ahead of the stem: hull splats are gaussians placed at or
    // near the bow, and exp(-d²/r²) stays above the shading's visible-foam
    // floor out to ~1.9 r: a 1.6 m bow splat painted foam 3 m ahead of
    // Gunnerus's stem, and the USV demo's did the same. The water ahead of a
    // moving bow is undisturbed, so each vessel's NEW deposits (its wake, and
    // every disturbance splat) fade out across its stem line inside the
    // hull's lateral band. Natural whitecaps and foam already on the water
    // are untouched, so a boat backing into its own wash still meets it.
    float wakeFoam  = 0.0;
    float splatKeep = 1.0;
    OceanHullBuf hulls = OceanHullBuf(pc.hullAddr);
    for (uint k = 0u; k < pc.hullCount; ++k) {
        const OceanHull hu = hulls.h[k];
        const float hullMargin = oceanHullMargin(hu.halfBeam);
        float vesselFoam = 0.0;
        if (hu.trailCount > 0u) {
            WakeTrailBuf wt = WakeTrailBuf(pc.wakeTrailAddr);
            for (uint si = 0u; si < hu.trailCount; ++si) {
                const WakeSample s = wt.s[hu.trailFirst + si];
                const float sSpeed = abs(s.speed);
                const float sGate  = smoothstep(0.5, 1.5, sSpeed);
                if (sGate <= 0.0) continue;
                const vec2 d = toroidalDelta(worldXZ,
                                             vec2(s.worldX, s.worldZ),
                                             pc.foamTileSize);
                const float sLX = s.cosYaw * d.x - s.sinYaw * d.y;
                const float sLZ = s.sinYaw * d.x + s.cosYaw * d.y;
                const float sAgeFade = exp(-s.age / 5.0);
                // A — foam trail behind stern (along the sample's local −Z).
                const float sDistBehind = -sLZ - hu.halfLength;
                if (sDistBehind > 0.0) {
                    const float lenDecay   = 30.0;
                    const float beamSpread = hu.halfBeam * kTrailSpread;
                    const float lateral    = exp(-(sLX * sLX) /
                                                 (beamSpread * beamSpread));
                    const float along      = exp(-sDistBehind / lenDecay);
                    vesselFoam = max(vesselFoam,
                                     sGate * kTrailPeak * along * lateral * sAgeFade);
                }
                // D — bow V-wedge ridge foam, gated by per-sample
                // hullFade so foam doesn't appear under the boat's
                // historical hull footprint.
                const float sDistAft = hu.halfLength - sLZ;
                // (none where the wake field makes her waves: VesselWake::analyticWaves)
                if (hu.analyticWaves != 0u && sDistAft > 0.0 && sDistAft < hu.halfLength * 5.0) {
                    const float uHull = clamp(-sLZ / hu.halfLength, -1.0, 1.0);
                    float sHalfBeamAtLZ;
                    if (uHull <= 0.0) {
                        sHalfBeamAtLZ = hu.halfBeam *
                                        pow(max(1.0 - uHull * uHull, 0.0), 0.6);
                    } else {
                        sHalfBeamAtLZ = hu.halfBeam *
                                        (1.0 - (1.0 - hu.sternBeam) * uHull * uHull);
                    }
                    const float sHullEdgeX = abs(sLX) - sHalfBeamAtLZ;
                    const float sHullEdgeZ = abs(sLZ) - hu.halfLength;
                    const float sHullFade  = smoothstep(0.0, hullMargin,
                                                        max(sHullEdgeX, sHullEdgeZ));
                    if (sHullFade <= 0.0) continue;
                    const float tanAV     = 0.36;
                    const float expectedX = tanAV * sDistAft;
                    const float dRidge    = abs(abs(sLX) - expectedX);
                    const float ridgeFoam = exp(-(dRidge * dRidge) / (0.5 * 0.5));
                    const float alongDec  = exp(-sDistAft / (hu.halfLength * 3.0));
                    vesselFoam = max(vesselFoam,
                                     sGate * kRidgePeak * ridgeFoam * alongDec * sAgeFade * sHullFade);
                }
            }
        } else {
            const float wakeSpeed = abs(hu.forwardSpeed);
            const float wakeGate  = smoothstep(0.5, 1.5, wakeSpeed);
            if (wakeGate > 0.0) {
                const vec2 d = toroidalDelta(worldXZ,
                                             vec2(hu.centerX, hu.centerZ),
                                             pc.foamTileSize);
                const float lX = hu.cosYaw * d.x - hu.sinYaw * d.y;
                const float lZ = hu.sinYaw * d.x + hu.cosYaw * d.y;
                const float distBehind = -lZ - hu.halfLength;
                if (distBehind > 0.0) {
                    const float lenDecay   = 30.0;
                    const float beamSpread = hu.halfBeam * kTrailSpread;
                    const float lateral    = exp(-(lX * lX) / (beamSpread * beamSpread));
                    const float along      = exp(-distBehind / lenDecay);
                    vesselFoam = max(vesselFoam, wakeGate * kTrailPeak * along * lateral);
                }
                const float distAft = hu.halfLength - lZ;
                if (hu.analyticWaves != 0u && distAft > 0.0 && distAft < hu.halfLength * 5.0) {
                    const float uHull = clamp(-lZ / hu.halfLength, -1.0, 1.0);
                    float halfBeamAtLZ;
                    if (uHull <= 0.0) {
                        halfBeamAtLZ = hu.halfBeam *
                                       pow(max(1.0 - uHull * uHull, 0.0), 0.6);
                    } else {
                        halfBeamAtLZ = hu.halfBeam * (1.0 - (1.0 - hu.sternBeam) * uHull * uHull);
                    }
                    const float hullEdgeX = abs(lX) - halfBeamAtLZ;
                    const float hullEdgeZ = abs(lZ) - hu.halfLength;
                    const float curHullFade = smoothstep(0.0, hullMargin,
                                                         max(hullEdgeX, hullEdgeZ));
                    const float tanAV     = 0.36;
                    const float expectedX = tanAV * distAft;
                    const float dRidge    = abs(abs(lX) - expectedX);
                    const float ridgeFoam = exp(-(dRidge * dRidge) / (0.5 * 0.5));
                    const float alongDec  = exp(-distAft / (hu.halfLength * 3.0));
                    vesselFoam = max(vesselFoam,
                                     wakeGate * kRidgePeak * ridgeFoam * alongDec * curHullFade);
                }
            }
        }

        // The fade across the stem line.
        const vec2 d = toroidalDelta(worldXZ, vec2(hu.centerX, hu.centerZ),
                                     pc.foamTileSize);
        const float lX = hu.cosYaw * d.x - hu.sinYaw * d.y;
        const float lZ = hu.sinYaw * d.x + hu.cosYaw * d.y;
        const float ahead = smoothstep(hu.halfLength - 0.3, hu.halfLength + 0.3, lZ);
        const float band  = 1.0 - smoothstep(hu.halfBeam + 2.0, hu.halfBeam + 4.0, abs(lX));
        const float near  = 1.0 - smoothstep(hu.halfLength + 6.0, hu.halfLength + 9.0, lZ);
        const float keep  = 1.0 - ahead * band * near;
        vesselFoam *= keep;
        splatKeep  *= keep;
        wakeFoam = max(wakeFoam, vesselFoam);
    }

    // ── External disturbance splats ───────────────────────────────────
    float disturbFoam = 0.0;
    if (pc.disturbAddr != 0ul && pc.disturbCount > 0u) {
        DisturbBuf db = DisturbBuf(pc.disturbAddr);
        for (uint k = 0u; k < pc.disturbCount; ++k) {
            const DisturbPoint dp = db.p[k];
            const vec2 dd = toroidalDelta(worldXZ,
                                          vec2(dp.worldX, dp.worldZ),
                                          pc.foamTileSize);
            const float r2  = dp.radius * dp.radius;
            if (r2 <= 0.0) continue;
            const float d2  = dd.x * dd.x + dd.y * dd.y;
            const float g   = dp.intensity * exp(-d2 / r2);
            disturbFoam = max(disturbFoam, g);
        }
    }
    disturbFoam *= splatKeep;

    // ── Combine + decay ──────────────────────────────────────────────
    const float instantTotal = max(wakeFoam, disturbFoam);
    const float prev         = imageLoad(foam, ivec2(px)).r;
    const float result       = max(instantTotal, prev * pc.decay);

    imageStore(foam, ivec2(px), vec4(result));
}
