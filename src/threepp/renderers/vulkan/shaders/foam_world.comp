#version 460
#extension GL_EXT_scalar_block_layout                    : require
#extension GL_EXT_buffer_reference                       : require
#extension GL_EXT_buffer_reference2                      : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive                   : enable

#include "ocean_cascade.glsl"// cascade-1 domain rotation (repeat-lattice break), sampleBicubicRG

// World-space foam accumulator. One texel = one fixed point in world XZ;
// foam value is preserved frame-to-frame regardless of how the ocean's
// vertices are laid out. This is the foundation for adaptive-resolution
// ocean meshes: the mesh can re-tessellate however it likes and foam
// stays where it was deposited.
//
// Coverage is the cascade-0 tile (typically 1000 m), REPEAT-sampled. Texel
// size = tileSize / res; at 2048² over 1000 m that's ≈0.49 m.
//
// It holds what vessels and explicit disturbances leave. The sea's own
// whitecaps are the crest foam's (foam_crest.comp): they ride the water,
// where a texture fixed to the world left them standing behind the crest.
// The extended ocean's main adds its fold whitecaps (natFoamScale) only on a
// mesh that has no crest foam (no ray queries, or the CDLOD mesh); the host
// sets natFoamScale 0 wherever crest foam or breaking crests run.
//
// Per frame: decay last frame's foam, recompute the two instant
// sources at every texel, take the max, write to the current target.
// Ping-pong via prevFoam (sampler) / currFoam (storage image) bindings.

#ifdef THREEPP_OCEAN_UNIFORM_CURRENT
layout(constant_id=19) const float currentX=0;
layout(constant_id=20) const float currentZ=0;
#endif

layout(local_size_x = 8, local_size_y = 8) in;

// FFT cascades: upstream's main no longer reads them (its natural whitecaps
// are gone); the extended ocean's main does (fold whitecaps, breaking band).
layout(set = 0, binding = 0) uniform sampler2D height0;
layout(set = 0, binding = 1) uniform sampler2D displace0;
layout(set = 0, binding = 2) uniform sampler2D height1;
layout(set = 0, binding = 3) uniform sampler2D displace1;
layout(set = 0, binding = 4) uniform sampler2D height2;
layout(set = 0, binding = 5) uniform sampler2D displace2;

// Foam accumulator — read previous value (imageLoad) and write the new
// one (imageStore) on the same image. Each invocation only touches its
// own texel, so there's no cross-thread race; ping-pong textures aren't
// needed. deferred_shade.comp (oceanFoamWorld) samples this same image via a
// separate sampler-typed descriptor for filtered reads at arbitrary world XZ.
layout(set = 0, binding = 6, rgba32f) uniform image2D foam; // foam amount, freshness, storm streaks
// the previous frame's foam, a copy taken before this dispatch: the advection reads its neighbours here,
// never from the image being written
layout(set = 0, binding = 7, rgba32f) uniform readonly image2D foamPrev;
// the swell cascade's displacement as the surface and the shade read it (the CDLOD filter's output where
// there is one, else binding 1): the live band's fold is taken from this one
layout(set = 0, binding = 8) uniform sampler2D displace0Drawn;

// Per-disturbance point source — splatted into the foam texture with a
// gaussian falloff. Layout matches DisplacedMesh::FoamDisturbance.
struct DisturbPoint {
    float worldX;
    float worldZ;
    float radius;
    float intensity;
};
layout(buffer_reference, scalar) buffer DisturbBuf { DisturbPoint p[]; };

// Historical wake sample — mirrors DisplacedMesh::WakeSample / the
// matching struct in water_displace.comp.
struct WakeSample {
    float worldX;
    float worldZ;
    float sinYaw;
    float cosYaw;
    float speed;
    float age;
    float _p0;
    float _p1;
};
layout(buffer_reference, scalar) buffer WakeTrailBuf { WakeSample s[]; };
layout(buffer_reference, scalar) buffer OceanHullBuf { OceanHull h[]; };

// 112 bytes, mirrored field-for-field by FoamWorldPipeline::PushConstants. The
// vessels are the same per-frame buffer water_displace.comp reads.
layout(push_constant, scalar) uniform Pc {
    uint64_t disturbAddr;   // 0 = no disturbance buffer
    uint64_t wakeTrailAddr; // every vessel's trail; each reads its own slice
    uint64_t hullAddr;      // OceanHull[hullCount]
    uint   foamRes;
    float  foamTileSize;
    float  tileSize0;
    float  tileSize1;
    float  tileSize2;
    float  waveScale;
    float  choppiness;
    uint   cascadeMask;
    uint   disturbCount;
    float  decay;
    float  natFoamScale;    // the extended ocean's fold whitecaps (main only; 0 under crest foam / breaking crests)
    uint   hullCount;       // active vessels; 0 = no vessel foam
    float  gateOffX;        // the breaking gate's noise offset: the waves' group velocity x time
    float  gateOffZ;
    float  gateT;           // its time, in lives of a breaking group; < 0 = no gate
    float  fineFold;        // fold of the fine cascade at which it starts to break; <= 0 = none
    float  coarseFold;      // the swell cascade's
    float  simDt;           // s since the last dispatch
    float driftX, driftZ, rowSpacing; // advection
    float carryT;           // THREEPP_OCEAN_FOAM_CARRY's breaking clock, 1 + t / kCarryLife; 0 = off (was pad0)
    float currentTime;
    float bandPacked;       // the shade's band packing, 1 + Hs + 100 x round(100 x threshold); 0 = none (was auditPad)
#ifdef THREEPP_OCEAN_FOAM_DIAGNOSTICS
    uint64_t auditAddr;
#endif
} pc;

#ifdef THREEPP_OCEAN_FOAM_DIAGNOSTICS
// Read-only observation of the last positive-dt update. No diagnostic value
// feeds the accumulator. Channels: accumulator, deposit, forcing/s, event bits.
layout(buffer_reference, scalar) buffer FoamAuditBuf { vec4 value[]; };
#endif

// Value noise on a hashed lattice, for the breaking gate. The corner's hash is an integer one (pcg3d,
// Jarzynski & Olano 2020). The float hash's fract((i + 1) * 0.1031) could round differently in the two cells sharing a
// corner (one fused multiply-add and not the other), so the gate stepped along its 26 m lattice lines and stamped
// straight, axis-aligned edges into the foam it let through.
float gateHash(vec3 corner) {
    uvec3 v = uvec3(ivec3(corner)) * 1664525u + 1013904223u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    return float(v.x) * (1.0 / 4294967296.0);
}
float gateNoise(vec2 p, float t) {
    const vec3 q = vec3(p, t);
    const vec3 i = floor(q);
    vec3 f = fract(q);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(mix(gateHash(i), gateHash(i + vec3(1, 0, 0)), f.x),
                   mix(gateHash(i + vec3(0, 1, 0)), gateHash(i + vec3(1, 1, 0)), f.x), f.y),
               mix(mix(gateHash(i + vec3(0, 0, 1)), gateHash(i + vec3(1, 0, 1)), f.x),
                   mix(gateHash(i + vec3(0, 1, 1)), gateHash(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}

// The analytic trail's peak deposit, lateral spread (x half-beam) and bow
// ridge strength. A peak of 0.95 over 1.5 half-beams sits far above the
// shading's solid-sheet knee (coverage 0.55 after its x1.3), and every vessel
// dragged a white carpet two to three beams wide; these leave the centre
// solid and let the edges break into lace.
const float kTrailPeak   = 0.55;
const float kTrailSpread = 1.0;
const float kRidgePeak   = 0.4;

// Toroidal world-XZ delta: a − b, wrapped into (−tileSize/2, +tileSize/2].
// The foam texture covers one cascade-0 tile and REPEAT-samples beyond,
// so any boat/disturbance world position folds modulo `tileSize` into the
// texel domain. Without this wrap, a boat at world (−200, 0) gets distance
// ≈ tileSize from any texel covering its modular twin at (+800, 0) — and
// the wake/disturbance gaussians fall to zero, so no foam appears at all.
vec2 toroidalDelta(vec2 a, vec2 b, float tileSize) {
    vec2 d = a - b;
    return d - tileSize * floor(d / tileSize + 0.5);
}

// Horizontal displacement only — the Jacobian and the inverse-map never
// need the height channel, so skip those fetches entirely (the height
// bindings stay declared for descriptor-layout compatibility). `mask`
// selects which cascades contribute, ANDed with the host's cascadeMask.
vec2 sampleDispXZ(vec2 worldXZ, uint mask) {
    vec2 d = vec2(0.0);
    if ((mask & pc.cascadeMask & 1u) != 0u) {
        const float invTile = 1.0 / pc.tileSize0;
        d += texture(displace0, worldXZ * invTile).rg * invTile;
    }
    if ((mask & pc.cascadeMask & 2u) != 0u) {
        // Rotated domain + world back-rotation — must match water_displace.
        const float invTile = 1.0 / pc.tileSize1;
        // A local Eulerian contact correction is a coordinate change, not a
        // breaking displacement. Do not treat its Jacobian as whitecap energy.
        if (!oceanC1Local(height1)) d += oceanC1World(texture(displace1, oceanC1Domain(worldXZ) * invTile).rg) * invTile;
    }
    if ((mask & pc.cascadeMask & 4u) != 0u) {
        const float invTile = 1.0 / pc.tileSize2;
        d += texture(displace2, worldXZ * invTile).rg * invTile;
    }
    return d * pc.choppiness;
}

// Bicubic variant of sampleDispXZ — used ONLY inside the Jacobian stencil
// (the inverse-map keeps the cheap bilinear path: kinks in the VALUE field
// are second-order there and invisible). The Jacobian below DIFFERENTIATES
// the displacement field; the derivative of a BILINEAR texture is only
// piecewise-continuous (kinks at every texel boundary), and the steep foam
// ramp amplifies those kinks into hard world-aligned ~1 m squares baked into
// the foam accumulator (cascade-0 texel = tileSize0/res ≈ 0.98 m — exactly
// the visible artifact). sampleBicubicRG (ocean_cascade.glsl) is a C1
// B-spline, so the fold field carries no cell boundaries to bake in.
vec2 sampleDispXZSmooth(vec2 worldXZ, uint mask) {
    vec2 d = vec2(0.0);
    if ((mask & pc.cascadeMask & 1u) != 0u) {
        const float invTile = 1.0 / pc.tileSize0;
        d += sampleBicubicRG(displace0, worldXZ * invTile) * invTile;
    }
    if ((mask & pc.cascadeMask & 2u) != 0u) {
        // Rotated domain + world back-rotation — must match water_displace.
        const float invTile = 1.0 / pc.tileSize1;
        if (!oceanC1Local(height1)) d += oceanC1World(sampleBicubicRG(displace1, oceanC1Domain(worldXZ) * invTile)) * invTile;
    }
    if ((mask & pc.cascadeMask & 4u) != 0u) {
        const float invTile = 1.0 / pc.tileSize2;
        d += sampleBicubicRG(displace2, worldXZ * invTile) * invTile;
    }
    return d * pc.choppiness;
}

// 1 − J of (x,z) → (x,z) + Dxz over the masked cascades, central-differenced
// at stencil half-width `eps`. Positive = the surface is compressing/folding
// (a breaking crest); the stencil width sets which wavelengths register.
float jacobianFold(vec2 p, uint mask, float eps) {
    const vec2 dL = sampleDispXZSmooth(p + vec2(-eps, 0.0), mask);
    const vec2 dR = sampleDispXZSmooth(p + vec2( eps, 0.0), mask);
    const vec2 dD = sampleDispXZSmooth(p + vec2(0.0, -eps), mask);
    const vec2 dU = sampleDispXZSmooth(p + vec2(0.0,  eps), mask);
    const float inv2e = 0.5 / eps;
    const float dDxDx = (dR.x - dL.x) * inv2e;
    const float dDxDz = (dU.x - dD.x) * inv2e;
    const float dDzDx = (dR.y - dL.y) * inv2e;
    const float dDzDz = (dU.y - dD.y) * inv2e;
    return 1.0 - ((1.0 + dDxDx) * (1.0 + dDzDz) - dDxDz * dDzDx);
}

// the live breaking band of deferred_shade_50_water_glass.glsl, read at rest position q from the same
// textures: its fold (the fine cascade over 1.2 m plus 3 x the drawn swell over 12 m, at the application's choppiness 1), its
// threshold, and where it may break (the upper part of a crest, on the face toward the wind). Under THREEPP_OCEAN_FOAM_CARRY the
// water keeps what that band breaks, so the foam left behind is the foam the breaking made.
float liveBandFold(vec2 q) {
    float fold = 0.0;
    if ((pc.cascadeMask & 4u) != 0u) {
        // (THREEPP_OCEAN_SLOPE_BUDGET: cascadeMask bit 25, the shade's oceanOptions2 bit 14) the fine cascade's fold over
        // 4 m, the waves of 2 m and up that break, not the 1.2 m stencil the short tail dominated
        const float inv = 1.0 / pc.tileSize2, e = (pc.cascadeMask & (1u << 25u)) != 0u ? 2.0 : 0.6, k = inv / (2.0 * e);
        const vec2 dL = texture(displace2, (q - vec2(e, 0.0)) * inv).rg, dR = texture(displace2, (q + vec2(e, 0.0)) * inv).rg;
        const vec2 dD = texture(displace2, (q - vec2(0.0, e)) * inv).rg, dU = texture(displace2, (q + vec2(0.0, e)) * inv).rg;
        fold = 1.0 - ((1.0 + (dR.x - dL.x) * k) * (1.0 + (dU.y - dD.y) * k) - (dU.x - dD.x) * (dR.y - dL.y) * k * k);
    }
    if ((pc.cascadeMask & 1u) != 0u) {
        const float inv = 1.0 / pc.tileSize0, e = 6.0, k = inv / (2.0 * e);
        const vec2 dL = sampleBicubicRG(displace0Drawn, (q - vec2(e, 0.0)) * inv), dR = sampleBicubicRG(displace0Drawn, (q + vec2(e, 0.0)) * inv);
        const vec2 dD = sampleBicubicRG(displace0Drawn, (q - vec2(0.0, e)) * inv), dU = sampleBicubicRG(displace0Drawn, (q + vec2(0.0, e)) * inv);
        fold += 3.0 * (1.0 - ((1.0 + (dR.x - dL.x) * k) * (1.0 + (dU.y - dD.y) * k) - (dU.x - dD.x) * (dR.y - dL.y) * k * k));
    }
    return fold;
}
float surfaceHeight(vec2 q) {
    float h = 0.0;
    if ((pc.cascadeMask & 1u) != 0u) h += texture(height0, q / pc.tileSize0).r / pc.tileSize0;
    if ((pc.cascadeMask & 2u) != 0u && !oceanC1Local(height1)) h += texture(height1, oceanC1Domain(q) / pc.tileSize1).r / pc.tileSize1;
    if ((pc.cascadeMask & 4u) != 0u) h += texture(height2, q / pc.tileSize2).r / pc.tileSize2;
    return h * pc.waveScale;
}
// the band's group noise (deferred_shade_10_lighting_utils.glsl's fbm4: gradient noise, integer corner hash)
vec2 bandHash22(vec2 corner) {
    uvec2 v = uvec2(ivec2(corner)) * 1664525u + 1013904223u;
    v.x += v.y * 1664525u; v.y += v.x * 1664525u;
    v ^= v >> 16u;
    v.x += v.y * 1664525u; v.y += v.x * 1664525u;
    v ^= v >> 16u;
    return vec2(v) * (1.0 / 4294967296.0);
}
float bandGnoise(vec2 p) {
    const vec2 i = floor(p), f = p - i, u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    const float a = dot(bandHash22(i) * 2.0 - 1.0, f);
    const float b = dot(bandHash22(i + vec2(1.0, 0.0)) * 2.0 - 1.0, f - vec2(1.0, 0.0));
    const float c = dot(bandHash22(i + vec2(0.0, 1.0)) * 2.0 - 1.0, f - vec2(0.0, 1.0));
    const float d = dot(bandHash22(i + vec2(1.0, 1.0)) * 2.0 - 1.0, f - vec2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}
float bandFbm4(vec2 p) {
    const mat2 turn = mat2(0.8, -0.6, 0.6, 0.8) * 2.03;
    float a = 0.0, w = 0.5;
    for (int i = 0; i < 4; ++i) { a += w * bandGnoise(p); p = turn * p; w *= 0.5; }
    return 0.467 + 1.218 * a;
}
float liveBandRate(vec2 q) {
    if (pc.carryT <= 0.0 || pc.bandPacked <= 0.0) return 0.0;
    const float irB = max(pc.bandPacked - 1.0, 0.0), thrK = floor(irB / 100.0);
    const float hsW = max(0.5, irB - 100.0 * thrK);
    if (thrK <= 0.0) return 0.0;
    const float thr = thrK / 100.0;
    const float fold = liveBandFold(q);
    if (fold <= thr) return 0.0;
    const vec2 dr = vec2(pc.driftX, pc.driftZ);
    const vec2 wd = length(dr) > 1e-4 ? normalize(dr) : vec2(1.0, 0.0);
    const float e = 0.6, h = surfaceHeight(q);
    const vec2 g = vec2(surfaceHeight(q + vec2(e, 0.0)) - surfaceHeight(q - vec2(e, 0.0)),
                        surfaceHeight(q + vec2(0.0, e)) - surfaceHeight(q - vec2(0.0, e))) / (2.0 * e);
    const vec2 nxz = -g / sqrt(1.0 + dot(g, g));
    const float onCrest = smoothstep(0.05 * hsW, 0.3 * hsW, h) * smoothstep(0.02, 0.15, dot(nxz, wd));
    // and its groups, travelling at about half the peak phase speed (the shade's grp, on the same wrapped coordinates)
    const float cgB = 4.0 * sqrt(hsW);
    // (at the world position the shade reads it at. The shade's groups are not periodic over the foam tile, so
    // this texel's group is taken at its copy nearest the first vessel, which is where the view is; the shade keeps
    // its earlier unwrapped coordinates, and stage A is unchanged pixel for pixel)
    vec2 qw = q;
    if (pc.hullCount > 0u) {
        const OceanHull h0 = OceanHullBuf(pc.hullAddr).h[0];
        qw = q + pc.foamTileSize * floor((vec2(h0.centerX, h0.centerZ) - q) / pc.foamTileSize + 0.5);
    }
    const float grp = smoothstep(0.38, 0.6, bandFbm4(qw * 0.012 - wd * (0.012 * cgB) * pc.currentTime + 0.03 * vec2(-wd.y, wd.x) * pc.currentTime));
    return smoothstep(thr, thr + 0.22, fold) * onCrest * grp;
}
// THREEPP_OCEAN_BREAKERS_INPLACE (cascadeMask bit 24; storm look only): individual breakers that stay where they broke.
// The shade's grouped-breaking window (where breaking is likely, travelling at the group speed) is kept, but inside it
// single caps of 5-30 m break for 1-2 s at fixed points of the water, where the water under them is steep, and
// what they lay stays in this field, drifting and decaying in place. Cells of 16 m (rotated to the wind), each with an
// integer-hashed centre, size, elongation along the crest, period and phase.
uvec3 brkHash(ivec3 v) {
    uvec3 u = uvec3(v) * 1664525u + 1013904223u;
    u.x += u.y * u.z; u.y += u.z * u.x; u.z += u.x * u.y; u ^= u >> 16u;
    u.x += u.y * u.z; u.y += u.z * u.x; u.z += u.x * u.y;
    return u;
}
float breakersInPlace(vec2 q) {
    if ((pc.cascadeMask & (1u << 24u)) == 0u || pc.bandPacked <= 0.0) return 0.0;
    const float irB = max(pc.bandPacked - 1.0, 0.0), hsW = max(0.5, irB - 100.0 * floor(irB / 100.0));
    const vec2 dr = vec2(pc.driftX, pc.driftZ);
    const vec2 wd = length(dr) > 1e-4 ? normalize(dr) : vec2(1.0, 0.0), wp = vec2(-wd.y, wd.x);
    const float cgB = 4.0 * sqrt(hsW), t = pc.currentTime;
    vec2 qw = q;
    if (pc.hullCount > 0u) {
        const OceanHull h0 = OceanHullBuf(pc.hullAddr).h[0];
        qw = q + pc.foamTileSize * floor((vec2(h0.centerX, h0.centerZ) - q) / pc.foamTileSize + 0.5);
    }
    // the trigger is steepness, not elevation: a breaker shows where the surface under the cap is steep, its front
    // facing downwind, whatever its height; so it can break on a modest crest and need not on a high round one
    float e = 1.2, t0 = 0.08, t1 = 0.28;
    vec2 g = vec2(surfaceHeight(q + vec2(e, 0.0)) - surfaceHeight(q - vec2(e, 0.0)),
                  surfaceHeight(q + vec2(0.0, e)) - surfaceHeight(q - vec2(0.0, e))) / (2.0 * e);
    if ((pc.cascadeMask & (1u << 25u)) != 0u) {
        // THREEPP_OCEAN_SLOPE_BUDGET: the 2.4 m difference was the short chop's slope, aliased (a 1 m wave of 0.1 m
        // adds up to 0.08 to it), and the budget took most of that away. The waves that break are the young sea's and
        // the dominant's, so the slope is taken over 0.06 of the peak wavelength (Hs / Lp 0.036) on heights box-filtered
        // over half that, which leaves the waves under about e out; thresholds scaled by cascadeMask bits 26..31
        e = clamp(0.03 * clamp(hsW / 0.036, 20.0, 400.0), 1.2, 8.0);
        const float r = 0.5 * e;
        #define HB(p) (0.25 * (surfaceHeight((p) + vec2(r, r)) + surfaceHeight((p) + vec2(r, -r)) + surfaceHeight((p) - vec2(r, r)) + surfaceHeight((p) - vec2(r, -r))))
        g = vec2(HB(q + vec2(e, 0.0)) - HB(q - vec2(e, 0.0)), HB(q + vec2(0.0, e)) - HB(q - vec2(0.0, e))) / (2.0 * e);
        #undef HB
        const float sB = float((pc.cascadeMask >> 26u) & 63u) / 32.0;
        t0 = 0.05 * sB; t1 = 0.16 * sB;
    }
    const float steepB = smoothstep(t0, t1, length(g)) * mix(0.5, 1.0, smoothstep(-0.05, 0.1, dot(-g, wd)));   // (over the crest top too, not only its front)
    if (steepB <= 0.0) return 0.0;
    const float cell = 16.0;
    const vec2 r = vec2(dot(qw, wd), dot(qw, wp)) / cell;
    const ivec2 c0 = ivec2(floor(r));
    float m = 0.0;
    for (int j = -1; j <= 1; ++j)
        for (int i = -1; i <= 1; ++i) {
            const ivec2 c = c0 + ivec2(i, j);
            const vec3 hc = vec3(brkHash(ivec3(c, 911))) * (1.0 / 4294967296.0);
            const vec3 hd = vec3(brkHash(ivec3(c, 3517))) * (1.0 / 4294967296.0);
            if (hd.z < 0.3) continue;   // most cells hold a breaker
            const vec2 cr = (vec2(c) + 0.5 + 0.7 * (hc.xy - 0.5)) * cell;   // its centre, (along, across) the wind, m
            const vec2 cw = cr.x * wd + cr.y * wp;                         // in world
            const float period = 5.0 + 7.0 * hd.x, life = 1.2 + 1.0 * hc.z;
            const float age = mod(t + period * hc.z, period);
            if (age > life) continue;
            // only where the group window is on, at the moment it breaks
            // the group window raises the odds, it does not decide: breakers anywhere, more of them in the groups
            const float win = mix(0.4, 1.0, smoothstep(0.45, 0.65, bandFbm4(cw * 0.0075 - wd * (0.0075 * cgB) * (t - age) + 0.02 * wp * (t - age) + 7.3)));
            if (hd.y > win) continue;
            const float R = 2.5 + 12.5 * hc.y * hc.y;                     // 5-30 m across
            // (not a disc: two lobes offset along the crest, and a ragged edge at the field's own scale; round discs read as
            // decals from the air)
            const vec2  dl = vec2(dot(qw - cw, wd), dot(qw - cw, wp)) / (R * vec2(0.55, 1.0 + 0.8 * hd.x));   // longer along the crest
            const float off = 0.45 * (hd.y - 0.5) * 2.0;
            const float lobes = min(length(dl - vec2(0.0, off)), length(dl + vec2(0.15, off)) * 1.15);
            const float edge = 0.7 + 0.9 * (bandFbm4(qw * 0.11 + 13.0 * hc.xy) - 0.47);
            const float disc = (1.0 - smoothstep(0.25 * edge, edge, lobes)) * smoothstep(0.25, 0.6, bandFbm4(qw * 0.3 + 7.0 * hd.xy));
            const float grow = smoothstep(0.0, 0.25 * life, age);         // it spreads as it breaks
            m = max(m, disc * grow);
        }
    return m * steepB;
}

// the breaking events' noise. Gradient noise (quintic weights, a
// rotated domain): the value noise the gate used is flat along its lattice lines, and the kept foam took the cut's
// contour as straight edges on the fading caps. Scaled to the value noise's mean and spread so the same share is open.
vec3 carryGrad(vec3 c) {
    uvec3 v = uvec3(ivec3(c)) * 1664525u + 1013904223u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    return vec3(v) * (2.0 / 4294967296.0) - 1.0;
}
float carryNoise(vec2 xz, float t) {
    const vec3 p = vec3(mat2(0.825, -0.565, 0.565, 0.825) * xz / 26.0, t);
    const vec3 i = floor(p), f = p - i, u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float n[8];
    for (int k = 0; k < 8; ++k) {
        const vec3 o = vec3(k & 1, (k >> 1) & 1, (k >> 2) & 1);
        n[k] = dot(carryGrad(i + o), f - o);
    }
    const float a = mix(mix(mix(n[0], n[1], u.x), mix(n[2], n[3], u.x), u.y),
                        mix(mix(n[4], n[5], u.x), mix(n[6], n[7], u.x), u.y), u.z);
    return 0.5 + 0.9 * a;
}

// the base renderer's main, verbatim but for its name (f2343291), run with the
// extended ocean master switch off (kOceanExt): one foam amount from vessels
// and disturbances only (no natural whitecaps), upstream's decay. Its
// imageStore fills all four channels of the RGBA32F image with that amount;
// upstream's readers take .r.
void mainUpstream() {
    const uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= pc.foamRes || px.y >= pc.foamRes) return;

    // World XZ this texel anchors. UV is [0,1)² mapped onto the foam tile.
    const vec2 uv      = (vec2(px) + 0.5) / float(pc.foamRes);
    const vec2 worldXZ = uv * pc.foamTileSize;

    // ── Vessel wake foam ─────────────────────────────────────────────
    // Per vessel, iterates its historical pose trail and takes MAX over
    // each sample's contribution, so the foam line traces the boat's
    // actual sailed curve through turns instead of snapping to the
    // current heading every frame. Two contributions per sample:
    //   A — straight foam trail behind the stern (gaussian × exp)
    //   D — bow V-wedge ridge foam (sharp crest along the V boundary)
    // Toroidal delta handles the cascade-tile wrap so the boat at
    // negative world coords still gets foam at its modular twin texel.
    //
    // Falls back to a single current-pose evaluation when the vessel's
    // trail is empty (just spawned, or no samples emitted). Vessels combine
    // by MAX, like the samples within one trail.
    //
    // Nothing new ahead of the stem: hull splats are gaussians placed at or
    // near the bow, and exp(-d²/r²) stays above the shading's visible-foam
    // floor out to ~1.9 r: a 1.6 m bow splat painted foam 3 m ahead of
    // Gunnerus's stem, and the USV demo's did the same. The water ahead of a
    // moving bow is undisturbed, so each vessel's NEW deposits (its wake, and
    // every disturbance splat) fade out across its stem line inside the
    // hull's lateral band. Natural whitecaps and foam already on the water
    // are untouched, so a boat backing into its own wash still meets it.
    float wakeFoam  = 0.0;
    float splatKeep = 1.0;
    OceanHullBuf hulls = OceanHullBuf(pc.hullAddr);
    for (uint k = 0u; k < pc.hullCount; ++k) {
        const OceanHull hu = hulls.h[k];
        const float hullMargin = oceanHullMargin(hu.halfBeam);
        float vesselFoam = 0.0;
        if (hu.trailCount > 0u) {
            WakeTrailBuf wt = WakeTrailBuf(pc.wakeTrailAddr);
            for (uint si = 0u; si < hu.trailCount; ++si) {
                const WakeSample s = wt.s[hu.trailFirst + si];
                const float sSpeed = abs(s.speed);
                const float sGate  = smoothstep(0.5, 1.5, sSpeed);
                if (sGate <= 0.0) continue;
                const vec2 d = toroidalDelta(worldXZ,
                                             vec2(s.worldX, s.worldZ),
                                             pc.foamTileSize);
                const float sLX = s.cosYaw * d.x - s.sinYaw * d.y;
                const float sLZ = s.sinYaw * d.x + s.cosYaw * d.y;
                const float sAgeFade = exp(-s.age / 5.0);
                // A — foam trail behind stern (along the sample's local −Z).
                const float sDistBehind = -sLZ - hu.halfLength;
                if (sDistBehind > 0.0) {
                    const float lenDecay   = 30.0;
                    const float beamSpread = hu.halfBeam * kTrailSpread;
                    const float lateral    = exp(-(sLX * sLX) /
                                                 (beamSpread * beamSpread));
                    const float along      = exp(-sDistBehind / lenDecay);
                    vesselFoam = max(vesselFoam,
                                     sGate * kTrailPeak * along * lateral * sAgeFade);
                }
                // D — bow V-wedge ridge foam, gated by per-sample
                // hullFade so foam doesn't appear under the boat's
                // historical hull footprint.
                const float sDistAft = hu.halfLength - sLZ;
                // (none where the wake field makes her waves: VesselWake::analyticWaves)
                if (hu.analyticWaves != 0u && sDistAft > 0.0 && sDistAft < hu.halfLength * 5.0) {
                    const float uHull = clamp(-sLZ / hu.halfLength, -1.0, 1.0);
                    float sHalfBeamAtLZ;
                    if (uHull <= 0.0) {
                        sHalfBeamAtLZ = hu.halfBeam *
                                        pow(max(1.0 - uHull * uHull, 0.0), 0.6);
                    } else {
                        sHalfBeamAtLZ = hu.halfBeam *
                                        (1.0 - 0.25 * uHull * uHull);
                    }
                    const float sHullEdgeX = abs(sLX) - sHalfBeamAtLZ;
                    const float sHullEdgeZ = abs(sLZ) - hu.halfLength;
                    const float sHullFade  = smoothstep(0.0, hullMargin,
                                                        max(sHullEdgeX, sHullEdgeZ));
                    if (sHullFade <= 0.0) continue;
                    const float tanAV     = 0.36;
                    const float expectedX = tanAV * sDistAft;
                    const float dRidge    = abs(abs(sLX) - expectedX);
                    const float ridgeFoam = exp(-(dRidge * dRidge) / (0.5 * 0.5));
                    const float alongDec  = exp(-sDistAft / (hu.halfLength * 3.0));
                    vesselFoam = max(vesselFoam,
                                     sGate * kRidgePeak * ridgeFoam * alongDec * sAgeFade * sHullFade);
                }
            }
        } else {
            const float wakeSpeed = abs(hu.forwardSpeed);
            const float wakeGate  = smoothstep(0.5, 1.5, wakeSpeed);
            if (wakeGate > 0.0) {
                const vec2 d = toroidalDelta(worldXZ,
                                             vec2(hu.centerX, hu.centerZ),
                                             pc.foamTileSize);
                const float lX = hu.cosYaw * d.x - hu.sinYaw * d.y;
                const float lZ = hu.sinYaw * d.x + hu.cosYaw * d.y;
                const float distBehind = -lZ - hu.halfLength;
                if (distBehind > 0.0) {
                    const float lenDecay   = 30.0;
                    const float beamSpread = hu.halfBeam * kTrailSpread;
                    const float lateral    = exp(-(lX * lX) / (beamSpread * beamSpread));
                    const float along      = exp(-distBehind / lenDecay);
                    vesselFoam = max(vesselFoam, wakeGate * kTrailPeak * along * lateral);
                }
                const float distAft = hu.halfLength - lZ;
                if (hu.analyticWaves != 0u && distAft > 0.0 && distAft < hu.halfLength * 5.0) {
                    const float uHull = clamp(-lZ / hu.halfLength, -1.0, 1.0);
                    float halfBeamAtLZ;
                    if (uHull <= 0.0) {
                        halfBeamAtLZ = hu.halfBeam *
                                       pow(max(1.0 - uHull * uHull, 0.0), 0.6);
                    } else {
                        halfBeamAtLZ = hu.halfBeam * (1.0 - 0.25 * uHull * uHull);
                    }
                    const float hullEdgeX = abs(lX) - halfBeamAtLZ;
                    const float hullEdgeZ = abs(lZ) - hu.halfLength;
                    const float curHullFade = smoothstep(0.0, hullMargin,
                                                         max(hullEdgeX, hullEdgeZ));
                    const float tanAV     = 0.36;
                    const float expectedX = tanAV * distAft;
                    const float dRidge    = abs(abs(lX) - expectedX);
                    const float ridgeFoam = exp(-(dRidge * dRidge) / (0.5 * 0.5));
                    const float alongDec  = exp(-distAft / (hu.halfLength * 3.0));
                    vesselFoam = max(vesselFoam,
                                     wakeGate * kRidgePeak * ridgeFoam * alongDec * curHullFade);
                }
            }
        }

        // The fade across the stem line.
        const vec2 d = toroidalDelta(worldXZ, vec2(hu.centerX, hu.centerZ),
                                     pc.foamTileSize);
        const float lX = hu.cosYaw * d.x - hu.sinYaw * d.y;
        const float lZ = hu.sinYaw * d.x + hu.cosYaw * d.y;
        const float ahead = smoothstep(hu.halfLength - 0.3, hu.halfLength + 0.3, lZ);
        const float band  = 1.0 - smoothstep(hu.halfBeam + 2.0, hu.halfBeam + 4.0, abs(lX));
        const float near  = 1.0 - smoothstep(hu.halfLength + 6.0, hu.halfLength + 9.0, lZ);
        const float keep  = 1.0 - ahead * band * near;
        vesselFoam *= keep;
        splatKeep  *= keep;
        wakeFoam = max(wakeFoam, vesselFoam);
    }

    // ── External disturbance splats ───────────────────────────────────
    float disturbFoam = 0.0;
    if (pc.disturbAddr != 0ul && pc.disturbCount > 0u) {
        DisturbBuf db = DisturbBuf(pc.disturbAddr);
        for (uint k = 0u; k < pc.disturbCount; ++k) {
            const DisturbPoint dp = db.p[k];
            const vec2 dd = toroidalDelta(worldXZ,
                                          vec2(dp.worldX, dp.worldZ),
                                          pc.foamTileSize);
            const float r2  = dp.radius * dp.radius;
            if (r2 <= 0.0) continue;
            const float d2  = dd.x * dd.x + dd.y * dd.y;
            const float g   = dp.intensity * exp(-d2 / r2);
            disturbFoam = max(disturbFoam, g);
        }
    }
    disturbFoam *= splatKeep;

    // ── Combine + decay ──────────────────────────────────────────────
    const float instantTotal = max(wakeFoam, disturbFoam);
    const float prev         = imageLoad(foam, ivec2(px)).r;
    const float result       = max(instantTotal, prev * pc.decay);

    imageStore(foam, ivec2(px), vec4(result));
}

void main() {
    if (!kOceanExt) { mainUpstream(); return; }
    const uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= pc.foamRes || px.y >= pc.foamRes) return;

    // World XZ this texel anchors. UV is [0,1)² mapped onto the foam tile.
    const vec2 uv      = (vec2(px) + 0.5) / float(pc.foamRes);
    #ifdef THREEPP_OCEAN_UNIFORM_CURRENT
    // History texel r is material rest coordinate: q = r + U t.
    // Source samples use q; geometry already contains phase Doppler.
    const vec2 worldXZ = uv * pc.foamTileSize + vec2(currentX,currentZ)*pc.currentTime;
#else
    const vec2 worldXZ = uv * pc.foamTileSize;
#endif

    // ── Natural Jacobian foam ────────────────────────────────────────
    // Foam is stored at the rest position and read at x - D(x) by the shade, so it rides the waves: this texel IS q.
    const vec2 q = worldXZ;

    // Two-scale folding measure:
    //   coarse — cascade 0 (1 km tile) at a ~2 m stencil: swell-crest foam.
    //   fine   — cascade 1 (100 m tile) at a sub-metre stencil: the small
    //            whitecaps that make a wind-blown sea read as alive. The old
    //            single 3.9 m stencil over the summed field low-pass-filtered
    //            these out entirely, which is why foam only ever appeared as
    //            big soft swell blobs.
    // Cascade 2 (8 m tile) is deliberately excluded: its Jacobian would stamp
    // a visible 8 m repeating foam grid, and its wavelengths barely fold.
    // First-order in the displacement gradients, fold terms add: the overlap
    // (chop folding ON a breaking swell crest) saturates toward 1 — exactly
    // where real whitewater is densest.
    const float texel      = pc.foamTileSize / float(pc.foamRes);
    // Coarse stencil at tileSize0/256 (≈4 m): folding is spectrally dominated
    // by content near the cascade's Nyquist, so a texel-scale stencil measures
    // a field of per-texel bumps. Combined with a steep ramp those deposited
    // as saturated ~1 m squares aligned to the cascade-0 texel grid — the
    // long-standing visible "foam texels" (≈1/30 of the 28 m vessel). The
    // wide stencil measures swell-scale folding instead; sub-4 m whitecap
    // detail belongs to cascade 1.
    const float foldCoarse = jacobianFold(q, 1u, pc.tileSize0 / 256.0);
    const float foldFine   = jacobianFold(q, 2u, max(pc.tileSize1 / 256.0, texel));
    // GRADED ramps + soft-knee saturation (1 − e^−x). A near-binary threshold
    // re-quantizes the band-limited fold field into hard texel-grid blobs no
    // matter how smoothly it is sampled; graded deposits leave the shading
    // lifecycle mask a real gradient to shape. Genuinely breaking crests
    // (multi-texel folding, coarse+fine overlapping) still saturate toward 1.
    // NOTE: the shading mask in deferred_shade.comp is
    // calibrated to this curve (sheet solidifies from coverage ≈ 0.55) — they
    // must be retuned TOGETHER or the ocean under/over-foams.
    // Breaking comes in groups that travel and die out. The fold field is a fixed sum of
    // waves, so it folds again at the same spot each time the same crests meet: foam
    // survival rose again after 4 s. A noise that moves at the group velocity and changes
    // over a group's life decides where breaking is allowed at all.
    // and the groups themselves, a few wavelengths across, travel at the group velocity with the 26 m gate:
    // most of the sea between them breaks little, so foam comes in clusters with dark water between, as the swell's
    // groups do (the domain turned 0.6 rad so the lattice is not square to anything)
    const vec2  qg = mat2(0.825, -0.565, 0.565, 0.825) * (q - vec2(pc.gateOffX, pc.gateOffZ));
    const float groups = pc.gateT < 0.0 ? 1.0 : mix(0.25, 1.0, smoothstep(0.38, 0.62, gateNoise(qg / 90.0, 0.6 * pc.gateT + 5.3)));
    float gate = pc.gateT < 0.0 ? 1.0
            : smoothstep(0.42, 0.58, gateNoise((q - vec2(pc.gateOffX, pc.gateOffZ)) / 26.0, pc.gateT)) * groups;
    // THREEPP_OCEAN_FOAM_CARRY: the 26 m gate is a breaking EVENT, not a window riding the group. It stays still on the
    // water (material coordinates, as this field is) and opens and shuts within about a second, so a crest breaks while it
    // crosses an open cell and stops: what it laid stays where it fell and the next crests pass under it, instead of the
    // deposit following the fold along the crest. Same noise and cut as above, so the same share of the sea is open.
    // (the shade's live band is no longer cut by it; the events only decide what the water keeps.)
    gate = pc.carryT > 0.0 && pc.gateT >= 0.0 ? smoothstep(0.42, 0.58, carryNoise(q, pc.carryT > 1500.0 ? pc.carryT - 2000.0 : pc.carryT)) * groups : gate;
    // Foam is added by rate, as Crest's: what is already there lowers the threshold, so a patch
    // grows by itself while its wave keeps folding. The feedback is small enough (0.2 of the foam,
    // at strength 2 per second against a 2.5 s fade) that foam cannot keep itself alive. The gate
    // only stops new foam: what is on the water fades in its own time. The small caps are the
    // wind sea's crests, folding at a stencil the accumulator resolves; a 12 s swell hardly folds at
    // 9 m/s. The fine cascade's 21 m repeat does not show because the gate is not periodic.
    // foam is carried by the surface. The field is stored at rest positions, so the waves' orbital motion is
    // already in the lookup (the shade reads it at x - D(x)); what moves foam over the sea is the drift: the wind's
    // (about 3 % of U10) and the waves' Stokes drift, along the wind, set on the host. Windrows (Langmuir cells) add a
    // slow convergence across it, so residue gathers into wandering lines along the wind. Semi-Lagrangian: each texel
    // reads the previous field where its foam came from, bilinear and wrapped like the tile; the resampling's own
    // smoothing acts along the drift only, which is the stretch.
    vec2 vel = vec2(pc.driftX, pc.driftZ);
    const float vl = length(vel);
    if (pc.rowSpacing > 0.0 && vl > 1e-3) {
        const vec2  wd = vel / vl, wc = vec2(-wd.y, wd.x);
        const float along = dot(q, wd);
        const float y = dot(q, wc) + 0.12 * pc.rowSpacing * sin(along / (1.7 * pc.rowSpacing) + 1.3);
        vel -= wc * (0.18 * vl * sin(6.2831853 * y / pc.rowSpacing));   // toward y = n spacing, up to 18 % of the drift
    }
    float prevFoam, prevFresh, prevStreak = 0.0, prevPlume = 0.0;
    {
        // History is indexed in material coordinates. Uniform-current world
        // translation belongs to source sampling, not the previous-image lookup.
        const vec2  src = (uv * pc.foamTileSize - vel * pc.simDt) / texel - 0.5;
        const vec2  i0 = floor(src), fr = src - i0;
        const int   n = int(pc.foamRes);
        const ivec2 a = (ivec2(i0) % n + n) % n, b = (a + 1) % n;
        const vec2 p = mix(mix(imageLoad(foamPrev, a).rg, imageLoad(foamPrev, ivec2(b.x, a.y)).rg, fr.x),
                           mix(imageLoad(foamPrev, ivec2(a.x, b.y)).rg, imageLoad(foamPrev, b).rg, fr.x), fr.y);
        prevFoam = p.r, prevFresh = p.g;
        // THREEPP_OCEAN_WATER_BUBBLES (cascadeMask bit 3): the bubble plumes' history rides the same drift
        // (and spreads as it thins, 0.15 m2/s: a little of its four neighbours each tick, so a plume's edge softens)
        if ((pc.cascadeMask & 8u) != 0u) {
            const ivec2 am = (a + n - 1) % n, bp = (b + 1) % n;
            const float c00 = imageLoad(foamPrev, a).a, c10 = imageLoad(foamPrev, ivec2(b.x, a.y)).a;
            const float c01 = imageLoad(foamPrev, ivec2(a.x, b.y)).a, c11 = imageLoad(foamPrev, b).a;
            const float here = mix(mix(c00, c10, fr.x), mix(c01, c11, fr.x), fr.y);
            const float left  = mix(mix(imageLoad(foamPrev, ivec2(am.x, a.y)).a, c00, fr.x), mix(imageLoad(foamPrev, ivec2(am.x, b.y)).a, c01, fr.x), fr.y);
            const float right = mix(mix(c10, imageLoad(foamPrev, ivec2(bp.x, a.y)).a, fr.x), mix(c11, imageLoad(foamPrev, ivec2(bp.x, b.y)).a, fr.x), fr.y);
            const float down  = mix(mix(imageLoad(foamPrev, ivec2(a.x, am.y)).a, imageLoad(foamPrev, ivec2(b.x, am.y)).a, fr.x), mix(c00, c10, fr.x), fr.y);
            const float up    = mix(mix(c01, c11, fr.x), mix(imageLoad(foamPrev, ivec2(a.x, bp.y)).a, imageLoad(foamPrev, ivec2(b.x, bp.y)).a, fr.x), fr.y);
            prevPlume = mix(here, 0.25 * (left + right + down + up), clamp(4.0 * 0.15 * max(pc.simDt, 0.0) / (texel * texel), 0.0, 0.5));
        }
        // the storm streaks (b) ride the same drift and are drawn out along it: blended a little each tick with
        // the texel upwind (one-sided, about 4 m/s of along-wind spread), so each deposit grows a long downwind tail; their
        // lives are their own (8 s), not the caps'
        if ((float((pc.cascadeMask >> 8u) & 0xFFFFu) / 65535.0) > 0.0 && vl > 1e-3) {
            const vec2  wdS = vec2(pc.driftX, pc.driftZ) / vl;
            const vec2  srcU = src - wdS;
            const vec2  iU = floor(srcU), fU = srcU - iU;
            const ivec2 aU = (ivec2(iU) % n + n) % n, bU = (aU + 1) % n;
            const float sHere = mix(mix(imageLoad(foamPrev, a).b, imageLoad(foamPrev, ivec2(b.x, a.y)).b, fr.x),
                                    mix(imageLoad(foamPrev, ivec2(a.x, b.y)).b, imageLoad(foamPrev, b).b, fr.x), fr.y);
            const float sUp = mix(mix(imageLoad(foamPrev, aU).b, imageLoad(foamPrev, ivec2(bU.x, aU.y)).b, fU.x),
                                  mix(imageLoad(foamPrev, ivec2(aU.x, bU.y)).b, imageLoad(foamPrev, bU).b, fU.x), fU.y);
            prevStreak = mix(sHere, sUp, clamp(4.0 * pc.simDt / texel, 0.0, 0.5));
        }
    }
    const float foldChop = pc.fineFold > 0.0 ? jacobianFold(q, 4u, max(1.5, texel)) : -1.0;
    // the feedback held at 0.4 / s of the foam whatever natFoamScale is (0.2 x 5 x 0.4 before):
    // a stronger deposit then whitens a cap without letting foam keep itself alive (at 0.2 a scale over 0.4 ran away)
    // foamlook: 0.25 / s (was 0.4): at 0.4 a patch kept growing over the whole crest of a passing group
    // and lay as one 50-100 m lacy sheet; a cap now stays the size of what breaks
    // and only a fresh cap's own foam feeds back: residual foam fades on 12 s, slower than the feedback's
    // 0.25 / s, so letting it feed back would keep it alive by itself wherever the gate is open
    // lifetimes from the storm references (0.12-0.26 of the foam left after 3-4 s; a cap born, grown and
    // faded in 2-3 s): a fresh cap fades on 1.2 s, its residue on 4 s (pc.decay = exp(-dt / 2.5 s))
    // (residue 2.5 s, was 4: what a cap leaves fades before it spreads off the crest)
    // THREEPP_OCEAN_FOAM_CARRY: with breaking cut to short events a cap is no longer renewed while its crest runs on, so it
    // fades from where it fell: the cap on 3 s and its residue on 6 s keep the references' 0.12-0.26 left after 3 s
    // only foam the band laid (its age channel is set; a vessel's wake trail and splats leave it at 0) lives
    // longer: given the long lives too, the old wake trail built up into a white sheet across the view
    const float decayDefault = mix(pow(pc.decay, 2.5 / 2.5), pow(pc.decay, 2.5 / 1.2), smoothstep(0.15, 0.4, prevFoam));
    // THREEPP_OCEAN_FOAM_RESIDUE: stage B lives as whitecap foam does, an effective 1.4-4.8 s (Callaghan, Deane & Stokes
    // 2012: 552 whitecaps, area-weighted decay 1.4-4.8 s, larger patches lasting longer; Monahan & Lu 1990 3.5-4.3 s). The
    // foam's own amount stands for the patch's size, so a dense core outlasts its thin fringe and a patch shrinks inward.
    const float residueLife = mix(1.4, 4.8, smoothstep(0.05, 0.5, prevFoam));
    const float decayCarry = pc.carryT > 1500.0 ? pow(pc.decay, 2.5 / residueLife)
                           : mix(pow(pc.decay, 2.5 / 6.0), pow(pc.decay, 2.5 / 3.0), smoothstep(0.15, 0.4, prevFoam));
    const float decayEff = pc.carryT > 0.0 ? mix(decayDefault, decayCarry, smoothstep(0.02, 0.2, prevFresh)) : decayDefault;
    // The feedback (a cap growing while its wave keeps folding) is held under 0.6 of the decay at every level, so foam
    // can never keep itself alive or run away, whatever the gain (a port with feedback equal to the decay filled a storm
    // sea in 2.4 s): 5 x natFoamScale x feedback, the per-second gain, at most 0.6 x -ln(decay) / dt.
    const float decayRate = pc.simDt > 0.0 ? -log(max(decayEff, 1e-6)) / pc.simDt : 0.0;
    const float feedback = min(0.05 / max(pc.natFoamScale, 0.05), 0.6 * decayRate / (5.0 * max(pc.natFoamScale, 0.05)))
                         * smoothstep(0.15, 0.4, prevFoam);
    // foamlook: the swell's fold breaks only where the wind sea's small waves fold on it too, so a
    // long crest throws a row of caps metres to tens of metres across instead of one sheet along it
    const float onCaps = pc.fineFold > 0.0 ? smoothstep(0.4 * pc.fineFold, 1.6 * pc.fineFold, jacobianFold(q, 4u, max(1.5, texel))) : 1.0;
    const float rateC = clamp((foldCoarse - pc.coarseFold) * onCaps + feedback * prevFoam, 0.0, 1.0);
    // the small caps' gain 3 -> 8 per unit fold past the threshold. At 3 a fold barely past it
    // laid a faint film over a third of a storm sea (40 % of texels above 0.04, 0.5 % of them above 0.4); at 8 the
    // caps that break are white and the threshold (steered on the host) sets how many do.
    // the wind sea's caps break on the long waves' crests, so they come in the swell's groups: the small caps'
    // rate rides the coarse fold (the long waves' compression, highest on the front of a high crest in a group). Without it
    // they were spread evenly over the sea. The weights keep about the mean rate the host's threshold is set for.
    const float onCrest = mix(0.4, 3.2, smoothstep(0.0, max(pc.coarseFold, 1e-3), foldCoarse));   // (relative to the host's threshold, which follows the sea)
    const float rateF = pc.fineFold > 0.0 ? clamp((foldChop - pc.fineFold) * 8.0 * onCrest + feedback * prevFoam, 0.0, 1.0) : 0.0;
    // THREEPP_OCEAN_FOAM_CARRY: and what the live band breaks, at its own threshold, inside the same breaking events
    const float rateB = liveBandRate(q);
    // Under THREEPP_OCEAN_FOAM_CARRY nothing is added by rate: the swell's fold and the fine caps' rate fill a whole open cell, and
    // even the band's own rate, integrated while a group passes, saturates the whole swept water into one white sheet.
    // The field instead keeps what the band shows (below), so weak breaking leaves faint foam and strong breaking white.
    const float foamAdded = gate * 5.0 * pc.simDt * pc.natFoamScale * (pc.carryT > 0.0 ? 0.0 : max(rateC, rateF));

    // ── Vessel wake foam ─────────────────────────────────────────────
    // Per vessel, iterates its historical pose trail and takes MAX over
    // each sample's contribution, so the foam line traces the boat's
    // actual sailed curve through turns instead of snapping to the
    // current heading every frame. Two contributions per sample:
    //   A — straight foam trail behind the stern (gaussian × exp)
    //   D — bow V-wedge ridge foam (sharp crest along the V boundary)
    // Toroidal delta handles the cascade-tile wrap so the boat at
    // negative world coords still gets foam at its modular twin texel.
    //
    // Falls back to a single current-pose evaluation when the vessel's
    // trail is empty (just spawned, or no samples emitted). Vessels combine
    // by MAX, like the samples within one trail.
    //
    // Nothing new ahead of the stem: hull splats are gaussians placed at or
    // near the bow, and exp(-d²/r²) stays above the shading's visible-foam
    // floor out to ~1.9 r: a 1.6 m bow splat painted foam 3 m ahead of
    // Gunnerus's stem, and the USV demo's did the same. The water ahead of a
    // moving bow is undisturbed, so each vessel's NEW deposits (its wake, and
    // every disturbance splat) fade out across its stem line inside the
    // hull's lateral band. Natural whitecaps and foam already on the water
    // are untouched, so a boat backing into its own wash still meets it.
    float wakeFoam  = 0.0;
    float splatKeep = 1.0;
    OceanHullBuf hulls = OceanHullBuf(pc.hullAddr);
    for (uint k = 0u; k < pc.hullCount; ++k) {
        const OceanHull hu = hulls.h[k];
        const float hullMargin = oceanHullMargin(hu.halfBeam);
        float vesselFoam = 0.0;
        if (hu.trailCount > 0u) {
            WakeTrailBuf wt = WakeTrailBuf(pc.wakeTrailAddr);
            for (uint si = 0u; si < hu.trailCount; ++si) {
                const WakeSample s = wt.s[hu.trailFirst + si];
                const float sSpeed = abs(s.speed);
                const float sGate  = smoothstep(0.5, 1.5, sSpeed);
                if (sGate <= 0.0) continue;
                const vec2 d = toroidalDelta(worldXZ,
                                             vec2(s.worldX, s.worldZ),
                                             pc.foamTileSize);
                const float sLX = s.cosYaw * d.x - s.sinYaw * d.y;
                const float sLZ = s.sinYaw * d.x + s.cosYaw * d.y;
                const float sAgeFade = exp(-s.age / 5.0);
                // A — foam trail behind stern (along the sample's local −Z).
                const float sDistBehind = -sLZ - hu.halfLength;
                if (sDistBehind > 0.0) {
                    const float lenDecay   = 30.0;
                    const float beamSpread = hu.halfBeam * kTrailSpread;
                    const float lateral    = exp(-(sLX * sLX) /
                                                 (beamSpread * beamSpread));
                    const float along      = exp(-sDistBehind / lenDecay);
                    vesselFoam = max(vesselFoam,
                                     sGate * kTrailPeak * along * lateral * sAgeFade);
                }
                // D — bow V-wedge ridge foam, gated by per-sample
                // hullFade so foam doesn't appear under the boat's
                // historical hull footprint.
                const float sDistAft = hu.halfLength - sLZ;
                // (none where the wake field makes her waves: VesselWake::analyticWaves)
                if (hu.analyticWaves != 0u && sDistAft > 0.0 && sDistAft < hu.halfLength * 5.0) {
                    const float uHull = clamp(-sLZ / hu.halfLength, -1.0, 1.0);
                    float sHalfBeamAtLZ;
                    if (uHull <= 0.0) {
                        sHalfBeamAtLZ = hu.halfBeam *
                                        pow(max(1.0 - uHull * uHull, 0.0), 0.6);
                    } else {
                        sHalfBeamAtLZ = hu.halfBeam *
                                        (1.0 - 0.25 * uHull * uHull);
                    }
                    const float sHullEdgeX = abs(sLX) - sHalfBeamAtLZ;
                    const float sHullEdgeZ = abs(sLZ) - hu.halfLength;
                    const float sHullFade  = smoothstep(0.0, hullMargin,
                                                        max(sHullEdgeX, sHullEdgeZ));
                    if (sHullFade <= 0.0) continue;
                    const float tanAV     = 0.36;
                    const float expectedX = tanAV * sDistAft;
                    const float dRidge    = abs(abs(sLX) - expectedX);
                    const float ridgeFoam = exp(-(dRidge * dRidge) / (0.5 * 0.5));
                    const float alongDec  = exp(-sDistAft / (hu.halfLength * 3.0));
                    vesselFoam = max(vesselFoam,
                                     sGate * kRidgePeak * ridgeFoam * alongDec * sAgeFade * sHullFade);
                }
            }
        } else {
            const float wakeSpeed = abs(hu.forwardSpeed);
            const float wakeGate  = smoothstep(0.5, 1.5, wakeSpeed);
            if (wakeGate > 0.0) {
                const vec2 d = toroidalDelta(worldXZ,
                                             vec2(hu.centerX, hu.centerZ),
                                             pc.foamTileSize);
                const float lX = hu.cosYaw * d.x - hu.sinYaw * d.y;
                const float lZ = hu.sinYaw * d.x + hu.cosYaw * d.y;
                const float distBehind = -lZ - hu.halfLength;
                if (distBehind > 0.0) {
                    const float lenDecay   = 30.0;
                    const float beamSpread = hu.halfBeam * kTrailSpread;
                    const float lateral    = exp(-(lX * lX) / (beamSpread * beamSpread));
                    const float along      = exp(-distBehind / lenDecay);
                    vesselFoam = max(vesselFoam, wakeGate * kTrailPeak * along * lateral);
                }
                const float distAft = hu.halfLength - lZ;
                if (hu.analyticWaves != 0u && distAft > 0.0 && distAft < hu.halfLength * 5.0) {
                    const float uHull = clamp(-lZ / hu.halfLength, -1.0, 1.0);
                    float halfBeamAtLZ;
                    if (uHull <= 0.0) {
                        halfBeamAtLZ = hu.halfBeam *
                                       pow(max(1.0 - uHull * uHull, 0.0), 0.6);
                    } else {
                        halfBeamAtLZ = hu.halfBeam * (1.0 - 0.25 * uHull * uHull);
                    }
                    const float hullEdgeX = abs(lX) - halfBeamAtLZ;
                    const float hullEdgeZ = abs(lZ) - hu.halfLength;
                    const float curHullFade = smoothstep(0.0, hullMargin,
                                                         max(hullEdgeX, hullEdgeZ));
                    const float tanAV     = 0.36;
                    const float expectedX = tanAV * distAft;
                    const float dRidge    = abs(abs(lX) - expectedX);
                    const float ridgeFoam = exp(-(dRidge * dRidge) / (0.5 * 0.5));
                    const float alongDec  = exp(-distAft / (hu.halfLength * 3.0));
                    vesselFoam = max(vesselFoam,
                                     wakeGate * kRidgePeak * ridgeFoam * alongDec * curHullFade);
                }
            }
        }

        // The fade across the stem line.
        const vec2 d = toroidalDelta(worldXZ, vec2(hu.centerX, hu.centerZ),
                                     pc.foamTileSize);
        const float lX = hu.cosYaw * d.x - hu.sinYaw * d.y;
        const float lZ = hu.sinYaw * d.x + hu.cosYaw * d.y;
        const float ahead = smoothstep(hu.halfLength - 0.3, hu.halfLength + 0.3, lZ);
        const float band  = 1.0 - smoothstep(hu.halfBeam + 2.0, hu.halfBeam + 4.0, abs(lX));
        const float near  = 1.0 - smoothstep(hu.halfLength + 6.0, hu.halfLength + 9.0, lZ);
        const float keep  = 1.0 - ahead * band * near;
        vesselFoam *= keep;
        splatKeep  *= keep;
        wakeFoam = max(wakeFoam, vesselFoam);
    }

    // ── External disturbance splats ───────────────────────────────────
    float disturbFoam = 0.0;
    if (pc.disturbAddr != 0ul && pc.disturbCount > 0u) {
        DisturbBuf db = DisturbBuf(pc.disturbAddr);
        for (uint k = 0u; k < pc.disturbCount; ++k) {
            const DisturbPoint dp = db.p[k];
            const vec2 dd = toroidalDelta(worldXZ,
                                          vec2(dp.worldX, dp.worldZ),
                                          pc.foamTileSize);
            const float r2  = dp.radius * dp.radius;
            if (r2 <= 0.0) continue;
            const float d2  = dd.x * dd.x + dd.y * dd.y;
            const float g   = dp.intensity * exp(-d2 / r2);
            disturbFoam = max(disturbFoam, g);
        }
    }
    disturbFoam *= splatKeep;

    // ── Combine + decay ──────────────────────────────────────────────
    // two lives. A fresh cap (above ~0.4) fades fast; what is left of it (under ~0.15) is residual foam,
    // which lasts longer (Monahan's stage B), and the shade draws it in streaks along the wind (decayEff, above).
    // the band's own level, in the field's units (the shade draws the field x 2.5 and the band x 1.4)
    // (and gated by the hull as the band is, oceanNaturalCapHullKeep: no natural cap inside the hull's artificial
    // transition, so the field cannot keep shards by the waterline that the band itself no longer draws)
    float bandHullKeep = 1.0;
    for (uint k = 0u; pc.carryT > 0.0 && k < pc.hullCount; ++k) {
        const OceanHull hu = hulls.h[k];
        const vec2  d = toroidalDelta(worldXZ, vec2(hu.centerX, hu.centerZ), pc.foamTileSize);
        const vec2  local = vec2(hu.cosYaw * d.x - hu.sinYaw * d.y, hu.sinYaw * d.x + hu.cosYaw * d.y);
        const float u = clamp(-local.y / hu.halfLength, -1.0, 1.0);
        const float width = hu.halfBeam * (u <= 0.0 ? pow(max(1.0 - u * u, 0.0), 0.6) : 1.0 - 0.25 * u * u);
        const float edge = max(abs(local.x) - width, abs(local.y) - hu.halfLength);
        const float margin = clamp(0.6 * hu.halfBeam, 0.3, 2.0);
        bandHullKeep *= smoothstep(margin, 2.0 * margin, edge);
    }
    const float bandKept = pc.carryT > 0.0 && pc.natFoamScale > 0.0 ? min(1.0, 0.56 * rateB * gate * bandHullKeep) : 0.0;
    // breaking over foam that is still there does not renew it. Its bubbles decay on their own time, a few
    // seconds for whitecap foam (Callaghan, Deane & Stokes 2012, 1-4 s), and a new break only adds fresh foam once the
    // old has thinned (age channel under 0.1, about 5.8 s at the 2.5 s life below). Renewed by every passing crest, a
    // storm patch stayed white for 8 s.
    // (but only onto water its earlier foam has left: a crest
    // passing over stage B adds its own stage A, the live band, and leaves the residue greying on its own clock; renewed by
    // each crest, a storm patch stayed bright for 8 s)
    // (not even "within the same break": in a storm the band never leaves some water, so its age stayed near 1 and the
    // patch never greyed; the live band draws the breaking itself, so stage B need only take what the break first laid)
    const bool renew = pc.carryT <= 0.0 || (pc.carryT > 1500.0 ? prevFoam < 0.05 : prevFresh < 0.1);
    const float brk = breakersInPlace(q);   // breakers in place (0 when off)
    const float result = clamp(max(max(prevFoam * decayEff + foamAdded, max(renew ? bandKept : 0.0, 0.9 * brk)), max(wakeFoam, disturbFoam)), 0.0, 1.0);

    // folding alone refreshes a deposit; feedback cannot renew its age.
    // Both channels use the same material-space advection above.
    const float foldRate = max((foldCoarse - pc.coarseFold) * onCaps, pc.fineFold > 0.0 ? (foldChop - pc.fineFold) * 8.0 * onCrest : 0.0);
    // (under THREEPP_OCEAN_FOAM_CARRY a deposit's age starts where the band breaks, as the foam does)
    const float depositing = smoothstep(0.02, 0.1, (pc.carryT > 0.0 ? rateB : foldRate) * gate);
    // (under THREEPP_OCEAN_FOAM_CARRY a broken cap stays dense for longer, 2.5 s, the references' 0.12-0.26 left after
    // 3-4 s; it cannot spread into a sheet, since the field only keeps the band's own level)
    const float fresh = max(max(prevFresh * (pc.simDt > 0.0 ? exp(-pc.simDt / (pc.carryT > 0.0 ? 2.5 : 1.38)) : 1.0), renew ? depositing : 0.0),
                            smoothstep(0.1, 0.4, brk));
    // a streak is laid where a cap is fresh (its foam past ~0.1), and lasts on its own clock
    // (and only in cap-sized patches, two rotated octaves of the integer-hash gate noise that change over a
    // few seconds: under a steep (chopped) swell the fold onsets along the whole crest at once, and the streak channel
    // kept each crest's imprint as a thin white line across the wind)
    const vec2 sp1 = mat2(0.8, 0.6, -0.6, 0.8) * worldXZ / 14.0, sp2 = mat2(0.28, -0.96, 0.96, 0.28) * worldXZ / 6.0;
    const float capPatch = smoothstep(0.55, 0.72, 0.6 * gateNoise(sp1, 0.7 * max(pc.gateT, 0.0)) + 0.4 * gateNoise(sp2 + 17.0, 0.9 * max(pc.gateT, 0.0) + 3.0));
    const float streak = (float((pc.cascadeMask >> 8u) & 0xFFFFu) / 65535.0) > 0.0
        ? clamp(max(prevStreak * (pc.simDt > 0.0 ? exp(-pc.simDt / 8.0) : 1.0), (float((pc.cascadeMask >> 8u) & 0xFFFFu) / 65535.0) * fresh * smoothstep(0.08, 0.3, result) * capPatch), 0.0, 1.0) : 0.0;
    // THREEPP_OCEAN_WATER_BUBBLES (cascadeMask bit 3): the bubble plumes under the breakers (only at the crests,
    // with the breakers' own placement and trigger). A plume is injected where an in-place breaker is breaking, by the
    // same value that lays its foam (so the same steepness trigger, cell and lobes) and only under its dense part, a
    // weak or thin breaker injects none; and under a vessel's wash; with bit 4 (THREEPP_OCEAN_WATER_BUBBLES=2) also where the
    // band's gated deposit is laid. It then thins on its own clock, slower than the foam on top (Monahan & Lu 1990's
    // beta and gamma plumes; Deane & Stokes 2002) but while the patch it came from can still be seen: one e-folding in
    // 10 s less a constant rate, so it ends: half left after 5 s, a quarter after 10 s, nothing after 18 s (at the first
    // 15 s and 0.004 / s a plume lasted 43 s, long after its foam, and the sea read as teal dots). It rides the foam's
    // drift, so it trails downwind of where it was injected, spreading as it goes. The water body's shade reads it
    // (alpha; 0 with the switch off, and 0 wherever nothing broke, where the shade adds nothing).
    float plume = 0.0;
    if ((pc.cascadeMask & 8u) != 0u) {
        float laid = max(smoothstep(0.25, 0.7, brk), smoothstep(0.1, 0.5, max(wakeFoam, disturbFoam)));
        if ((pc.cascadeMask & 16u) != 0u) laid = max(laid, (renew ? depositing : 0.0) * smoothstep(0.05, 0.3, result));
        // (calibration, cascadeMask bits 5..6, THREEPP_OCEAN_WATER_BUBBLES_TAU: 10 s, or 6 / 15 / 20)
        const uint tauSel = (pc.cascadeMask >> 5u) & 3u;
        const float tauP = tauSel == 0u ? 10.0 : tauSel == 1u ? 6.0 : tauSel == 2u ? 15.0 : 20.0;
        plume = clamp(max(prevPlume * (pc.simDt > 0.0 ? exp(-pc.simDt / tauP) : 1.0) - 0.02 * max(pc.simDt, 0.0), laid), 0.0, 1.0);
    }
    imageStore(foam, ivec2(px), vec4(result, fresh, streak, plume));
#ifdef THREEPP_OCEAN_FOAM_DIAGNOSTICS
    if (pc.auditAddr != 0ul && pc.simDt > 0.0) {
        const float freshC = clamp((foldCoarse - pc.coarseFold) * onCaps, 0.0, 1.0);
        const float freshF = pc.fineFold > 0.0 ? clamp((foldChop - pc.fineFold) * 8.0 * onCrest, 0.0, 1.0) : 0.0;
        const float forcing = gate * 5.0 * pc.natFoamScale * max(freshC, freshF);
        const uint events = (gate > 0.0 && freshC > 0.0 ? 1u : 0u) | (gate > 0.0 && freshF > 0.0 ? 2u : 0u);
        FoamAuditBuf(pc.auditAddr).value[px.y * pc.foamRes + px.x] = vec4(result, foamAdded, forcing, float(events));
    }
#endif
}
