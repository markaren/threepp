#version 460

// Final IFFT sign-flip / permutation pass. The Cooley-Tukey butterflies leave
// the result with an alternating sign pattern (every other texel negated)
// from the [-N/2..N/2] frequency layout the dynamic-spectrum pass uses.
// Multiplying by (-1)^(x+y) corrects this back into the natural spatial
// layout. Dispatched ONCE per frame per cascade after all butterfly passes.
//
// This runs IN PLACE on the image that holds the butterfly result. Unlike a
// butterfly, the map here is strictly 1:1: invocation (x,y) reads texel (x,y)
// and writes texel (x,y), and nothing else. No invocation can observe another
// invocation's store, so the read-modify-write needs no ordering between them
// and the caller is spared a full-image copy back over the source. The rg32f
// format qualifier is what makes the load legal without
// shaderStorageImageReadWithoutFormat.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rg32f) uniform image2D IoBuffer;

void main() {
    const ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    const vec4 v = imageLoad(IoBuffer, id);
    const float sign = 1.0 - 2.0 * float((id.x + id.y) & 1);
    imageStore(IoBuffer, id, v * sign);
}
