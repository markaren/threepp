#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : enable

// Half-resolution ray-traced ambient occlusion + bent normals for the Vulkan
// DEFERRED renderer.
//
// One thread per HALF-res pixel reconstructs the surface from the resolved
// G-buffer, shoots a few short cosine-hemisphere occlusion rays through the
// existing TLAS (any-hit within a finite radius — terminate on first hit), and
// writes:
//   rtao    (rgba16f) = (bentN*0.5+0.5, ao)
//   rtaoAux (rgba16f) = (histLen, E[ao^2], aoNear, skyVis)   // skyVis: far-field
// at half res. The full-res deferred_shade then depth-aware bilateral-upsamples
// the result and feeds it into (a) the env/ambient diffuse term (× ao) and (b)
// the specular occlusion + the bent-normal probe/env diffuse indirect.
//
// TEMPORAL: the AO is reprojected with the full-res motion vector and EMA-
// blended against the previous frame's half-res result (per-FIF ping-pong,
// exactly like the GI accumulator in deferred_shade). AO at a world point is
// view-independent, so camera motion does not shorten the history — only
// per-frame DEFORMERS (ifIrradianceReactivity) pin a short cap. Disocclusion
// (prev-normal / prev-depth mismatch) cold-starts the history.
//
// Shares the DeferredShade descriptor set (bindings 0/3/4/5/8/18/19/24/35) +
// push block; new RTAO bindings at 72/73/75/76 (the shade reads 74 = cur rtao).

#include "vulkan_shared.h"       // kInstFlag* bits
#include "instance_flags.glsl"   // ifIrradianceReactivity

layout(local_size_x = 8, local_size_y = 8) in;

const float PI = 3.14159265358979;

layout(set = 0, binding = 0) uniform CameraUbo {
    mat4 viewInverse;
    mat4 projInverse;
    vec4 jitter;
} cam;

layout(set = 0, binding = 3) uniform sampler2D  gbufNormalTex;    // .xyz = n*0.5+0.5, .w = roughness (<0 unlit)
layout(set = 0, binding = 4) uniform sampler2D  gbufDepthTex;     // .x = Vulkan NDC z (reversed-Z)
layout(set = 0, binding = 5) uniform usampler2D gbufIdsTex;       // .x = instanceId+1 (0 = sky), .z = flags
layout(set = 0, binding = 8) uniform accelerationStructureEXT topAS;
layout(set = 0, binding = 18) uniform sampler2D gbufMotionTex;    // .rg = NDC motion, .b = prev NDC depth
layout(set = 0, binding = 19) uniform sampler2D gbufNormalPrevTex;// prev world normals (disocclusion)
layout(set = 0, binding = 24) uniform sampler2D gbufDepthPrevTex; // prev depth (disocclusion)
layout(set = 0, binding = 35) uniform sampler2D blueNoiseTex;     // 64x64 R8 void-and-cluster

// RTAO outputs (half-res) + temporal history (other FIF).
layout(set = 0, binding = 72, rgba16f) uniform writeonly image2D rtaoImage;    // (bentN*0.5+0.5, ao)
layout(set = 0, binding = 73) uniform sampler2D rtaoPrevTex;                     // prev-frame rtao (reproject)
layout(set = 0, binding = 75, rgba16f) uniform writeonly image2D rtaoAuxImage;  // (histLen, E[ao^2], aoNear, skyVis)
layout(set = 0, binding = 76) uniform sampler2D rtaoAuxPrevTex;                  // prev-frame aux

layout(push_constant) uniform Pc { ShadePush pc; };

// AO gather radius (world units). Only occluders within this distance darken the
// pixel — matches the deterministic gatherEnv AO_RADIUS so the look is familiar.
const float AO_RADIUS = 2.0;
const int   AO_RAYS   = 4;
// Far-field sky-visibility ray length (world units). Finite-radius AO cannot
// tell "no occluder within AO_RADIUS" from "open sky": a flat wall deep in a
// corridor has nothing within 2 m in front of it, so ao≈1 and the shade would
// inject sky irradiance indoors. ONE ray per frame reaches this far to report
// true enclosure (hit anywhere = occluded); its verdict is temporally
// accumulated into skyVis exactly like ao.
const float SKY_TMAX  = 1.0e4;

float radicalInverse2(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

void main() {
    const uint  hw = (pc.width  + 1u) / 2u;
    const uint  hh = (pc.height + 1u) / 2u;
    const ivec2 hp = ivec2(gl_GlobalInvocationID.xy);
    if (uint(hp.x) >= hw || uint(hp.y) >= hh) return;

    // ANCHOR each half-res sample to ONE exact full-res texel (the quad's
    // top-left) and reconstruct with THAT texel's own NDC. Sampling the
    // G-buffer at the half-res pixel CENTRE pairs a neighbouring texel's depth
    // with a half-pixel-off NDC — on grazing surfaces (a floor viewed down a
    // corridor, a valley floor, a steep rock face) the depth gradient turns
    // that half-pixel into a position error that puts the ray origin BELOW the
    // surface, every AO ray self-hits, and ao collapses to 0 (solid black on
    // grazing floors; row/column stripes where the picked texel alternates —
    // the terrain "grid lines"). Same failure mode as the shade's documented
    // jitter-aware reconstruction note. cam.jitter.xy restores the raster
    // jitter (same convention as the shade).
    const ivec2 pf = min(hp * 2, ivec2(int(pc.width) - 1, int(pc.height) - 1));
    const vec2 uv  = (vec2(pf) + 0.5) / vec2(float(pc.width), float(pc.height));
    const vec2 ndc = vec2(uv.x * 2.0 - 1.0, -(uv.y * 2.0 - 1.0)) + cam.jitter.xy;

    const uint id = texelFetch(gbufIdsTex, pf, 0).x;
    const vec4 nTap = texelFetch(gbufNormalTex, pf, 0);
    // Sky (id 0) or unlit (roughness sentinel < 0): no surface — publish the
    // "fully open, no valid history" identity (the shade skips these pixels).
    if (id == 0u || nTap.w < 0.0) {
        imageStore(rtaoImage,    hp, vec4(0.5, 0.5, 1.0, 1.0));// bentN=(0,0,1), ao=1
        imageStore(rtaoAuxImage, hp, vec4(0.0, 0.0, 0.0, 0.0));// histLen 0 = invalid
        return;
    }

    const vec3  N     = normalize(nTap.xyz * 2.0 - 1.0);
    const float depth = texelFetch(gbufDepthTex, pf, 0).x;
    const vec4  viewH = cam.projInverse * vec4(ndc, depth, 1.0);
    const vec3  worldPos = (cam.viewInverse * vec4(viewH.xyz / viewH.w, 1.0)).xyz;

    // Per-pixel self-intersection offset (matches the shade's SHADOW_EPS: a
    // float32 ULP grows with |coord|, so a fixed 1 mm offset self-hits at large
    // world scale — the known large-scene acne bug).
    const float eps = max(1e-3, max(max(abs(worldPos.x), abs(worldPos.y)), abs(worldPos.z)) * 1e-5);
    const vec3  orig = worldPos + N * eps;

    // Hemisphere basis.
    const vec3 up = abs(N.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    const vec3 T  = normalize(cross(up, N));
    const vec3 B  = cross(N, T);

    // Blue-noise dithered cosine hemisphere (Cranley-Patterson rotation per
    // frame): a stratified base rotated by a per-pixel blue-noise offset, so the
    // few-ray residual is high-frequency (temporal + the shade's bilateral
    // upsample remove it cleanly) instead of low-frequency clumps.
    const vec2 bnOff = vec2(
        fract(texelFetch(blueNoiseTex, hp & 63, 0).r + float(pc.frame) * 0.7548776662),
        fract(texelFetch(blueNoiseTex, (hp + ivec2(37, 17)) & 63, 0).r + float(pc.frame) * 0.5698402910));

    // The long sky ray rotates through the cosine directions per frame, so over
    // the temporal window every hemisphere direction contributes a sky sample.
    const int longIdx = int(pc.frame % uint(AO_RAYS));

    float aoMiss    = 0.0;// cosine-weighted miss count (cosine pdf cancels → this IS the AO integral)
    float occNear   = 0.0;// DISTANCE-WEIGHTED occlusion: 1 at contact → 0 at AO_RADIUS
    vec3  bentDir   = vec3(0.0);
    float curSkyVis = 1.0;// this frame's single far-field sky sample (1 = open sky)
    for (int s = 0; s < AO_RAYS; ++s) {
        const float u1  = fract((float(s) + 0.5) / float(AO_RAYS) + bnOff.x);
        const float u2  = fract(radicalInverse2(uint(s)) + bnOff.y);
        const float r   = sqrt(u1);
        const float phi = 2.0 * PI * u2;
        const vec3  hemi = vec3(r * cos(phi), r * sin(phi), sqrt(max(0.0, 1.0 - u1)));
        const vec3  dir  = normalize(T * hemi.x + B * hemi.y + N * hemi.z);

        // One ray per frame reaches SKY_TMAX (far-field enclosure); the rest are
        // short near-field AO rays.
        const bool  isLong = (s == longIdx);
        const float tmax   = isLong ? SKY_TMAX : AO_RADIUS;

        rayQueryEXT rq;
        // The long sky ray is a visibility ray: hit / no-hit, so it may
        // terminate on the first opaque hit. The near-field rays are NOT: their
        // hit DISTANCE feeds the occlusion falloff below, and "the first hit the
        // traversal happens to find" is not a well-defined distance where
        // surfaces overlap along the ray (terrain tile skirts under a cliff
        // shell). It depends on the acceleration structure's layout, which a
        // per-frame GPU build does not reproduce across runs: the sensor
        // determinism audit measured a 1-LSB scatter on distant terrain from
        // exactly this, with every closest-hit consumer in the frame exact.
        // The nearest occluder is also the physically right one for the
        // falloff. kRayMaskOpaque (0x01) skips blend/transmissive instances so a
        // glass pane / decal doesn't paint an occlusion rectangle behind it.
        const uint rayFlags = isLong ? (gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT)
                                     : gl_RayFlagsOpaqueEXT;
        rayQueryInitializeEXT(rq, topAS, rayFlags, 0x01u, orig, 1e-3, dir, tmax);
        while (rayQueryProceedEXT(rq)) {}
        const bool committed =
            rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
        const float t = committed ? rayQueryGetIntersectionTEXT(rq, true) : tmax;

        // NEAR-FIELD occlusion falls off linearly with hit distance: a contact
        // hit occludes fully; an occluder near AO_RADIUS barely. Applied to the
        // PROBE indirect — the probe field's own Chebyshev depth already accounts
        // for far-field visibility, so full-hemisphere binary AO on top
        // double-counts occlusion (the Sponza black-floor bug). A long-ray hit
        // BEYOND AO_RADIUS is "open" for the near field (it still darkens skyVis).
        if (committed && t <= AO_RADIUS) {
            occNear += 1.0 - clamp(t / AO_RADIUS, 0.0, 1.0);
        } else {
            aoMiss  += 1.0;
            bentDir += dir;// unoccluded (near-field) direction → contributes to the bent normal
        }
        // FAR-FIELD: the long ray's hit-anywhere verdict is this frame's sky
        // sample (temporally accumulated below). "No hit within 2 m" is NOT sky
        // — only a true miss out to SKY_TMAX is open sky.
        if (isLong) curSkyVis = committed ? 0.0 : 1.0;
    }
    float curAo     = aoMiss / float(AO_RAYS);
    float curAoNear = 1.0 - occNear / float(AO_RAYS);
    // Bent normal = the (cosine-weighted) mean unoccluded direction. Falls back
    // to the geometric normal when fully occluded / degenerate.
    vec3 curBentN = (dot(bentDir, bentDir) > 1e-8) ? normalize(bentDir) : N;

    // ── Temporal reprojection + EMA ─────────────────────────────────────────
    // Reproject with the full-res motion vector (same convention as the shade's
    // GI reproject), validate against prev normal + prev depth, EMA-blend.
    const vec2 mv     = textureLod(gbufMotionTex, uv, 0.0).rg;
    const vec2 prevNDC = ndc - cam.jitter.xy + mv;// unjittered curr NDC + motion
    const vec2 pUv     = vec2(prevNDC.x * 0.5 + 0.5, 0.5 - prevNDC.y * 0.5);

    float outAo     = curAo;
    float outAoNear = curAoNear;
    float outSkyVis = curSkyVis;
    vec3  outBentN  = curBentN;
    float histLen   = 1.0;
    float outSq     = curAo * curAo;
    if (all(greaterThanEqual(pUv, vec2(0.0))) && all(lessThanEqual(pUv, vec2(1.0)))) {
        const vec3  pn = textureLod(gbufNormalPrevTex, pUv, 0.0).xyz * 2.0 - 1.0;
        const float surfD = textureLod(gbufMotionTex, uv, 0.0).b;    // this surface's prev NDC depth
        const float bufD  = textureLod(gbufDepthPrevTex, pUv, 0.0).x;// prev depth buffer at the reproject
        const vec4  svh = cam.projInverse * vec4(prevNDC, surfD, 1.0);
        const vec4  bvh = cam.projInverse * vec4(prevNDC, bufD, 1.0);
        const float svz = svh.z / svh.w;
        const bool  sameSurface = dot(N, normalize(pn)) > 0.7 &&
                                  abs(svz - bvh.z / bvh.w) <= 0.1 * max(abs(svz), 1e-3);
        if (sameSurface) {
            const vec4  prevR = textureLod(rtaoPrevTex, pUv, 0.0);
            const vec4  prevA = textureLod(rtaoAuxPrevTex, pUv, 0.0);// (histLen, E[ao^2])
            const bool  valid = prevA.x > 0.5 && prevA.x < 4096.0 &&
                                prevR.a >= -0.01 && prevR.a <= 1.01;
            if (valid) {
                // AO is view-independent → no motion-scaled cap. Deformers make
                // the integrand non-stationary, so pin a short cap on them.
                const uint  flagsZ = textureLod(gbufIdsTex, uv, 0.0).z;
                const float cap = mix(32.0, 4.0, ifIrradianceReactivity(flagsZ));
                histLen = min(prevA.x + 1.0, cap);
                const float k = 1.0 / histLen;
                outAo     = mix(prevR.a, curAo, k);
                outAoNear = mix(clamp(prevA.z, 0.0, 1.0), curAoNear, k);
                // Far-field sky visibility: only ONE binary sample per frame, so
                // it leans harder on the EMA than ao (4 samples/frame) — the cap
                // 32 window converges it smooth. AO-style view-independence holds.
                outSkyVis = mix(clamp(prevA.w, 0.0, 1.0), curSkyVis, k);
                outBentN  = normalize(mix(prevR.xyz * 2.0 - 1.0, curBentN, k));
                outSq     = mix(prevA.y, curAo * curAo, k);
            }
        }
    }

    imageStore(rtaoImage,    hp, vec4(outBentN * 0.5 + 0.5, outAo));
    imageStore(rtaoAuxImage, hp, vec4(histLen, outSq, outAoNear, outSkyVis));
}
