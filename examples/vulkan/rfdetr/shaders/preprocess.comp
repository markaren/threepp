#version 450
// ImageNet preprocess: square bilinear resize of an RGBA8 image to R x R (pixel
// centres at +0.5, edges clamped), /255, then per-channel (v - mean) / std,
// written as CHW floats. Same arithmetic and order as the former host loop;
// `precise` keeps the compiler from fusing the multiply-adds into FMAs.
// Bindings: 0 rgba [W*H] (one RGBA8 texel per uint, R in the low byte), 1 out [3,R,R].
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant, std430) uniform PC {
    uint W, H, R, _p0;
} p;

layout(std430, binding = 0) readonly  buffer Rgba { uint  rgba[]; };
layout(std430, binding = 1) writeonly buffer Out  { float chw[]; };

const vec3 kMean   = vec3(0.485, 0.456, 0.406);
const vec3 kInvStd = vec3(1.0 / 0.229, 1.0 / 0.224, 1.0 / 0.225);

vec3 texel(int x, int y) {
    uint v = rgba[uint(y) * p.W + uint(x)];
    return vec3(float(v & 0xFFu), float((v >> 8u) & 0xFFu), float((v >> 16u) & 0xFFu));
}

void main() {
    uint x = gl_GlobalInvocationID.x, y = gl_GlobalInvocationID.y;
    if (x >= p.R || y >= p.R) return;
    int W = int(p.W), H = int(p.H);

    precise float fy = (float(y) + 0.5) * float(p.H) / float(p.R) - 0.5;
    int y0 = clamp(int(floor(fy)), 0, H - 1);
    int y1 = min(H - 1, y0 + 1);
    precise float wy = clamp(fy - float(y0), 0.0, 1.0);

    precise float fx = (float(x) + 0.5) * float(p.W) / float(p.R) - 0.5;
    int x0 = clamp(int(floor(fx)), 0, W - 1);
    int x1 = min(W - 1, x0 + 1);
    precise float wx = clamp(fx - float(x0), 0.0, 1.0);

    vec3 a = texel(x0, y0), b = texel(x1, y0), c = texel(x0, y1), d = texel(x1, y1);
    precise vec3 top = a * (1.0 - wx) + b * wx;
    precise vec3 bot = c * (1.0 - wx) + d * wx;
    precise vec3 v = (top * (1.0 - wy) + bot * wy) / 255.0;
    precise vec3 n = (v - kMean) * kInvStd;

    uint plane = p.R * p.R, idx = y * p.R + x;
    chw[idx] = n.r;
    chw[plane + idx] = n.g;
    chw[2u * plane + idx] = n.b;
}
