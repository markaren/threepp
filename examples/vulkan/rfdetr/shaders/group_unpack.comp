#version 450
// Inverse of group_pack.comp, with the residuals of the group self-attention:
// the first row of each group of 1+K is the instance's answer, scaled by the
// layer's instance_kp_layer_scale and added to the instance state; the other K
// rows add to that instance's keypoint states.
//   instOut[n]     = inst[n] + gamma * feat[n*(1+K)]
//   kpOut[n*K + k] = kp[n*K + k] + feat[n*(1+K) + 1 + k]
// Bindings: 0 feat [N*(1+K),W], 1 inst [N,W], 2 kp [N*K,W], 3 gamma [W],
// 4 instOut [N,W], 5 kpOut [N*K,W].
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, std430) uniform PC {
    uint N, K, W, _p0;
} p;

layout(std430, binding = 0) readonly  buffer Feat    { float feat[]; };
layout(std430, binding = 1) readonly  buffer Inst    { float inst[]; };
layout(std430, binding = 2) readonly  buffer Kp      { float kp[]; };
layout(std430, binding = 3) readonly  buffer Gamma   { float gamma[]; };
layout(std430, binding = 4) writeonly buffer InstOut { float instOut[]; };
layout(std430, binding = 5) writeonly buffer KpOut   { float kpOut[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint G = 1u + p.K;
    if (idx >= p.N * G * p.W) return;
    uint c = idx % p.W;
    uint row = idx / p.W;
    uint n = row / G, t = row % G;
    if (t == 0u) {
        uint o = n * p.W + c;
        instOut[o] = inst[o] + gamma[c] * feat[idx];
    } else {
        uint o = (n * p.K + t - 1u) * p.W + c;
        kpOut[o] = kp[o] + feat[idx];
    }
}
