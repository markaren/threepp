@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if (NOT DEFINED EMSCRIPTEN AND @THREEPP_USE_EXTERNAL_GLFW@)
    find_dependency(glfw3 CONFIG)
endif()

# A Vulkan-enabled build links Vulkan::Vulkan PUBLIC and hands consumers
# THREEPP_WITH_VULKAN, so the imported target has to exist on this side too —
# public headers (ImguiContext.hpp, RendererSettings.hpp, the play sessions)
# compile the Vulkan branches here.
if (@THREEPP_WITH_VULKAN@)
    find_dependency(Vulkan)
endif()

# A USD build links LightUSD's static libraries; on Unix its texture tools
# link Threads::Threads.
if (@THREEPP_WITH_USD@ AND UNIX)
    find_dependency(Threads)
endif()

include(${CMAKE_CURRENT_LIST_DIR}/threepp-targets.cmake)
check_required_components(threepp)
