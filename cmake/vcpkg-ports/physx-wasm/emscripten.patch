diff --git a/physx/source/compiler/cmake/linux/CMakeLists.txt b/physx/source/compiler/cmake/linux/CMakeLists.txt
index ba40765..49dee74 100644
--- a/physx/source/compiler/cmake/linux/CMakeLists.txt
+++ b/physx/source/compiler/cmake/linux/CMakeLists.txt
@@ -119,7 +119,14 @@ ENDIF()
 
 SET(COMMON_CXX_FLAGS "-std=c++11 -fno-rtti -fno-exceptions -ffunction-sections -fdata-sections -fvisibility=hidden ${AARCH64_FLAGS}")
 
-IF ("${CMAKE_CXX_COMPILER_ID}" STREQUAL "Clang")
+IF (EMSCRIPTEN)
+	# Emscripten reuses the linux platform files. Its clang is newer than the
+	# warning list above was written for, so -Weverything -Werror stops the
+	# build, and wasm has no floating-point exception support for maytrap.
+	# The broadphase uses SSE intrinsics without a scalar fallback, so SSE2 is
+	# compiled to wasm SIMD (PX_SSE2 then follows from __SSE2__).
+	SET(PHYSX_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${COMMON_CXX_FLAGS} -fstrict-aliasing -msimd128 -msse2 -w" CACHE INTERNAL "PhysX CXX")
+ELSEIF ("${CMAKE_CXX_COMPILER_ID}" STREQUAL "Clang")
 	IF ("${CMAKE_CXX_COMPILER_VERSION}" VERSION_LESS "10.0.0")
 		SET(PHYSX_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${COMMON_CXX_FLAGS} -fstrict-aliasing ${CLANG_WARNINGS}" CACHE INTERNAL "PhysX CXX")
 	ELSE()
